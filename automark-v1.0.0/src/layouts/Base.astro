---
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import MagicFillInteractive from "@/layouts/components/MagicFillInteractive.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";

const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
}

const { title, meta_title, description, image, noindex, canonical } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
      )
    }
    <link rel="shortcut icon" href={config.site.favicon} />
    <meta name="theme-name" content="magic-fill-neumorphism" />
    <meta name="theme-color" content="#E0E5EC" />
    <meta name="msapplication-TileColor" content="#E0E5EC" />
    
    <!-- Google Fonts for Neumorphism: Plus Jakarta Sans (Display) & DM Sans (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Google Identity Services -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>

    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('magic_fill_theme') || 'dark';
          document.documentElement.setAttribute('data-theme', saved);
          if (saved === 'light') {
            document.documentElement.classList.add('light-theme');
          } else {
            document.documentElement.classList.remove('light-theme');
          }
        } catch(e) {}
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    {canonical && <link rel="canonical" href={canonical} item-prop="url" />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- View Transitions removed to avoid conflicts with GSAP/Lenis/Swiper -->

    <meta name="author" content={config.metadata.meta_author} />
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={`${config.site.base_url}/${Astro.url.pathname.replace("/", "")}`}
    />
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta
      property="og:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />
    <meta
      name="twitter:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- GSAP CDN -->
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/gsap.min.js"></script>
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/ScrollTrigger.min.js"
    ></script>

    <!-- LENIS CDN -->
    <script
      is:inline
      defer
      src="https://unpkg.com/lenis@1.3.17/dist/lenis.min.js"></script>

    <!-- Main UI interactions -->
    <script is:inline defer src="/scripts/main.js"></script>

    <!-- Animations (Modules are deferred automatically by browsers) -->
    <script is:inline type="module" src="/scripts/animations.js"></script>

    <!-- Google Identity Services (GIS) Client Library -->
    <script is:inline src="https://accounts.google.com/gsi/client" async defer></script>
  </head>
  <body>
    {/* google tag manager noscript */}
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }

    {/* Global Ambient Subtle Particle Canvas for Light & Dark Themes */}
    <canvas
      id="globalAmbientParticles"
      class="fixed inset-0 pointer-events-none z-0 w-full h-full opacity-70"
      aria-hidden="true"
    ></canvas>

    <Header />
    <main id="main-content" class="relative z-10 overflow-x-hidden md:overflow-x-auto">
      <slot />
    </main>
    <Footer />
    <MagicFillInteractive />
  </body>
</html>

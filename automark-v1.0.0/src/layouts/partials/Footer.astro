---
import Logo from "@/components/Logo.astro";
import Social from "@/components/Social.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import { markdownify } from "@/lib/utils/textConverter";
import type { Menu, SocialType } from "@/types";

const {
  footer_primary,
  footer_resource,
  footer_legal,
  footer_col_1_title,
  footer_col_2_title,
  footer_col_3_title,
} = menu as Menu;
const { main: socialLinks } = social as SocialType;
---

<footer class="border-t border-slate-200 bg-slate-50 pt-16 pb-12 relative overflow-hidden">
  <div class="container pb-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      <!-- Column 1 - Logo & Contact -->
      <div class="lg:col-span-2 text-sm text-slate-600 font-body">
        <Logo />
        <p class="mt-4 text-xs sm:text-sm leading-relaxed max-w-sm text-slate-600">
          {config.params.footer_tagline}
        </p>
        <div class="mt-5 space-y-1.5 text-xs font-mono">
          <a
            class="block text-[#FFFFFF] hover:text-blue-600 transition-colors"
            href={`mailto:${config.params.footer_email}`}
          >
            {config.params.footer_email}
          </a>
          <a
            class="block text-slate-600 hover:text-slate-900 transition-colors"
            href={`tel:${config.params.footer_phone}`}
          >
            {config.params.footer_phone}
          </a>
        </div>
      </div>

      <!-- Column 2 - Primary -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-[#FFFFFF] font-display mb-4">
          {footer_col_1_title}
        </h3>
        <ul class="space-y-2.5 font-body text-xs">
          {
            footer_primary?.map((item) => (
              <li>
                <a href={item.url} class="text-slate-600 hover:text-blue-600 transition-colors">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 3 - Resource -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-[#FFFFFF] font-display mb-4">
          {footer_col_2_title}
        </h3>
        <ul class="space-y-2.5 font-body text-xs">
          {
            footer_resource?.map((item) => (
              <li>
                <a href={item.url} class="text-slate-600 hover:text-blue-600 transition-colors">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 4 - Legal -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-[#FFFFFF] font-display mb-4">
          {footer_col_3_title}
        </h3>
        <ul class="space-y-2.5 font-body text-xs">
          {
            footer_legal?.map((item) => (
              <li>
                <a href={item.url} class="text-slate-600 hover:text-blue-600 transition-colors">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <!-- Divider Strip -->
  <div class="container">
    <div class="border-t border-slate-200 my-4"></div>
  </div>

  <!-- Bottom Area -->
  <div class="container py-2">
    <div class="flex justify-between items-center flex-col sm:flex-row gap-y-3 w-full">
      <p
        class="text-xs font-body text-slate-400"
        set:html={markdownify(config.params.copyright)}
      />

      <Social className="social-icons flex items-center gap-2" source={socialLinks} />
    </div>
  </div>
</footer>

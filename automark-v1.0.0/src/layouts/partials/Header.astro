---
import Logo from "@/components/Logo.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}

const { main }: { main: NavigationLink[] } = menu;
const { settings } = config;
const { pathname } = Astro.url;
---

<header
  id="mainHeader"
  class={`header z-50 w-full transition-all duration-200 ${settings.sticky_header ? "fixed top-0" : ""} bg-[#0B0D0C]/90 backdrop-blur-md border-b border-[#2B312C]`}
>
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-30 flex items-center justify-between h-[68px]">
    <!-- Brand Logo -->
    <div class="flex items-center shrink-0">
      <Logo />
    </div>

    <!-- 1. PUBLIC MARKETING MENU (Visible When Logged Out) -->
    <ul
      id="publicNavMenu"
      class="navbar-nav hidden lg:flex items-center gap-1 p-1 rounded-xl bg-[#141715] border border-[#2B312C]"
    >
      {
        main.map((item) => {
          const isActive = pathname === `${item.url}/` || pathname === item.url;
          return (
            <li class="nav-item">
              <a
                href={item.url}
                class={`text-[13.5px] font-medium px-3.5 py-1.5 rounded-lg transition-all duration-150 cursor-pointer block ${
                  isActive
                    ? "bg-[#191D1A] text-[#B7F34A] font-semibold border border-[#2B312C]"
                    : "text-[#A1AAA1] hover:text-[#FFFFFF] hover:bg-[#191D1A]/50"
                }`}
              >
                {item.name}
              </a>
            </li>
          );
        })
      }
    </ul>

    <!-- 2. AUTHENTICATED PLATFORM MENU (Visible When Logged In) -->
    <ul
      id="authNavMenu"
      class="navbar-nav hidden items-center gap-1 p-1 rounded-xl bg-[#141715] border border-[#2B312C]"
    >
      <li class="nav-item">
        <a
          href="/dashboard"
          class={`text-[13px] font-medium px-3 py-1.5 rounded-lg transition-all duration-150 flex items-center gap-2 cursor-pointer ${
            pathname === "/dashboard" || pathname === "/dashboard/"
              ? "bg-[#191D1A] text-[#B7F34A] font-semibold border border-[#2B312C]"
              : "text-[#A1AAA1] hover:text-[#FFFFFF] hover:bg-[#191D1A]/50"
          }`}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          <span>Dashboard</span>
        </a>
      </li>

      <li class="nav-item">
        <a
          href="/memory"
          class={`text-[13px] font-medium px-3 py-1.5 rounded-lg transition-all duration-150 flex items-center gap-2 cursor-pointer ${
            pathname === "/memory" || pathname === "/memory/"
              ? "bg-[#191D1A] text-[#B7F34A] font-semibold border border-[#2B312C]"
              : "text-[#A1AAA1] hover:text-[#FFFFFF] hover:bg-[#191D1A]/50"
          }`}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
          <span>Memory Vault</span>
        </a>
      </li>

      <li class="nav-item">
        <a
          href="/extract"
          class={`text-[13px] font-medium px-3 py-1.5 rounded-lg transition-all duration-150 flex items-center gap-2 cursor-pointer ${
            pathname === "/extract" || pathname === "/extract/"
              ? "bg-[#191D1A] text-[#B7F34A] font-semibold border border-[#2B312C]"
              : "text-[#A1AAA1] hover:text-[#FFFFFF] hover:bg-[#191D1A]/50"
          }`}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
          <span>AI Extraction</span>
        </a>
      </li>

      <li class="nav-item">
        <a
          href="/playground"
          class={`text-[13px] font-medium px-3 py-1.5 rounded-lg transition-all duration-150 flex items-center gap-2 cursor-pointer ${
            pathname === "/playground" || pathname === "/playground/"
              ? "bg-[#191D1A] text-[#B7F34A] font-semibold border border-[#2B312C]"
              : "text-[#A1AAA1] hover:text-[#FFFFFF] hover:bg-[#191D1A]/50"
          }`}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          <span>Simulator</span>
        </a>
      </li>

      <li class="nav-item">
        <a
          href="/extension"
          class={`text-[13px] font-medium px-3 py-1.5 rounded-lg transition-all duration-150 flex items-center gap-2 cursor-pointer ${
            pathname === "/extension" || pathname === "/extension/"
              ? "bg-[#191D1A] text-[#B7F34A] font-semibold border border-[#2B312C]"
              : "text-[#A1AAA1] hover:text-[#FFFFFF] hover:bg-[#191D1A]/50"
          }`}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
          <span>Extension</span>
        </a>
      </li>
    </ul>

    <!-- 3. RIGHT CONTROLS: Extension Quick Link & Auth Controls -->
    <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
      <!-- Chrome Extension Quick Link -->
      <a
        href="/extension"
        class="hidden sm:inline-flex items-center gap-2 h-9 px-3.5 rounded-lg text-xs font-semibold text-[#FFFFFF] bg-[#141715] hover:bg-[#191D1A] border border-[#2B312C] hover:border-[#3A423C] transition-all duration-150"
        title="Pair Chrome Extension"
      >
        <span class="size-2 rounded-full bg-[#B7F34A]"></span>
        <span>Extension</span>
      </a>

      <!-- Logged Out Actions -->
      <div id="headerLoggedOutArea" class="flex items-center gap-2 sm:gap-2.5">
        <a
          href="/login"
          id="btnHeaderSignIn"
          class="h-9 px-3.5 text-xs font-semibold rounded-lg text-[#FFFFFF] hover:bg-[#141715] border border-[#2B312C] hover:border-[#3A423C] transition-all duration-150 flex items-center justify-center cursor-pointer"
        >
          Sign In
        </a>
        <a
          href="/register"
          id="btnHeaderGetStarted"
          class="h-9 px-4 text-xs font-bold rounded-lg bg-[#B7F34A] hover:bg-[#C8FA6A] text-[#0B0D0C] transition-all duration-150 flex items-center gap-1.5 cursor-pointer shadow-sm"
        >
          <span>Get Started</span>
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Logged In Actions -->
      <div id="headerLoggedInArea" class="hidden items-center gap-2">
        <!-- Theme Toggle Button (Only on Protected After-Login Platform) -->
        <button
          type="button"
          id="webThemeToggleBtn"
          class="size-9 rounded-lg flex items-center justify-center text-[#A1AAA1] hover:text-[#FFFFFF] bg-[#141715] hover:bg-[#191D1A] border border-[#2B312C] hover:border-[#3A423C] transition-all duration-150 cursor-pointer"
          title="Toggle Light / Dark Mode"
          aria-label="Toggle Theme"
        >
          <svg id="webIconSun" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg id="webIconMoon" class="size-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        <a
          href="/dashboard"
          class="h-9 px-3.5 rounded-lg flex items-center gap-2 text-xs font-semibold bg-[#141715] hover:bg-[#191D1A] text-[#FFFFFF] border border-[#2B312C] hover:border-[#3A423C] transition-all duration-150"
          title="Go to Dashboard"
        >
          <span class="size-2 rounded-full bg-[#B7F34A] animate-pulse"></span>
          <span id="headerUserDisplayName" class="truncate max-w-28 font-semibold">Account</span>
        </a>

        <button
          type="button"
          id="btnHeaderSignOut"
          class="h-9 px-3 rounded-lg text-xs font-medium text-[#A1AAA1] hover:text-rose-400 hover:bg-rose-950/20 border border-transparent hover:border-rose-900/40 transition-colors cursor-pointer"
          title="Sign Out"
        >
          Sign Out
        </button>
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="mobileNavToggleBtn"
        class="lg:hidden size-9 rounded-lg flex items-center justify-center text-[#A1AAA1] hover:text-[#FFFFFF] bg-[#141715] border border-[#2B312C]"
        aria-label="Toggle navigation"
      >
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- 4. MOBILE SLIDEOUT DRAWER -->
  <div id="mobileDrawerBackdrop" class="fixed inset-0 z-40 bg-black/70 backdrop-blur-xs hidden lg:hidden"></div>
  <div
    id="mobileDrawer"
    class="fixed inset-y-0 right-0 z-50 w-72 bg-[#0B0D0C] border-l border-[#2B312C] p-6 shadow-2xl transform translate-x-full transition-transform duration-200 lg:hidden flex flex-col justify-between"
  >
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-[#2B312C] mb-5">
        <Logo />
        <button type="button" id="mobileDrawerCloseBtn" class="size-8 rounded-lg flex items-center justify-center text-lg font-bold text-[#A1AAA1] hover:text-[#FFFFFF] bg-[#141715] border border-[#2B312C]">&times;</button>
      </div>

      <!-- Mobile Logged Out Links -->
      <div id="mobileLoggedOutLinks" class="flex flex-col gap-1">
        <a href="/features" class="px-3.5 py-2 text-xs font-semibold text-[#A1AAA1] hover:text-[#FFFFFF] hover:bg-[#141715] rounded-lg transition-colors">Features</a>
        <a href="/playground" class="px-3.5 py-2 text-xs font-semibold text-[#A1AAA1] hover:text-[#FFFFFF] hover:bg-[#141715] rounded-lg transition-colors">Live Simulator</a>
        <a href="/integrations" class="px-3.5 py-2 text-xs font-semibold text-[#A1AAA1] hover:text-[#FFFFFF] hover:bg-[#141715] rounded-lg transition-colors">Supported Portals</a>
        <a href="/pricing" class="px-3.5 py-2 text-xs font-semibold text-[#A1AAA1] hover:text-[#FFFFFF] hover:bg-[#141715] rounded-lg transition-colors">Pricing</a>
        <a href="/about" class="px-3.5 py-2 text-xs font-semibold text-[#A1AAA1] hover:text-[#FFFFFF] hover:bg-[#141715] rounded-lg transition-colors">How It Works</a>
        <a href="/extension" class="px-3.5 py-2 text-xs font-semibold text-[#B7F34A] hover:bg-[#141715] rounded-lg transition-colors">Browser Extension</a>
      </div>

      <!-- Mobile Logged In Links -->
      <div id="mobileLoggedInLinks" class="hidden flex-col gap-1">
        <a href="/dashboard" class="px-3.5 py-2 text-xs font-semibold text-[#FFFFFF] hover:bg-[#141715] rounded-lg transition-colors">Dashboard</a>
        <a href="/memory" class="px-3.5 py-2 text-xs font-semibold text-[#B7F34A] bg-[#141715] rounded-lg transition-colors">Memory Vault</a>
        <a href="/extract" class="px-3.5 py-2 text-xs font-semibold text-[#A1AAA1] hover:text-[#FFFFFF] hover:bg-[#141715] rounded-lg transition-colors">AI Extraction</a>
        <a href="/playground" class="px-3.5 py-2 text-xs font-semibold text-[#A1AAA1] hover:text-[#FFFFFF] hover:bg-[#141715] rounded-lg transition-colors">Live Simulator</a>
        <a href="/extension" class="px-3.5 py-2 text-xs font-semibold text-[#A1AAA1] hover:text-[#FFFFFF] hover:bg-[#141715] rounded-lg transition-colors">Extension Setup</a>
      </div>
    </div>

    <!-- Mobile Drawer Bottom Actions -->
    <div class="pt-4 border-t border-[#2B312C] space-y-2">
      <div id="mobileDrawerLoggedOutBtns" class="flex flex-col gap-2">
        <a href="/login" class="w-full text-center py-2 text-xs font-semibold text-[#FFFFFF] bg-[#141715] hover:bg-[#191D1A] border border-[#2B312C] rounded-lg transition-colors">Sign In</a>
        <a href="/register" class="w-full text-center py-2 text-xs font-bold text-[#0B0D0C] bg-[#B7F34A] hover:bg-[#C8FA6A] rounded-lg transition-colors">Get Started Free</a>
      </div>
      <div id="mobileDrawerLoggedInBtns" class="hidden flex-col gap-2">
        <button type="button" id="mobileDrawerSignOutBtn" class="w-full text-center py-2 text-xs font-semibold text-rose-400 bg-rose-950/20 border border-rose-900/30 rounded-lg transition-colors">Sign Out</button>
      </div>
    </div>
  </div>

  <!-- Synchronous Client Controller for Auth State -->
  <script is:inline>
    (function () {
      function syncHeader() {
        const token = localStorage.getItem("magic_fill_token");
        const rawUser = localStorage.getItem("magic_fill_user");
        let user = null;
        try { if (rawUser) user = JSON.parse(rawUser); } catch(e) {}

        const publicMenu = document.getElementById("publicNavMenu");
        const authMenu = document.getElementById("authNavMenu");
        const loggedOutArea = document.getElementById("headerLoggedOutArea");
        const loggedInArea = document.getElementById("headerLoggedInArea");
        const userDisplay = document.getElementById("headerUserDisplayName");

        const mobileLoggedOut = document.getElementById("mobileLoggedOutLinks");
        const mobileLoggedIn = document.getElementById("mobileLoggedInLinks");
        const mobileLoggedOutBtns = document.getElementById("mobileDrawerLoggedOutBtns");
        const mobileLoggedInBtns = document.getElementById("mobileDrawerLoggedInBtns");

        if (token) {
          if (publicMenu) {
            publicMenu.classList.remove("active-desktop-menu");
            publicMenu.classList.add("hidden");
          }
          if (authMenu) {
            authMenu.classList.add("active-desktop-menu");
            authMenu.classList.remove("hidden");
          }
          if (loggedOutArea) loggedOutArea.classList.add("hidden");
          if (loggedInArea) {
            loggedInArea.classList.remove("hidden");
            loggedInArea.classList.add("flex");
          }

          if (mobileLoggedOut) mobileLoggedOut.classList.add("hidden");
          if (mobileLoggedIn) {
            mobileLoggedIn.classList.remove("hidden");
            mobileLoggedIn.classList.add("flex");
          }
          if (mobileLoggedOutBtns) mobileLoggedOutBtns.classList.add("hidden");
          if (mobileLoggedInBtns) {
            mobileLoggedInBtns.classList.remove("hidden");
            mobileLoggedInBtns.classList.add("flex");
          }

          const name = (user && (user.full_name || user.email)) || "Vault Active";
          const shortName = name.split(" ")[0] || name;
          if (userDisplay) userDisplay.textContent = shortName;
        } else {
          if (publicMenu) {
            publicMenu.classList.add("active-desktop-menu");
            publicMenu.classList.remove("hidden");
          }
          if (authMenu) {
            authMenu.classList.remove("active-desktop-menu");
            authMenu.classList.add("hidden");
          }
          if (loggedOutArea) {
            loggedOutArea.classList.remove("hidden");
            loggedOutArea.classList.add("flex");
          }
          if (loggedInArea) loggedInArea.classList.add("hidden");

          if (mobileLoggedOut) {
            mobileLoggedOut.classList.remove("hidden");
            mobileLoggedOut.classList.add("flex");
          }
          if (mobileLoggedIn) mobileLoggedIn.classList.add("hidden");
          if (mobileLoggedOutBtns) {
            mobileLoggedOutBtns.classList.remove("hidden");
            mobileLoggedOutBtns.classList.add("flex");
          }
          if (mobileLoggedInBtns) mobileLoggedInBtns.classList.add("hidden");
        }
      }

      syncHeader();
      window.addEventListener("storage", syncHeader);
      window.addEventListener("magic-fill-auth-change", syncHeader);

      // Sign out handlers
      function handleSignOut() {
        localStorage.removeItem("magic_fill_token");
        localStorage.removeItem("magic_fill_user");
        window.dispatchEvent(new Event("magic-fill-auth-change"));
        window.location.href = "/login";
      }

      const signOutBtn = document.getElementById("btnHeaderSignOut");
      if (signOutBtn) signOutBtn.addEventListener("click", handleSignOut);

      const mobileSignOutBtn = document.getElementById("mobileDrawerSignOutBtn");
      if (mobileSignOutBtn) mobileSignOutBtn.addEventListener("click", handleSignOut);

      // Mobile Drawer open/close
      const mobileToggle = document.getElementById("mobileNavToggleBtn");
      const mobileClose = document.getElementById("mobileDrawerCloseBtn");
      const drawer = document.getElementById("mobileDrawer");
      const backdrop = document.getElementById("mobileDrawerBackdrop");

      function openDrawer() {
        if (drawer && backdrop) {
          drawer.classList.remove("translate-x-full");
          backdrop.classList.remove("hidden");
        }
      }

      function closeDrawer() {
        if (drawer && backdrop) {
          drawer.classList.add("translate-x-full");
          backdrop.classList.add("hidden");
        }
      }

      if (mobileToggle) mobileToggle.addEventListener("click", openDrawer);
      if (mobileClose) mobileClose.addEventListener("click", closeDrawer);
      if (backdrop) backdrop.addEventListener("click", closeDrawer);

      // Web App Theme Toggle (Active exclusively for authenticated platform workspace)
      const webThemeToggleBtn = document.getElementById("webThemeToggleBtn");
      const webIconSun = document.getElementById("webIconSun");
      const webIconMoon = document.getElementById("webIconMoon");

      function syncWebThemeIcon() {
        const p = window.location.pathname.replace(/\/$/, "");
        const appRoutes = ["/dashboard", "/memory", "/extract", "/playground"];
        const isApp = appRoutes.includes(p) || localStorage.getItem("magic_fill_token");
        if (!isApp) return;

        const currentTheme = document.documentElement.getAttribute("data-theme") || "dark";
        if (currentTheme === "light") {
          if (webIconSun) webIconSun.classList.add("hidden");
          if (webIconMoon) webIconMoon.classList.remove("hidden");
        } else {
          if (webIconSun) webIconSun.classList.remove("hidden");
          if (webIconMoon) webIconMoon.classList.add("hidden");
        }
      }

      function toggleWebTheme() {
        const current = document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
        const next = current === "light" ? "dark" : "light";
        localStorage.setItem("magic_fill_theme", next);
        document.documentElement.setAttribute("data-theme", next);
        if (next === "light") {
          document.documentElement.classList.add("light-theme");
          document.body.classList.add("light-theme");
        } else {
          document.documentElement.classList.remove("light-theme");
          document.body.classList.remove("light-theme");
        }
        syncWebThemeIcon();
      }

      if (webThemeToggleBtn) {
        webThemeToggleBtn.addEventListener("click", toggleWebTheme);
      }
      syncWebThemeIcon();
    })();
  </script>
</header>

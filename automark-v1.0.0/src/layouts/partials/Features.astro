---
import FeatureCard from "@/components/FeatureCard.astro";
import type { OurFeaturesSection } from "@/types";

interface Props {
  our_features: OurFeaturesSection;
}

const { our_features } = Astro.props;
---

<section class="section relative overflow-hidden py-24">
  <div class="container">
    <div class="section-container">
      <div class="section-intro centralize text-center mb-16">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-indigo-600 mb-2">
          Autonomous Form Intelligence
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-slate-900 dark:text-white hasHighlight mb-4" set:html={our_features.title} />
        <p class="font-body text-slate-600 dark:text-slate-400 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">{our_features.content}</p>
      </div>
      <div class="section-content">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            our_features.items.map((item) => (
              <FeatureCard
                logo={item.logo}
                title={item.title}
                content={item.content}
                is_starred={item.is_starred}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

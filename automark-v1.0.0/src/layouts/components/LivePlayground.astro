---
// Live Interactive Form Autofill Simulator for Magic Fill
---

<section id="live-simulator" class="section relative overflow-hidden py-24">
  <div class="container">
    <div class="section-container">
      <div class="section-intro centralize text-center mb-16">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-indigo-600 dark:text-indigo-400 mb-2 font-display">
          Interactive Form Simulator
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-slate-900 dark:text-white hasHighlight mb-4">
          Experience Instant <strong>1-Click Form Autofill</strong>
        </h2>
        <p class="font-body text-slate-600 dark:text-slate-400 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
          Test Magic Fill on a simulated engineering job application. See how personal identity, credentials, and custom career experiences map with exact accuracy.
        </p>
      </div>

      <div class="section-content max-w-4xl mx-auto">
        <!-- Simulator Card Container -->
        <div class="bg-white dark:bg-[#0f1422] border border-slate-200/80 dark:border-white/10 rounded-2xl shadow-sm relative overflow-hidden">
          
          <!-- Top simulated browser navigation bar -->
          <div class="flex items-center justify-between px-5 py-3.5 border-b border-slate-100 dark:border-white/5 bg-slate-50/80 dark:bg-white/[0.02] flex-wrap gap-3">
            <div class="flex items-center gap-3">
              <!-- Window dots -->
              <div class="flex gap-1.5 items-center">
                <span class="w-2.5 h-2.5 rounded-full bg-slate-300 dark:bg-white/20"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-slate-300 dark:bg-white/20"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-slate-300 dark:bg-white/20"></span>
              </div>
              
              <!-- Address Well -->
              <div class="bg-white dark:bg-[#0b0f19] border border-slate-200/80 dark:border-white/10 rounded-md px-3 py-1 text-xs text-slate-600 dark:text-slate-300 font-mono flex items-center gap-2 shadow-2xs">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-emerald-500">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span class="text-slate-500 dark:text-slate-400">careers.acme-cloud.io/apply/platform-architect</span>
              </div>
            </div>

            <!-- Simulator Actions -->
            <div class="flex items-center gap-2.5">
              <button
                type="button"
                id="btnSimulateAutofill"
                class="rounded-lg px-3.5 py-1.5 text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow-sm hover:shadow transition-all cursor-pointer flex items-center gap-1.5 group"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="group-hover:rotate-12 transition-transform">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
                <span>Run Autofill</span>
              </button>
              
              <button
                type="button"
                id="btnClearSimForm"
                class="rounded-lg px-3 py-1.5 text-xs font-medium bg-white dark:bg-white/5 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-white/10 hover:bg-slate-50 dark:hover:bg-white/10 transition-all cursor-pointer"
              >
                Reset
              </button>
            </div>
          </div>

          <!-- Status Banner -->
          <div id="simAutofillSuccess" class="hidden px-5 py-3 border-b border-emerald-200/80 dark:border-emerald-800/30 bg-emerald-50/60 dark:bg-emerald-950/20 text-emerald-800 dark:text-emerald-300 text-xs flex items-center justify-between">
            <div class="flex items-center gap-2 font-medium">
              <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 grid place-items-center text-[10px] font-bold">✓</span>
              <span>All 7 fields completed from verified personal memory vault.</span>
            </div>
            <span class="text-[11px] font-mono font-semibold text-emerald-600 dark:text-emerald-400">0.12s execution</span>
          </div>

          <!-- Simulated Application Form Body -->
          <div class="p-6 sm:p-8">
            <div class="mb-6 pb-4 border-b border-slate-100 dark:border-white/5">
              <h3 class="text-lg font-bold font-display text-slate-900 dark:text-white">
                Application for Senior Platform Architect
              </h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                San Francisco, CA &bull; Full-time &bull; Platform Engineering
              </p>
            </div>

            <form id="simulatedJobForm" class="grid sm:grid-cols-2 gap-5" onsubmit="return false;">
              <!-- Full Name -->
              <div class="relative">
                <div class="flex justify-between items-center mb-1.5">
                  <label for="simName" class="block text-xs font-semibold text-slate-700 dark:text-slate-200 font-display">
                    Legal Full Name <span class="text-rose-500">*</span>
                  </label>
                  <span id="badge-simName" class="hidden text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">
                    ✓ Matched
                  </span>
                </div>
                <input
                  type="text"
                  id="simName"
                  placeholder="e.g. Alex Morgan"
                  class="sim-input-field w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all"
                />
              </div>

              <!-- Email Address -->
              <div class="relative">
                <div class="flex justify-between items-center mb-1.5">
                  <label for="simEmail" class="block text-xs font-semibold text-slate-700 dark:text-slate-200 font-display">
                    Email Address <span class="text-rose-500">*</span>
                  </label>
                  <span id="badge-simEmail" class="hidden text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">
                    ✓ Matched
                  </span>
                </div>
                <input
                  type="email"
                  id="simEmail"
                  placeholder="alex.morgan@domain.com"
                  class="sim-input-field w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all"
                />
              </div>

              <!-- Phone Number -->
              <div class="relative">
                <div class="flex justify-between items-center mb-1.5">
                  <label for="simPhone" class="block text-xs font-semibold text-slate-700 dark:text-slate-200 font-display">
                    Phone Number <span class="text-rose-500">*</span>
                  </label>
                  <span id="badge-simPhone" class="hidden text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">
                    ✓ Matched
                  </span>
                </div>
                <input
                  type="tel"
                  id="simPhone"
                  placeholder="+1 (555) 349-2041"
                  class="sim-input-field w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all"
                />
              </div>

              <!-- Education -->
              <div class="relative">
                <div class="flex justify-between items-center mb-1.5">
                  <label for="simEducation" class="block text-xs font-semibold text-slate-700 dark:text-slate-200 font-display">
                    Degree &amp; Institution <span class="text-rose-500">*</span>
                  </label>
                  <span id="badge-simEducation" class="hidden text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">
                    ✓ Matched
                  </span>
                </div>
                <input
                  type="text"
                  id="simEducation"
                  placeholder="M.S. in Computer Science — Stanford University"
                  class="sim-input-field w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all"
                />
              </div>

              <!-- Recent Experience -->
              <div class="relative sm:col-span-2">
                <div class="flex justify-between items-center mb-1.5">
                  <label for="simExperience" class="block text-xs font-semibold text-slate-700 dark:text-slate-200 font-display">
                    Current / Most Recent Organization <span class="text-rose-500">*</span>
                  </label>
                  <span id="badge-simExperience" class="hidden text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">
                    ✓ Matched
                  </span>
                </div>
                <input
                  type="text"
                  id="simExperience"
                  placeholder="Staff Distributed Systems Architect at Stripe (2022 – Present)"
                  class="sim-input-field w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all"
                />
              </div>

              <!-- Portfolio / GitHub URL -->
              <div class="relative">
                <div class="flex justify-between items-center mb-1.5">
                  <label for="simPortfolio" class="block text-xs font-semibold text-slate-700 dark:text-slate-200 font-display">
                    GitHub / Portfolio URL
                  </label>
                  <span id="badge-simPortfolio" class="hidden text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">
                    ✓ Matched
                  </span>
                </div>
                <input
                  type="url"
                  id="simPortfolio"
                  placeholder="https://github.com/alexmorgan-dev"
                  class="sim-input-field w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all"
                />
              </div>

              <!-- LinkedIn Profile -->
              <div class="relative">
                <div class="flex justify-between items-center mb-1.5">
                  <label for="simLinkedin" class="block text-xs font-semibold text-slate-700 dark:text-slate-200 font-display">
                    LinkedIn Profile
                  </label>
                  <span id="badge-simLinkedin" class="hidden text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">
                    ✓ Matched
                  </span>
                </div>
                <input
                  type="url"
                  id="simLinkedin"
                  placeholder="https://linkedin.com/in/alexmorgan"
                  class="sim-input-field w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all"
                />
              </div>

              <!-- Custom Question -->
              <div class="relative sm:col-span-2">
                <div class="flex justify-between items-center mb-1.5">
                  <label for="simCustomQuestion" class="block text-xs font-semibold text-slate-700 dark:text-slate-200 font-display">
                    Custom Prompt: Describe high-throughput architecture experience
                  </label>
                  <span id="badge-simCustomQuestion" class="hidden text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">
                    ✓ Matched from Custom Q&amp;A
                  </span>
                </div>
                <textarea
                  id="simCustomQuestion"
                  rows="3"
                  placeholder="Over 7 years leading distributed architectures processing 15,000+ RPS..."
                  class="sim-input-field w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all resize-none"
                ></textarea>
              </div>
            </form>
          </div>

          <!-- Bottom Footnote -->
          <div class="px-6 py-3.5 bg-slate-50/80 dark:bg-white/[0.02] border-t border-slate-100 dark:border-white/5 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 font-body flex-wrap gap-3">
            <span class="flex items-center gap-1.5">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>Personal data remains private and local to your vault</span>
            </span>
            <a href="/playground" class="font-semibold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1">
              <span>Open full 10-field testing lab</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const btnSimulate = document.getElementById("btnSimulateAutofill");
    const btnClear = document.getElementById("btnClearSimForm");
    const successBanner = document.getElementById("simAutofillSuccess");

    const sampleData = {
      simName: "Alex Morgan",
      simEmail: "alex.morgan@domain.com",
      simPhone: "+1 (415) 890-4219",
      simEducation: "M.S. in Computer Science — Stanford University",
      simExperience: "Senior Staff Distributed Systems Architect at Stripe (2022 – Present)",
      simPortfolio: "https://github.com/alexmorgan-dev",
      simLinkedin: "https://linkedin.com/in/alexmorgan",
      simCustomQuestion: "Over 7 years architecting high-throughput distributed APIs handling 25,000+ RPS across AWS & GCP. Reduced p99 latency by 42% through optimized caching and connection pooling."
    };

    if (btnSimulate) {
      btnSimulate.addEventListener("click", () => {
        let delay = 0;
        const keys = Object.keys(sampleData);

        keys.forEach((id, index) => {
          setTimeout(() => {
            const input = document.getElementById(id);
            const badge = document.getElementById(`badge-${id}`);
            if (input) {
              input.value = sampleData[id];
              input.classList.add("border-emerald-500/70", "bg-emerald-50/20", "dark:bg-emerald-950/20");
              setTimeout(() => {
                input.classList.remove("border-emerald-500/70", "bg-emerald-50/20", "dark:bg-emerald-950/20");
              }, 1200);
            }
            if (badge) {
              badge.classList.remove("hidden");
            }

            if (index === keys.length - 1) {
              if (successBanner) {
                successBanner.classList.remove("hidden");
              }
            }
          }, delay);
          delay += 60;
        });
      });
    }

    if (btnClear) {
      btnClear.addEventListener("click", () => {
        const form = document.getElementById("simulatedJobForm");
        if (form) form.reset();
        Object.keys(sampleData).forEach((id) => {
          const badge = document.getElementById(`badge-${id}`);
          const input = document.getElementById(id);
          if (badge) badge.classList.add("hidden");
          if (input) input.classList.remove("border-emerald-500/70", "bg-emerald-50/20", "dark:bg-emerald-950/20");
        });
        if (successBanner) {
          successBanner.classList.add("hidden");
        }
      });
    }
  });
</script>

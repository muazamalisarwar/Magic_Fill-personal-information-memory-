---
interface Props {
  title: string;
  content?: string;
}
const { title, content } = Astro.props;
---

<div class="bg-white dark:bg-[#0f1422] border border-slate-200/80 dark:border-white/10 rounded-xl mb-4 overflow-hidden shadow-xs hover:border-slate-300 dark:hover:border-white/20 transition-all">
  <button class="accordion-header w-full p-5 sm:p-6 text-left flex items-center justify-between font-display font-bold text-base text-slate-900 dark:text-white hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors cursor-pointer select-none" data-accordion>
    <span>{title}</span>
    <div class="w-8 h-8 rounded-lg border border-slate-200/60 dark:border-white/10 bg-slate-50 dark:bg-white/5 flex items-center justify-center shrink-0 ml-4 text-slate-700 dark:text-slate-300">
      <svg
        class="accordion-icon size-3 transition-transform duration-300"
        viewBox="0 0 11 11"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M0.75 5.41602H10.0833"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M5.41663 10.083L5.41663 0.749675"
          class="accordion-icon-vertical-line"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </div>
  </button>
  <div class="accordion-content px-5 sm:px-6 pb-6 font-body text-sm text-slate-600 dark:text-slate-400 leading-relaxed hidden">
    {content}
  </div>
</div>

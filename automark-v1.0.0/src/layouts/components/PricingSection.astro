---
import PricingCard from "./PricingCard.astro";
import { getListPage } from "@/lib/contentParser.astro";
import type { Pricing } from "@/types";

interface Props {
  /** Override the section title HTML */
  title?: string;
  /** Override the section description */
  content?: string;
  isHome?: boolean;
}

const { title, content, isHome = true } = Astro.props;

const pricingEntry = await getListPage("pricing", "-index");
const pricingData: Pricing = pricingEntry.data;

const sectionTitle = title ?? pricingData.page_header?.title ?? "";
const sectionContent = content ?? pricingData.page_header?.content ?? "";
---

<section class="section relative overflow-hidden py-24" id="pricing">
  <div class="container">
    <div class="section-container">
      {
        isHome && (
          <div class="section-intro centralize text-center mb-16">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-indigo-600 mb-2">
              Transparent Pricing
            </p>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-slate-900 dark:text-white hasHighlight mb-4" set:html={sectionTitle} />
            {sectionContent && <p class="font-body text-slate-600 dark:text-slate-400 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">{sectionContent}</p>}
          </div>
        )
      }
      <div class="section-content text-center">
        <!-- Pricing Cycle Toggle -->
        <div class="inline-flex items-center justify-center mb-14">
          <div class="bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 p-1 rounded-xl inline-flex items-center gap-1">
            <input
              type="checkbox"
              data-pricing-toggle
              id="pricing-toggle"
              class="hidden"
            />
            <label
              for="pricing-toggle"
              id="lblToggleMonthly"
              class="bg-white dark:bg-white/10 text-slate-900 dark:text-white shadow-2xs px-5 py-2 text-xs font-semibold rounded-lg cursor-pointer transition-all active"
            >
              {pricingData.toggler?.monthly_label ?? "Monthly"}
            </label>
            <label
              for="pricing-toggle"
              id="lblToggleYearly"
              class="px-5 py-2 text-xs font-semibold text-slate-500 hover:text-slate-900 dark:hover:text-white rounded-lg cursor-pointer transition-all"
            >
              {pricingData.toggler?.yearly_label ?? "Yearly"}
              <span class="ml-1 text-[10px] text-emerald-600 dark:text-emerald-400 font-mono font-bold">(Save 20%)</span>
            </label>
          </div>
        </div>

        <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8 relative z-10 text-left">
          {
            pricingData.plans.map((plan) => (
              <PricingCard
                price={plan.price}
                yearly_price={plan.yearly_price}
                title={plan.title}
                is_featured={plan.is_featured}
                offer_text={plan.offer_text}
                button={plan.button}
                description={plan.description}
                features={plan.features}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const toggle = document.getElementById("pricing-toggle");
    const lblMonthly = document.getElementById("lblToggleMonthly");
    const lblYearly = document.getElementById("lblToggleYearly");
    const monthlyTags = document.querySelectorAll("[data-price-tag-monthly]");
    const yearlyTags = document.querySelectorAll("[data-price-tag-yearly]");

    if (toggle && lblMonthly && lblYearly) {
      toggle.addEventListener("change", () => {
        const isYearly = toggle.checked;
        const activeClasses = ["bg-white", "dark:bg-white/10", "text-slate-900", "dark:text-white", "shadow-2xs", "active"];
        if (isYearly) {
          lblMonthly.classList.remove(...activeClasses);
          lblMonthly.classList.add("text-slate-500");
          lblYearly.classList.add(...activeClasses);
          lblYearly.classList.remove("text-slate-500");
          monthlyTags.forEach(el => el.classList.add("opacity-0"));
          yearlyTags.forEach(el => el.classList.remove("opacity-0"));
        } else {
          lblYearly.classList.remove(...activeClasses);
          lblYearly.classList.add("text-slate-500");
          lblMonthly.classList.add(...activeClasses);
          lblMonthly.classList.remove("text-slate-500");
          yearlyTags.forEach(el => el.classList.add("opacity-0"));
          monthlyTags.forEach(el => el.classList.remove("opacity-0"));
        }
      });
    }
  });
</script>

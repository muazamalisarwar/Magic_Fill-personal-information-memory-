---
import ImageMod from "@/layouts/components/ImageMod.astro";
interface Props {
  logo: string;
  title: string;
  content?: string;
  is_starred: boolean;
}
const { logo, title, content, is_starred } = Astro.props;
---

<div
  data-card-spotlight
  data-tilt
  class="reveal-on-scroll bg-[#191D1A] border border-[#2B312C] rounded-2xl p-8 shadow-sm hover:border-[#B7F34A]/50 hover:shadow-[0_12px_32px_-8px_rgba(183,243,74,0.15)] transition-all duration-300 group relative flex flex-col items-center text-center h-full cursor-pointer"
>
  <!-- Clean Flat Icon Container -->
  <div class="w-14 h-14 rounded-xl border border-[#2B312C] bg-[#141715] flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300">
    <ImageMod src={logo} alt={`${title} icon`} class="size-7 object-contain" />
  </div>

  <h3 class="text-lg font-bold text-white group-hover:text-[#B7F34A] transition-colors mb-3">
    {title}
  </h3>

  <p class="text-sm text-[#A1AAA1] leading-relaxed">
    {content || "Proactively matches your verified personal memory to complex form fields with zero errors."}
  </p>
</div>

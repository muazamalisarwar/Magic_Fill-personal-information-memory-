---
// Hero Video Showcase (Silent Ambient Demo)
---

<div
  class="relative w-full max-w-5xl mx-auto rounded-2xl overflow-hidden group border border-slate-200 bg-white shadow-xl transition-all duration-300 hover:shadow-2xl hover:border-slate-300 will-change-transform"
  data-gsap-video-showcase
  data-card-spotlight
>
  <div class="relative w-full aspect-video overflow-hidden">
    <video
      id="videoPlayer"
      class="w-full h-full object-cover block cursor-pointer"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    >
      <source src="/showcase.mp4" type="video/mp4" />
      Your browser does not support the video tag.
    </video>

    <!-- Discreet Play/Pause Indicator (Always Silent) -->
    <button
      id="videoPlayPauseBtn"
      class="absolute bottom-4 right-4 z-20 size-9 rounded-full bg-slate-900/80 hover:bg-slate-900 text-white backdrop-blur-md flex items-center justify-center transition-all duration-200 opacity-0 group-hover:opacity-100 hover:scale-105 shadow-md cursor-pointer border border-white/20"
      aria-label="Pause or play video"
      title="Pause / Play"
    >
      <!-- Pause Icon (shown when playing) -->
      <svg id="iconPause" class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
        <rect x="6" y="4" width="4" height="16" rx="1"></rect>
        <rect x="14" y="4" width="4" height="16" rx="1"></rect>
      </svg>
      <!-- Play Icon (shown when paused) -->
      <svg id="iconPlay" class="size-4 hidden ml-0.5" fill="currentColor" viewBox="0 0 24 24">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
    </button>
  </div>
</div>

<script is:inline>
  (function() {
    const video = document.getElementById("videoPlayer");
    const btn = document.getElementById("videoPlayPauseBtn");
    const iconPause = document.getElementById("iconPause");
    const iconPlay = document.getElementById("iconPlay");

    if (video) {
      // Enforce 100% silent playback
      video.muted = true;
      video.volume = 0;
      video.defaultMuted = true;

      const togglePlay = () => {
        if (video.paused) {
          video.play();
          if (iconPause) iconPause.classList.remove("hidden");
          if (iconPlay) iconPlay.classList.add("hidden");
        } else {
          video.pause();
          if (iconPause) iconPause.classList.add("hidden");
          if (iconPlay) iconPlay.classList.remove("hidden");
        }
      };

      if (btn) btn.addEventListener("click", (e) => {
        e.stopPropagation();
        togglePlay();
      });
      video.addEventListener("click", togglePlay);
    }
  })();
</script>

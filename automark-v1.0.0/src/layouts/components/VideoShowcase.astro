---
// Hero Video Showcase (Neumorphism Design System)
---

<div
  class="relative w-full max-w-280 mx-auto rounded-[32px] overflow-hidden"
  data-gsap-video-showcase
>
  <video
    id="videoPlayer"
    class="w-full aspect-video object-cover rounded-[28px]"
    autoplay
    muted
    loop
    width="1000px"
    playsinline
    preload="metadata"
  >
    <source src="/showcase.mp4" type="video/mp4" />
    Your browser does not support the video tag.
  </video>

  <!-- Sound toggle overlay — visible = muted (shows icon to unmute) -->
  <button
    id="soundToggle"
    class="absolute inset-0 grid place-items-center group bg-black/20 cursor-pointer transition-opacity duration-300 rounded-[28px]"
    aria-label="Unmute video"
  >
    <div
      id="mutedIcon"
      class="neu-btn-primary size-20 rounded-full grid place-items-center group-hover:scale-110 transition-transform shadow-xl"
    >
      <!-- Play icon -->
      <svg
        width="28"
        height="28"
        class="size-7 text-white ml-1"
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
    </div>
  </button>
</div>

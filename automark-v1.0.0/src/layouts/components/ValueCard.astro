---
import ImageMod from "@/layouts/components/ImageMod.astro";
interface Props {
  logo: string;
  title: string;
  list?: string[];
}
const { logo, title, list } = Astro.props;
---

<div class="bg-white dark:bg-[#0f1422] border border-slate-200/80 dark:border-white/10 rounded-xl p-8 shadow-xs hover:border-slate-300 dark:hover:border-white/20 hover:shadow-sm transition-all group relative flex flex-col justify-between h-full">
  <div>
    <!-- Flat Icon Container -->
    <div class="w-14 h-14 rounded-lg border border-slate-100 dark:border-white/10 bg-slate-50 dark:bg-white/5 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300">
      <ImageMod src={logo} alt={`${title} icon`} class="size-7 object-contain" />
    </div>

    <!-- Card Title -->
    <h3 class="text-xl font-bold font-display text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors leading-snug mb-4">
      {title}
    </h3>

    <!-- Feature Checklist -->
    <ul class="space-y-3 font-body text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
      {list?.map((item) => (
        <li class="flex items-start gap-2.5">
          <span class="w-5 h-5 rounded-md bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/40 flex items-center justify-center shrink-0 mt-0.5 text-emerald-600 dark:text-emerald-400 text-xs font-bold">
            ✓
          </span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

---
import ImageMod from "@/layouts/components/ImageMod.astro";
interface Props {
  logo: string;
  title: string;
  list?: string[];
}
const { logo, title, list } = Astro.props;
---

<div
  data-card-spotlight
  data-tilt
  class="reveal-on-scroll bg-white/95 dark:bg-[#191D1A]/90 backdrop-blur-md border border-slate-200 dark:border-[#2B312C] rounded-2xl p-8 shadow-sm hover:border-[#2F6307]/50 dark:hover:border-[#B7F34A]/50 hover:shadow-[0_12px_32px_-8px_rgba(47,99,7,0.08)] dark:hover:shadow-[0_12px_32px_-8px_rgba(183,243,74,0.15)] transition-all duration-300 group relative flex flex-col justify-between h-full cursor-pointer"
>
  <div>
    <!-- Flat Icon Container -->
    <div class="w-14 h-14 rounded-xl border border-slate-200 dark:border-[#2B312C] bg-slate-50 dark:bg-[#141715] flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300">
      <ImageMod src={logo} alt={`${title} icon`} class="size-7 object-contain light-mode-icon" />
    </div>

    <!-- Card Title -->
    <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-[#2F6307] dark:group-hover:text-[#B7F34A] transition-colors leading-snug mb-4">
      {title}
    </h3>

    <!-- Feature Checklist -->
    <ul class="space-y-3 text-sm text-slate-600 dark:text-[#A1AAA1] leading-relaxed">
      {list?.map((item) => (
        <li class="flex items-start gap-2.5">
          <span class="w-5 h-5 rounded-md bg-[#2F6307]/10 dark:bg-[#B7F34A]/10 border border-[#2F6307]/20 dark:border-[#B7F34A]/30 flex items-center justify-center shrink-0 mt-0.5 text-[#2F6307] dark:text-[#B7F34A]">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <span class="text-slate-800 dark:text-white font-medium">{item}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

---
import ImageMod from "@/layouts/components/ImageMod.astro";
interface Props {
  logo: string;
  title: string;
  list?: string[];
}
const { logo, title, list } = Astro.props;
---

<div class="bg-[#191D1A] border border-[#2B312C] rounded-2xl p-8 shadow-sm hover:border-[#B7F34A]/40 transition-all group relative flex flex-col justify-between h-full">
  <div>
    <!-- Flat Icon Container -->
    <div class="w-14 h-14 rounded-xl border border-[#2B312C] bg-[#141715] flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300">
      <ImageMod src={logo} alt={`${title} icon`} class="size-7 object-contain" />
    </div>

    <!-- Card Title -->
    <h3 class="text-xl font-bold text-white group-hover:text-[#B7F34A] transition-colors leading-snug mb-4">
      {title}
    </h3>

    <!-- Feature Checklist -->
    <ul class="space-y-3 text-sm text-[#A1AAA1] leading-relaxed">
      {list?.map((item) => (
        <li class="flex items-start gap-2.5">
          <span class="w-5 h-5 rounded-md bg-[#B7F34A]/10 border border-[#B7F34A]/30 flex items-center justify-center shrink-0 mt-0.5 text-[#B7F34A]">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <span class="text-white">{item}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

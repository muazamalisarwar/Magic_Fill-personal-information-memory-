---
import PricingCheckout from "./PricingCheckout";

interface Feature {
  label: string;
  included: boolean;
  tooltip?: string;
}
interface Props {
  price: string;
  yearly_price: string;
  title: string;
  is_featured?: boolean;
  offer_text?: string;
  button: { enable: boolean; label: string; link: string };
  description?: string;
  features?: Feature[];
}
const {
  price,
  yearly_price,
  title,
  is_featured = false,
  offer_text,
  button,
  description,
  features,
} = Astro.props;
---

<div
  data-card-spotlight
  data-tilt
  class={`reveal-on-scroll bg-[#191D1A] border ${is_featured ? "border-[#B7F34A] shadow-[0_0_30px_rgba(183,243,74,0.18)] ring-1 ring-[#B7F34A]/30" : "border-[#2B312C]"} rounded-2xl p-8 sm:p-10 text-left relative flex flex-col justify-between transition-all duration-300 hover:border-[#B7F34A]/50`}
>
  <div>
    {
      is_featured && (
        <div class="absolute top-8 right-8">
          <span class="rounded-lg px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-[#B7F34A] bg-[#B7F34A]/10 border border-[#B7F34A]/30 font-mono">
            {offer_text ?? "Most Popular"}
          </span>
        </div>
      )
    }

    <!-- Pricing Header -->
    <div class="mb-8 leading-none relative">
      <span class="text-white text-4xl sm:text-5xl font-extrabold opacity-0">I</span>
      <span
        class="text-white text-4xl sm:text-5xl font-extrabold absolute left-0 top-0 flex items-baseline gap-1"
        data-price-tag-monthly
      >
        ${price}
        <span class="text-xs font-medium text-[#A1AAA1]">/ Month</span>
      </span>
      <span
        class="text-white text-4xl sm:text-5xl font-extrabold opacity-0 absolute left-0 top-0 flex items-baseline gap-1"
        data-price-tag-yearly
      >
        ${yearly_price}
        <span class="text-xs font-medium text-[#A1AAA1]">/ Month</span>
      </span>
    </div>

    <h3 class="text-xl font-bold text-white mb-3">{title}</h3>
    <p class="text-[#A1AAA1] text-sm leading-relaxed mb-8">{description}</p>

    <!-- Checkout Action Button -->
    <div class="mb-8">
      {
        button.enable && (
          <PricingCheckout 
            client:load 
            planTitle={title}
            monthlyPrice={price}
            yearlyPrice={yearly_price}
            buttonLabel={button.label}
            isFeatured={is_featured}
          />
        )
      }
    </div>

    <div class="text-xs font-semibold uppercase tracking-wider text-[#5E665E] font-mono mb-5">
      Included Capabilities
    </div>

    <!-- Feature list -->
    <ul class="space-y-3.5 text-sm text-[#A1AAA1]">
      {
        (features || []).map((f) => (
          <li class="flex items-start gap-3">
            {f.included ? (
              <span class="w-5 h-5 rounded-md bg-[#B7F34A]/10 border border-[#B7F34A]/30 flex items-center justify-center shrink-0 mt-0.5 text-[#B7F34A]">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
            ) : (
              <span class="w-5 h-5 rounded-md bg-[#141715] border border-[#2B312C] flex items-center justify-center shrink-0 mt-0.5 text-[#5E665E]">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </span>
            )}
            <span class={f.included ? "text-white" : "text-[#5E665E]"}>
              {f.label}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

---
import PricingCheckout from "./PricingCheckout";

interface Feature {
  label: string;
  included: boolean;
  tooltip?: string;
}
interface Props {
  price: string;
  yearly_price: string;
  title: string;
  is_featured?: boolean;
  offer_text?: string;
  button: { enable: boolean; label: string; link: string };
  description?: string;
  features?: Feature[];
}
const {
  price,
  yearly_price,
  title,
  is_featured = false,
  offer_text,
  button,
  description,
  features,
} = Astro.props;
---

<div
  class={`bg-white dark:bg-[#0f1422] border ${is_featured ? "border-indigo-600 shadow-md ring-1 ring-indigo-500/20" : "border-slate-200/80 dark:border-white/10 shadow-xs"} rounded-2xl p-8 sm:p-10 text-left relative flex flex-col justify-between transition-all`}
>
  <div>
    {
      is_featured && (
        <div class="absolute top-8 right-8">
          <span class="rounded-md px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800/40 font-display">
            {offer_text ?? "Most Popular"}
          </span>
        </div>
      )
    }

    <!-- Pricing Header -->
    <div class="mb-8 leading-none relative">
      <span class="text-slate-900 dark:text-white text-4xl sm:text-5xl font-extrabold font-display opacity-0">I</span>
      <span
        class="text-slate-900 dark:text-white text-4xl sm:text-5xl font-extrabold font-display absolute left-0 top-0 flex items-baseline gap-1"
        data-price-tag-monthly
      >
        ${price}
        <span class="text-xs font-medium text-slate-500 dark:text-slate-400 font-body">/ Month</span>
      </span>
      <span
        class="text-slate-900 dark:text-white text-4xl sm:text-5xl font-extrabold font-display opacity-0 absolute left-0 top-0 flex items-baseline gap-1"
        data-price-tag-yearly
      >
        ${yearly_price}
        <span class="text-xs font-medium text-slate-500 dark:text-slate-400 font-body">/ Month</span>
      </span>
    </div>

    <h3 class="text-xl font-bold font-display text-slate-900 dark:text-white mb-3">{title}</h3>
    <p class="font-body text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-8">{description}</p>

    <!-- Checkout Action Button -->
    <div class="mb-8">
      {
        button.enable && (
          <PricingCheckout 
            client:load 
            planTitle={title}
            monthlyPrice={price}
            yearlyPrice={yearly_price}
            buttonLabel={button.label}
            isFeatured={is_featured}
          />
        )
      }
    </div>

    <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 font-display mb-5">
      Included Capabilities
    </div>

    <!-- Feature list -->
    <ul class="space-y-3.5 font-body text-sm text-slate-600 dark:text-slate-300">
      {
        (features || []).map((f) => (
          <li class="flex items-start gap-3">
            {f.included ? (
              <span class="w-5 h-5 rounded-md bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/40 flex items-center justify-center shrink-0 mt-0.5 text-emerald-600 dark:text-emerald-400 text-xs font-bold">
                ✓
              </span>
            ) : (
              <span class="w-5 h-5 rounded-md bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 flex items-center justify-center shrink-0 mt-0.5 text-slate-400 text-xs">
                ✕
              </span>
            )}
            <span class="leading-relaxed">{f.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

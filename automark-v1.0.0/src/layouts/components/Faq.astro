---
import Accordion from "./Accordion.astro";
import { getListPage } from "@/lib/contentParser.astro";
import type { FaqSection } from "@/types";

const faqEntry = await getListPage("faqSection", "faq");
const faqData: FaqSection = faqEntry.data;
if (!faqData.enable) return;
---

<section class="section py-24 relative overflow-hidden" id="faq">
  <div class="container">
    <div class="section-container grid lg:grid-cols-12 gap-12 items-start">
      <div class="section-intro max-lg:text-center lg:col-span-5">
        <div class="sticky top-28">
          <div class="neu-pill px-4 py-1.5 mb-4 text-xs font-bold text-[#6C63FF] tracking-wider uppercase font-display inline-block">
            Frequently Asked
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-[#3D4852] hasHighlight mb-4" set:html={faqData.title} />
          <p class="font-body text-[#6B7280] text-base leading-relaxed">{faqData.description}</p>
          {
            faqData.button && faqData.button.enable && faqData.button.link && (
              <a href={faqData.button.link} class="neu-btn-secondary px-6 py-3 text-xs font-bold rounded-2xl mt-8 inline-flex">
                {faqData.button.label}
              </a>
            )
          }
        </div>
      </div>
      <div class="section-content lg:col-span-7">
        <div class="space-y-4">
          {
            faqData.items.map((item) => (
              <Accordion title={item.question} content={item.answer} />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

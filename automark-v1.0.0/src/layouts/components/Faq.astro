---
import Accordion from "./Accordion.astro";
import { getListPage } from "@/lib/contentParser.astro";
import type { FaqSection } from "@/types";

const faqEntry = await getListPage("faqSection", "faq");
const faqData: FaqSection = faqEntry.data;
if (!faqData.enable) return;
---

<section class="section py-24 relative overflow-hidden bg-transparent scroll-mt-20" id="faq">
  <div class="container">
    <div class="section-container grid lg:grid-cols-12 gap-12 items-start">
      <div class="section-intro max-lg:text-center lg:col-span-5">
        <div class="sticky top-28">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[#2F6307] dark:text-blue-600 mb-2 font-mono">
            Frequently Asked Questions
          </p>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white hasHighlight mb-4" set:html={faqData.title} />
          <p class="text-slate-600 dark:text-slate-600 text-base leading-relaxed">{faqData.description}</p>
          {
            faqData.button && faqData.button.enable && faqData.button.link && (
              <a href={faqData.button.link} class="rounded-xl px-4 py-2.5 text-xs font-medium bg-white dark:bg-slate-50 text-slate-800 dark:text-white border border-slate-300 dark:border-slate-200 hover:border-[#2F6307] dark:hover:border-blue-500/40 hover:bg-slate-50 dark:hover:bg-white mt-8 inline-flex transition-all">
                {faqData.button.label}
              </a>
            )
          }
        </div>
      </div>
      <div class="section-content lg:col-span-7">
        <div class="space-y-4">
          {
            faqData.items.map((item) => (
              <Accordion title={item.question} content={item.answer} />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

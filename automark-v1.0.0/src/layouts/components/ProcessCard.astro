---
interface Props {
  logo: string;
  step?: string;
  title: string;
  content: string;
}
const { logo, step, title, content } = Astro.props;
---

<div
  data-card-spotlight
  data-tilt
  class="reveal-on-scroll bg-white dark:bg-white border border-slate-200 dark:border-slate-200 rounded-2xl p-8 xl:p-10 shadow-sm hover:border-[#2F6307]/50 dark:hover:border-blue-500/50 hover:shadow-[0_12px_32px_-8px_rgba(47,99,7,0.08)] dark:hover:shadow-[0_12px_32px_-8px_rgba(183,243,74,0.15)] transition-all duration-300 flex flex-col items-center text-center relative overflow-hidden group h-full cursor-pointer"
>
  <!-- Step number label -->
  {step && (
    <span class="text-xs font-semibold uppercase tracking-[0.12em] text-[#2F6307] dark:text-blue-600 font-mono mb-4 block">
      Step {step}
    </span>
  )}

  <!-- Step Icon Container -->
  <div class="w-14 h-14 rounded-xl border border-slate-200 dark:border-slate-200 bg-slate-50 dark:bg-slate-50 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300">
    <img src={logo} alt={`${title} icon`} class="size-8 object-contain light-mode-icon" width="32" height="32" />
  </div>

  <!-- Title -->
  <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-[#2F6307] dark:group-hover:text-blue-600 transition-colors leading-snug mb-3">
    {title}
  </h3>

  <!-- Content -->
  <p class="text-slate-600 dark:text-slate-600 text-sm leading-relaxed max-w-sm mt-1">
    {content}
  </p>
</div>

---
interface Props {
  logo: string;
  step?: string;
  title: string;
  content: string;
}
const { logo, step, title, content } = Astro.props;
---

<div class="bg-[#191D1A] border border-[#2B312C] rounded-2xl p-8 xl:p-10 shadow-sm hover:border-[#B7F34A]/40 transition-all flex flex-col items-center text-center relative overflow-hidden group h-full">
  <!-- Step number label -->
  {step && (
    <span class="text-xs font-semibold uppercase tracking-[0.12em] text-[#B7F34A] font-mono mb-4 block">
      Step {step}
    </span>
  )}

  <!-- Step Icon Container -->
  <div class="w-14 h-14 rounded-xl border border-[#2B312C] bg-[#141715] flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300">
    <img src={logo} alt={`${title} icon`} class="size-8 object-contain" width="32" height="32" />
  </div>

  <!-- Title -->
  <h3 class="text-xl font-bold text-white group-hover:text-[#B7F34A] transition-colors leading-snug mb-3">
    {title}
  </h3>

  <!-- Content -->
  <p class="text-[#A1AAA1] text-sm leading-relaxed max-w-sm mt-1">
    {content}
  </p>
</div>

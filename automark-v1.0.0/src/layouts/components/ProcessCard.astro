---
interface Props {
  logo: string;
  step?: string;
  title: string;
  content: string;
}
const { logo, step, title, content } = Astro.props;
---

<div class="bg-white dark:bg-[#0f1422] border border-slate-200/80 dark:border-white/10 rounded-xl p-8 xl:p-10 shadow-xs hover:border-slate-300 dark:hover:border-white/20 hover:shadow-sm transition-all flex flex-col items-center text-center relative overflow-hidden group h-full">
  <!-- Step number label -->
  {step && (
    <span class="text-xs font-semibold uppercase tracking-[0.12em] text-indigo-600 mb-4 block">
      Step {step}
    </span>
  )}

  <!-- Step Icon Container -->
  <div class="w-14 h-14 rounded-lg border border-slate-100 dark:border-white/10 bg-slate-50 dark:bg-white/5 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300">
    <img src={logo} alt={`${title} icon`} class="size-8 object-contain" width="32" height="32" />
  </div>

  <!-- Title -->
  <h3 class="text-xl font-bold font-display text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors leading-snug mb-3">
    {title}
  </h3>

  <!-- Content -->
  <p class="font-body text-slate-600 dark:text-slate-400 text-sm leading-relaxed max-w-sm mt-1">
    {content}
  </p>
</div>

---
interface Props {
  logo?: string;
  icon?: string;
  title: string;
  category?: string;
  badge?: string;
  class?: string;
}
const { logo, title, category = "Universal Portal", badge = "Verified Compatible" } = Astro.props;
---

<div
  class="glass-card-interactive p-6 rounded-2xl bg-white/85 dark:bg-[#121626]/80 border border-slate-200/90 dark:border-white/10 backdrop-blur-xl shadow-md hover:shadow-xl hover:border-primary/40 transition-all duration-300 flex flex-col justify-between group"
>
  <div>
    <div class="flex items-center gap-3.5 mb-4">
      <div class="size-13 rounded-xl bg-slate-100 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 flex items-center justify-center p-2.5 shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-sm">
        {logo ? (
          <img
            src={logo}
            alt={`${title} logo`}
            class="w-full h-full object-contain"
            width="44"
            height="44"
          />
        ) : (
          <div class="size-6 rounded-full bg-primary/20 flex items-center justify-center text-primary font-bold text-xs">
            {title.slice(0, 2).toUpperCase()}
          </div>
        )}
      </div>
      <div class="min-w-0">
        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-primary transition-colors truncate">
          {title}
        </h3>
        <span class="text-xs text-slate-500 dark:text-slate-400 block truncate">
          {category}
        </span>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between pt-3 border-t border-slate-100 dark:border-white/5 mt-2">
    <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
      {badge}
    </span>
    <span class="text-[11px] text-slate-400 dark:text-white/30 font-mono">100% Ready</span>
  </div>
</div>

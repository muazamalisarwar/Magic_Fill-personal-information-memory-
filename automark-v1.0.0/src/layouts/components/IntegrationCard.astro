---
interface Props {
  logo?: string;
  icon?: string;
  title: string;
  category?: string;
  badge?: string;
  class?: string;
}
const { logo, title, category = "Universal Portal" } = Astro.props;
---

<div
  class="bg-white dark:bg-[#0f1422] border border-slate-200/80 dark:border-white/10 rounded-xl p-5 shadow-xs hover:border-slate-300 dark:hover:border-white/20 hover:shadow-sm transition-all flex items-center justify-between group"
>
  <div class="flex items-center gap-3.5 min-w-0">
    <div class="w-10 h-10 rounded-lg border border-slate-100 dark:border-white/10 bg-slate-50 dark:bg-white/5 flex items-center justify-center p-2 shrink-0">
      {logo ? (
        <img
          src={logo}
          alt={`${title} logo`}
          class="w-full h-full object-contain"
          width="24"
          height="24"
        />
      ) : (
        <div class="w-5 h-5 rounded bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center text-indigo-600 dark:text-indigo-400 font-semibold text-xs">
          {title.slice(0, 2).toUpperCase()}
        </div>
      )}
    </div>
    <div class="min-w-0">
      <h3 class="text-sm font-semibold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors truncate">
        {title}
      </h3>
      <span class="text-xs text-slate-500 dark:text-slate-400 block truncate">
        {category}
      </span>
    </div>
  </div>
  <span class="size-1.5 rounded-full bg-emerald-500 shrink-0 ml-2" title="Compatible"></span>
</div>

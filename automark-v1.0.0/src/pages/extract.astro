      }

      async function loadStoredDocuments() {
        const tbody = document.getElementById("documentsTableBody");
        if (!tbody) return;

        try {
          const res = await apiFetch("/api/documents/me", { headers });
          const docData = res.ok ? (await res.json())?.data || [] : [];
          storedDocsCache = docData;

          if (docCountBadge) docCountBadge.textContent = String(docData.length);

          if (docData.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-[#A1AAA1]">No documents uploaded yet. Upload a photo or ID document above to begin!</td></tr>`;
            return;
          }

          tbody.innerHTML = "";
          docData.forEach((doc, idx) => {
            const tr = document.createElement("tr");
            tr.className = "hover:bg-[#141715] transition-colors";
            const dateStr = doc.created_at ? new Date(doc.created_at).toLocaleDateString() : "";
            const sizeKb = (doc.file_size_bytes / 1024).toFixed(1);

            const isImg = (doc.mime_type && doc.mime_type.startsWith("image/")) || (doc.file_data && doc.file_data.startsWith("data:image"));
            const isPdf = (doc.mime_type && doc.mime_type.includes("pdf")) || (doc.file_data && doc.file_data.startsWith("data:application/pdf"));

            let thumbHtml = "";
            if (isImg) {
              thumbHtml = `<img src="${doc.file_data}" alt="${doc.title}" class="size-10 rounded-lg object-cover border border-[#2B312C] hover:border-[#B7F34A] cursor-pointer hover:scale-105 transition doc-thumb-click" data-idx="${idx}" title="Click to view full photo" />`;
            } else if (isPdf) {
              thumbHtml = `<div class="size-10 rounded-lg bg-[#141715] border border-[#2B312C] text-rose-400 flex items-center justify-center font-bold text-[10px] cursor-pointer hover:scale-105 transition doc-thumb-click" data-idx="${idx}">PDF</div>`;
            } else {
              thumbHtml = `<div class="size-10 rounded-lg bg-[#141715] border border-[#2B312C] text-[#A1AAA1] flex items-center justify-center font-bold text-[10px] cursor-pointer hover:scale-105 transition doc-thumb-click" data-idx="${idx}">DOC</div>`;
            }

            tr.innerHTML = `
              <td class="py-3">
                ${thumbHtml}
              </td>
              <td class="py-3">
                <div class="font-bold text-[#FFFFFF] text-xs truncate max-w-[180px]">${doc.file_name}</div>
                <div class="text-[10px] text-[#5E665E] font-mono">${doc.title || "Document"}</div>
              </td>
              <td class="py-3">
                ${getDocKeyBadge(doc.doc_key)}
              </td>
              <td class="py-3 text-[#A1AAA1] max-w-xs">
                <p class="truncate text-xs text-[#A1AAA1]">${doc.description || "—"}</p>
              </td>
              <td class="py-3 text-[#A1AAA1] font-mono text-[11px]">${sizeKb} KB</td>
              <td class="py-3 text-[#5E665E] font-mono text-[11px]">${dateStr}</td>
              <td class="py-3 text-right">
                <div class="flex items-center justify-end gap-1.5">
                  <button type="button" class="btn-preview-doc px-2.5 py-1 rounded-lg bg-[#141715] hover:bg-[#222723] text-[#FFFFFF] font-semibold text-xs border border-[#2B312C] cursor-pointer transition" data-idx="${idx}">
                    Preview
                  </button>
                  <button type="button" class="btn-delete-doc px-2.5 py-1 rounded-lg bg-rose-950/20 hover:bg-rose-950/40 text-rose-400 font-semibold text-xs border border-rose-900/30 cursor-pointer transition" data-id="${doc.id}">
                    Delete
                  </button>
                </div>
              </td>
            `;
            tbody.appendChild(tr);
          });

          tbody.querySelectorAll(".doc-thumb-click, .btn-preview-doc").forEach(el => {
            el.addEventListener("click", () => {
              const idx = parseInt(el.getAttribute("data-idx"), 10);
              if (!isNaN(idx) && storedDocsCache[idx]) {
                openDocModal(storedDocsCache[idx]);
              }
            });
          });

          tbody.querySelectorAll(".btn-delete-doc").forEach(btn => {
            btn.addEventListener("click", async () => {
              const docId = btn.getAttribute("data-id");
              if (!confirm("Permanently delete this document from your vault?")) return;
              try {
                const delRes = await apiFetch(`/api/documents/me/${docId}`, { method: "DELETE", headers });
                if (delRes.ok) {
                  showToast("Document deleted successfully.");
                  loadStoredDocuments();
                } else {
                  showToast("Failed to delete document.", "error");
                }
              } catch (err) {
                showToast("Network error deleting document.", "error");
              }
            });
          });
        } catch (e) {
          console.error("Error loading documents:", e);
        }
      }

      loadStoredDocuments();
    })();
  </script>
</Base>

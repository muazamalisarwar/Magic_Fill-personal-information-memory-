---
import Base from "@/layouts/Base.astro";
import ValueCard from "@/layouts/components/ValueCard.astro";
import PricingSection from "@/layouts/components/PricingSection.astro";
import ProcessCard from "@/layouts/components/ProcessCard.astro";
import Faq from "@/layouts/components/Faq.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import VideoShowcase from "@/layouts/components/VideoShowcase.astro";
import LivePlayground from "@/layouts/components/LivePlayground.astro";
import config from "@/config/config.json";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import Features from "@/partials/Features.astro";
import type { Homepage } from "@/types";

const homepage = await getListPage("homepage", "-index");
const homepageData: Homepage = homepage.data;
---

<Base>
  <!-- Immediate Auth Guard: Redirect Logged-In Users to Authenticated Dashboard -->
  <script is:inline>
    (function () {
      try {
        if (localStorage.getItem("magic_fill_token")) {
          window.location.replace("/dashboard");
        }
      } catch (e) {}
    })();
  </script>

  <!-- Hero Banner -->
  <section class="section-ph relative overflow-hidden pt-24 pb-16 sm:pt-32 sm:pb-24">
    <div class="container relative z-10">
      <div class="row justify-center">
        <div class="mb-14 text-center relative z-10">
          <!-- Hero Headline -->
          <h1
            class="mb-6 lg:col-10 mx-auto text-4xl sm:text-5xl lg:text-6xl hasHighlight tracking-tight font-extrabold font-display text-slate-900 dark:text-white leading-tight"
            set:html={markdownify(homepageData.banner.title)}
          />

          <!-- Hero Description -->
          <p class="mb-8 lg:col-8 mx-auto text-slate-600 dark:text-slate-300 font-body text-base sm:text-lg leading-relaxed">
            {homepageData.banner.content}
          </p>

          <!-- Primary & Secondary CTA Buttons -->
          <div class="flex gap-3 justify-center items-center flex-wrap">
            <a
              class="group px-7 py-3.5 text-sm sm:text-[15px] font-semibold rounded-xl bg-gradient-to-r from-indigo-600 via-indigo-600 to-indigo-700 hover:from-indigo-500 hover:to-indigo-600 text-white shadow-lg shadow-indigo-600/25 hover:shadow-indigo-600/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 flex items-center gap-2.5 cursor-pointer"
              rel="noopener noreferrer"
              href={homepageData.banner.button_primary.link}
            >
              <span>{homepageData.banner.button_primary.label}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="transition-transform duration-200 group-hover:translate-x-0.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a
              class="px-7 py-3.5 text-sm sm:text-[15px] font-semibold rounded-xl bg-white/90 dark:bg-slate-900/80 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200/90 dark:border-white/10 shadow-sm hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 backdrop-blur-sm cursor-pointer"
              rel="noopener noreferrer"
              href={homepageData.banner.button_secondary.link}
            >
              {homepageData.banner.button_secondary.label}
            </a>
          </div>
        </div>

        <!-- Video Showcase Container -->
        <div class="col-12">
          <div class="flex justify-center w-full">
            <div class="border border-slate-200/80 dark:border-white/10 rounded-2xl p-2 sm:p-3 bg-white/70 dark:bg-slate-900/60 shadow-xl shadow-slate-900/5 dark:shadow-black/40 backdrop-blur-md w-full max-w-5xl transition-all duration-300 hover:border-indigo-500/30">
              <VideoShowcase />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="h-px w-full bg-slate-200/80 dark:bg-white/5 my-4"></div>
  </div>

  <!-- Value Proposition -->
  {
    homepageData.value_props.enable && (
      <section class="section relative overflow-hidden py-24">
        <div class="container">
          <div class="section-container">
            <div class="section-intro centralize text-center mb-16">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400 mb-2 font-display">
                Core Capabilities
              </p>
              <h2
                class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-slate-900 dark:text-white hasHighlight mb-4"
                set:html={markdownify(homepageData.value_props.title)}
              />
              <p class="font-body text-slate-600 dark:text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
                {homepageData.value_props.content}
              </p>
            </div>
            <div class="section-content">
              <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
                {homepageData.value_props.items.map((item: any) => (
                  <ValueCard
                    logo={item.logo}
                    title={item.title}
                    list={item.list}
                  />
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Platform Features -->
  {
    homepageData.our_features.enable && (
      <Features our_features={homepageData.our_features} />
    )
  }

  <!-- Interactive Live Form Autofill Simulator -->
  <LivePlayground />

  <!-- How It Works / 3-Step Process -->
  {
    homepageData.growth_process.enable && (
      <section class="section py-24 bg-transparent relative overflow-hidden" id="workflow">
        <div class="container relative z-10">
          <div class="section-container">
            <div class="section-intro centralize mb-16 text-center">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400 mb-2 font-display">
                Simple Workflow
              </p>
              <h2
                class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-slate-900 dark:text-white hasHighlight mb-4"
                set:html={markdownify(homepageData.growth_process.title)}
              />
            </div>
            <div class="section-content">
              <div class="grid lg:grid-cols-3 gap-8">
                {homepageData.growth_process.items.map((item: any) => (
                  <ProcessCard
                    logo={item.logo}
                    step={item.step}
                    title={item.title}
                    content={item.content}
                  />
                ))}
              </div>
              {homepageData.growth_process.button.enable && (
                <div class="flex justify-center mt-14">
                  <a
                    href={homepageData.growth_process.button.link}
                    class="py-3 px-6 text-sm font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white transition-colors cursor-pointer shadow-xs inline-block"
                  >
                    {homepageData.growth_process.button.label}
                  </a>
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Supported Portals & Integrations -->
  {
    homepageData.integrations.enable && (
      <section id="portals" class="section relative overflow-hidden py-24">
        <div class="container max-w-6xl">
          <div class="section-container">
            <div class="section-intro centralize text-center mb-16">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-indigo-600 dark:text-indigo-400 mb-2 font-display">
                Universal ATS &amp; Portal Compatibility
              </p>
              <h2
                class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-slate-900 dark:text-white hasHighlight mb-4"
                set:html={markdownify(homepageData.integrations.title)}
              />
              <p class="font-body text-slate-600 dark:text-slate-300 text-base max-w-2xl mx-auto leading-relaxed">
                Magic Fill's deterministic semantic engine seamlessly recognizes field architectures across all enterprise ATS systems, job boards, and admissions forms with zero copy-pasting.
              </p>
            </div>
            
            <!-- Real Portals Showcase Grid: Clean Flat Cards (Rule 2) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
              {homepageData.integrations.items.map((item: any) => (
                <div class="bg-white dark:bg-[#0f1422] border border-slate-200/80 dark:border-white/10 rounded-xl p-5 shadow-xs hover:border-slate-300 dark:hover:border-white/20 hover:shadow-sm transition-all flex items-center justify-between group">
                  <div class="flex items-center gap-3.5 min-w-0">
                    <div class="w-10 h-10 rounded-lg border border-slate-100 dark:border-white/10 bg-slate-50 dark:bg-white/5 flex items-center justify-center p-2 shrink-0">
                      <img
                        src={item.image}
                        alt={`${item.name} logo`}
                        class="size-6 object-contain"
                        loading="lazy"
                        width="24"
                        height="24"
                      />
                    </div>
                    <div class="min-w-0">
                      <h3 class="text-sm font-semibold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors truncate">
                        {item.name}
                      </h3>
                      <span class="text-xs text-slate-500 dark:text-slate-400 block truncate">
                        {item.category}
                      </span>
                    </div>
                  </div>
                  <span class="size-1.5 rounded-full bg-emerald-500 shrink-0 ml-2" title="Compatible"></span>
                </div>
              ))}
            </div>

            <!-- Portal Compatibility Notice Footer -->
            <div class="mt-14 text-center">
              <p class="text-xs font-body text-slate-500 dark:text-slate-400">
                Applying on a private company portal or government site? Magic Fill's AI engine detects standard HTML form fields on <strong class="text-slate-900 dark:text-white">100% of websites</strong>.
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Pricing Plans -->
  {
    homepageData.pricing.enable && (
      <PricingSection
        title={homepageData.pricing.title}
        content={homepageData.pricing.content}
      />
    )
  }

  <!-- FAQ -->
  <Faq />

  <!-- Call To Action -->
  <CallToAction />
</Base>

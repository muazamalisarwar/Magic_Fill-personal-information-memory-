---
import Base from "@/layouts/Base.astro";
import ValueCard from "@/layouts/components/ValueCard.astro";
import PricingSection from "@/layouts/components/PricingSection.astro";
import ProcessCard from "@/layouts/components/ProcessCard.astro";
import Faq from "@/layouts/components/Faq.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import VideoShowcase from "@/layouts/components/VideoShowcase.astro";
import LivePlayground from "@/layouts/components/LivePlayground.astro";
import config from "@/config/config.json";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import Features from "@/partials/Features.astro";
import type { Homepage } from "@/types";

const homepage = await getListPage("homepage", "-index");
const homepageData: Homepage = homepage.data;
---

<Base>
  <!-- Immediate Auth Guard: Redirect Logged-In Users to Authenticated Dashboard -->
  <script is:inline>
    (function () {
      try {
        if (localStorage.getItem("magic_fill_token")) {
          window.location.replace("/dashboard");
        }
      } catch (e) {}
    })();
  </script>

  <!-- Persistent Ambient Animated Video Background (Landing Page Only - Fixed across all scrolling) -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden select-none" aria-hidden="true">
    <video
      id="landingBgVideo"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      class="w-full h-full object-cover object-center opacity-30 dark:opacity-65 scale-105 will-change-transform transition-opacity duration-500"
    >
      <source src="/green_background_15s.mp4" type="video/mp4" />
    </video>
    <!-- Seamless Global Vignette & Ambient Layering -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#F8FAF9]/80 via-transparent to-[#F8FAF9]/90 dark:from-[#0B0D0C]/85 dark:via-black/25 dark:to-[#0B0D0C]/85"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_30%,#F8FAF9_90%)] dark:bg-[radial-gradient(ellipse_at_center,transparent_30%,#0B0D0C_90%)]"></div>
  </div>

  <script is:inline>
    // Ensure brisk video playback rate on load
    (function () {
      try {
        const v = document.getElementById("landingBgVideo");
        if (v) {
          v.playbackRate = 1.15;
        }
      } catch (e) {}
    })();
  </script>

  <!-- Hero Banner -->
  <section class="section-ph relative z-10 overflow-hidden pt-24 pb-16 sm:pt-32 sm:pb-24 bg-transparent">
    <div class="container relative z-10">
      <div class="row justify-center">
        <div class="mb-10 sm:mb-14 text-center relative z-10">
          <!-- Hero Headline (Positioned in dark upper zone for maximum contrast) -->
          <h1
            class="mb-6 lg:col-10 mx-auto text-4xl sm:text-5xl lg:text-6xl hasHighlight tracking-tight font-extrabold font-display text-slate-900 dark:text-white leading-tight drop-shadow-sm"
            set:html={markdownify(homepageData.banner.title)}
          />

          <!-- Hero Description -->
          <p class="mb-8 lg:col-8 mx-auto text-slate-600 dark:text-slate-300 font-body text-base sm:text-lg leading-relaxed max-w-2xl">
            {homepageData.banner.content}
          </p>

          <!-- Primary & Secondary CTA Buttons -->
          <div class="flex gap-3 justify-center items-center flex-wrap">
            <a
              class="group px-7 py-3.5 text-sm sm:text-[15px] font-bold rounded-xl bg-[#B7F34A] hover:bg-[#c9f66d] text-[#0B0D0C] shadow-[0_0_25px_rgba(183,243,74,0.3)] hover:shadow-[0_0_35px_rgba(183,243,74,0.45)] hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 flex items-center gap-2.5 cursor-pointer backdrop-blur-sm"
              href="/extension"
            >
              <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="10" stroke="#0B0D0C" stroke-width="2" fill="none"/>
                <circle cx="12" cy="12" r="4" fill="#0B0D0C"/>
                <path d="M12 2a10 10 0 0 1 8.66 5l-4.33 7.5" stroke="#0B0D0C" stroke-width="2" stroke-linecap="round"/>
                <path d="M20.66 7a10 10 0 0 1-5 13.66l-4.33-7.5" stroke="#0B0D0C" stroke-width="2" stroke-linecap="round"/>
                <path d="M3.34 7a10 10 0 0 0 8.66 13.66l4.33-7.5" stroke="#0B0D0C" stroke-width="2" stroke-linecap="round"/>
              </svg>
              <span>Add to Chrome — Free</span>
              <span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-black/10 font-semibold">v1.2</span>
            </a>
            <a
              class="px-7 py-3.5 text-sm sm:text-[15px] font-semibold rounded-xl bg-white/90 dark:bg-[#141715]/90 hover:bg-slate-100 dark:hover:bg-[#191D1A] text-slate-800 dark:text-white border border-slate-300 dark:border-[#2B312C] hover:border-[#2F6307] dark:hover:border-[#B7F34A]/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer flex items-center gap-2 backdrop-blur-md"
              href="/playground"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              <span>Try Live Simulator</span>
            </a>
          </div>
        </div>

        <!-- Video Showcase Container (Floats over the lower streaming particle field) -->
        <div class="col-12 mt-2 sm:mt-4">
          <div class="flex justify-center w-full">
            <div data-card-spotlight data-tilt class="reveal-on-scroll border border-slate-200 dark:border-[#2B312C] rounded-2xl p-2 sm:p-3 bg-white/80 dark:bg-[#191D1A]/90 backdrop-blur-xl shadow-2xl w-full max-w-5xl transition-all duration-300 hover:border-[#B7F34A]/40 hover:shadow-[0_20px_60px_-15px_rgba(183,243,74,0.2)]">
              <VideoShowcase />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="h-px w-full bg-slate-200/80 dark:bg-white/5 my-4"></div>
  </div>

  <!-- Value Proposition -->
  {
    homepageData.value_props.enable && (
      <section id="capabilities" class="section relative overflow-hidden py-24 scroll-mt-20">
        <div class="container">
          <div class="section-container">
            <div class="section-intro centralize text-center mb-16">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[#2F6307] dark:text-[#B7F34A] mb-2 font-mono">
                Core Capabilities
              </p>
              <h2
                class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-slate-900 dark:text-white hasHighlight mb-4"
                set:html={markdownify(homepageData.value_props.title)}
              />
              <p class="font-body text-slate-600 dark:text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
                {homepageData.value_props.content}
              </p>
            </div>
            <div class="section-content">
              <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
                {homepageData.value_props.items.map((item: any) => (
                  <ValueCard
                    logo={item.logo}
                    title={item.title}
                    list={item.list}
                  />
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Platform Features -->
  {
    homepageData.our_features.enable && (
      <Features our_features={homepageData.our_features} />
    )
  }

  <!-- Interactive Live Form Autofill Simulator -->
  <LivePlayground />

  <!-- How It Works / 3-Step Process -->
  {
    homepageData.growth_process.enable && (
      <section class="section py-24 bg-transparent relative overflow-hidden" id="workflow">
        <div class="container relative z-10">
          <div class="section-container">
            <div class="section-intro centralize mb-16 text-center">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400 mb-2 font-display">
                Simple Workflow
              </p>
              <h2
                class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-slate-900 dark:text-white hasHighlight mb-4"
                set:html={markdownify(homepageData.growth_process.title)}
              />
            </div>
            <div class="section-content">
              <div class="grid lg:grid-cols-3 gap-8">
                {homepageData.growth_process.items.map((item: any) => (
                  <ProcessCard
                    logo={item.logo}
                    step={item.step}
                    title={item.title}
                    content={item.content}
                  />
                ))}
              </div>
              {homepageData.growth_process.button.enable && (
                <div class="flex justify-center mt-14">
                  <a
                    href={homepageData.growth_process.button.link}
                    class="py-3 px-6 text-sm font-bold rounded-xl bg-[#B7F34A] hover:bg-[#c9f66d] text-[#0B0D0C] transition-all cursor-pointer shadow-[0_0_15px_rgba(183,243,74,0.15)] inline-block"
                  >
                    {homepageData.growth_process.button.label}
                  </a>
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Supported Portals & Integrations -->
  {
    homepageData.integrations.enable && (
      <section id="portals" class="section relative overflow-hidden py-24">
        <div class="container max-w-6xl">
          <div class="section-container">
            <div class="section-intro centralize text-center mb-16">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[#2F6307] dark:text-[#B7F34A] mb-2 font-mono">
                Universal ATS &amp; Portal Compatibility
              </p>
              <h2
                class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white hasHighlight mb-4"
                set:html={markdownify(homepageData.integrations.title)}
              />
              <p class="text-slate-600 dark:text-[#A1AAA1] text-base max-w-2xl mx-auto leading-relaxed">
                Magic Fill's deterministic semantic engine seamlessly recognizes field architectures across all enterprise ATS systems, job boards, and admissions forms with zero copy-pasting.
              </p>
            </div>
            
            <!-- Real Portals Showcase Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
              {homepageData.integrations.items.map((item: any) => (
                <div class="bg-white dark:bg-[#191D1A] border border-slate-200 dark:border-[#2B312C] rounded-xl p-5 hover:border-[#2F6307]/40 dark:hover:border-[#B7F34A]/40 transition-all flex items-center justify-between group shadow-sm">
                  <div class="flex items-center gap-3.5 min-w-0">
                    <div class="w-10 h-10 rounded-lg border border-slate-200 dark:border-[#2B312C] bg-slate-50 dark:bg-[#141715] flex items-center justify-center p-2 shrink-0">
                      <img
                        src={item.image}
                        alt={`${item.name} logo`}
                        class="size-6 object-contain"
                        loading="lazy"
                        width="24"
                        height="24"
                      />
                    </div>
                    <div class="min-w-0">
                      <h3 class="text-sm font-semibold text-slate-900 dark:text-white group-hover:text-[#2F6307] dark:group-hover:text-[#B7F34A] transition-colors truncate">
                        {item.name}
                      </h3>
                      <span class="text-xs text-slate-500 dark:text-[#A1AAA1] block truncate">
                        {item.category}
                      </span>
                    </div>
                  </div>
                  <span class="size-1.5 rounded-full bg-[#2F6307] dark:bg-[#B7F34A] shadow-[0_0_6px_rgba(183,243,74,0.6)] shrink-0 ml-2" title="Compatible"></span>
                </div>
              ))}
            </div>

            <!-- Portal Compatibility Notice Footer -->
            <div class="mt-14 text-center">
              <p class="text-xs text-slate-600 dark:text-[#A1AAA1]">
                Applying on a private company portal or government site? Magic Fill's AI engine detects standard HTML form fields on <strong class="text-slate-900 dark:text-white">100% of websites</strong>.
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Pricing Plans -->
  {
    homepageData.pricing.enable && (
      <PricingSection
        title={homepageData.pricing.title}
        content={homepageData.pricing.content}
      />
    )
  }

  <!-- FAQ -->
  <Faq />

  <!-- Call To Action -->
  <CallToAction />
</Base>

---
import Base from "@/layouts/Base.astro";
import ValueCard from "@/layouts/components/ValueCard.astro";
import PricingSection from "@/layouts/components/PricingSection.astro";
import ProcessCard from "@/layouts/components/ProcessCard.astro";
import Faq from "@/layouts/components/Faq.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import VideoShowcase from "@/layouts/components/VideoShowcase.astro";
import LivePlayground from "@/layouts/components/LivePlayground.astro";
import config from "@/config/config.json";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import Features from "@/partials/Features.astro";
import type { Homepage } from "@/types";

const homepage = await getListPage("homepage", "-index");
const homepageData: Homepage = homepage.data;
---

<Base>
  <!-- Immediate Auth Guard: Redirect Logged-In Users to Authenticated Dashboard -->
  <script is:inline>
    (function () {
      try {
        if (localStorage.getItem("magic_fill_token")) {
          window.location.replace("/dashboard");
        }
      } catch (e) {}
    })();
  </script>

  <!-- Hero Banner (Clean, Lightweight White Background) -->
  <section class="section-ph relative z-10 overflow-hidden pt-20 pb-16 sm:pt-28 sm:pb-20 bg-white">
    <div class="container relative z-10">
      <div class="row justify-center">
        <div class="mb-10 sm:mb-12 text-center relative z-10">
          <!-- Hero Headline -->
          <h1
            class="mb-6 lg:col-10 mx-auto text-4xl sm:text-5xl lg:text-6xl hasHighlight tracking-tight font-extrabold font-display text-slate-900 leading-tight"
            set:html={markdownify(homepageData.banner.title)}
          />

          <!-- Hero Description -->
          <p class="mb-8 lg:col-8 mx-auto text-slate-600 font-body text-base sm:text-lg leading-relaxed max-w-2xl">
            {homepageData.banner.content}
          </p>

          <!-- Primary & Secondary CTA Buttons -->
          <div class="flex gap-3 justify-center items-center flex-wrap">
            <a
              class="group px-7 py-3.5 text-sm sm:text-[15px] font-bold rounded-xl bg-blue-600 hover:bg-blue-700 text-white shadow-xs hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 flex items-center gap-2.5 cursor-pointer"
              href="/extension"
            >
              <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="10" stroke="#FFFFFF" stroke-width="2" fill="none"/>
                <circle cx="12" cy="12" r="4" fill="#FFFFFF"/>
                <path d="M12 2a10 10 0 0 1 8.66 5l-4.33 7.5" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
                <path d="M20.66 7a10 10 0 0 1-5 13.66l-4.33-7.5" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
                <path d="M3.34 7a10 10 0 0 0 8.66 13.66l4.33-7.5" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
              </svg>
              <span>Add to Chrome — Free</span>
              <span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-white/20 font-semibold">v1.2</span>
            </a>
            <a
              class="px-7 py-3.5 text-sm sm:text-[15px] font-semibold rounded-xl bg-white hover:bg-slate-50 text-slate-800 border border-slate-300 hover:border-slate-400 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer flex items-center gap-2 shadow-xs"
              href="/playground"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              <span>Try Live Simulator</span>
            </a>
          </div>
        </div>

        <!-- Video Showcase Container (Seamless Edge-to-Edge Mockup) -->
        <div class="col-12 mt-2 sm:mt-4">
          <div class="flex justify-center w-full">
            <VideoShowcase />
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="h-px w-full bg-slate-200 my-4"></div>
  </div>

  <!-- Value Proposition -->
  {
    homepageData.value_props.enable && (
      <section id="capabilities" class="section relative overflow-hidden py-20 scroll-mt-20">
        <div class="container">
          <div class="section-container">
            <div class="section-intro centralize text-center mb-16">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-blue-600 mb-2 font-mono">
                Core Capabilities
              </p>
              <h2
                class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-slate-900 hasHighlight mb-4"
                set:html={markdownify(homepageData.value_props.title)}
              />
              <p class="font-body text-slate-600 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
                {homepageData.value_props.content}
              </p>
            </div>
            <div class="section-content">
              <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
                {homepageData.value_props.items.map((item: any) => (
                  <ValueCard
                    logo={item.logo}
                    title={item.title}
                    list={item.list}
                  />
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Platform Features -->
  {
    homepageData.our_features.enable && (
      <Features our_features={homepageData.our_features} />
    )
  }

  <!-- Interactive Live Form Autofill Simulator -->
  <LivePlayground />

  <!-- How It Works / 3-Step Process -->
  {
    homepageData.growth_process.enable && (
      <section class="section py-20 bg-slate-50 border-y border-slate-200 relative overflow-hidden" id="workflow">
        <div class="container relative z-10">
          <div class="section-container">
            <div class="section-intro centralize mb-16 text-center">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500 mb-2 font-display">
                Simple Workflow
              </p>
              <h2
                class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-slate-900 hasHighlight mb-4"
                set:html={markdownify(homepageData.growth_process.title)}
              />
            </div>
            <div class="section-content">
              <div class="grid lg:grid-cols-3 gap-6">
                {homepageData.growth_process.items.map((item: any) => (
                  <ProcessCard
                    logo={item.logo}
                    step={item.step}
                    title={item.title}
                    content={item.content}
                  />
                ))}
              </div>
              {homepageData.growth_process.button.enable && (
                <div class="flex justify-center mt-12">
                  <a
                    href={homepageData.growth_process.button.link}
                    class="py-3 px-6 text-sm font-bold rounded-xl bg-blue-600 hover:bg-blue-700 text-white transition-all cursor-pointer shadow-xs inline-block"
                  >
                    {homepageData.growth_process.button.label}
                  </a>
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Supported Portals & Integrations -->
  {
    homepageData.integrations.enable && (
      <section id="portals" class="section relative overflow-hidden py-20">
        <div class="container max-w-6xl">
          <div class="section-container">
            <div class="section-intro centralize text-center mb-16">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-blue-600 mb-2 font-mono">
                Universal ATS &amp; Portal Compatibility
              </p>
              <h2
                class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 hasHighlight mb-4"
                set:html={markdownify(homepageData.integrations.title)}
              />
              <p class="text-slate-600 text-base max-w-2xl mx-auto leading-relaxed">
                Magic Fill's deterministic semantic engine seamlessly recognizes field architectures across all enterprise ATS systems, job boards, and admissions forms with zero copy-pasting.
              </p>
            </div>
            
            <!-- Real Portals Showcase Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
              {homepageData.integrations.items.map((item: any) => (
                <div class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-400 hover:shadow-sm transition-all flex items-center justify-between group shadow-xs">
                  <div class="flex items-center gap-3.5 min-w-0">
                    <div class="w-10 h-10 rounded-lg border border-slate-200 bg-slate-50 flex items-center justify-center p-2 shrink-0">
                      <img
                        src={item.image}
                        alt={`${item.name} logo`}
                        class="size-6 object-contain"
                        loading="lazy"
                        width="24"
                        height="24"
                      />
                    </div>
                    <div class="min-w-0">
                      <h3 class="text-sm font-semibold text-slate-900 group-hover:text-blue-600 transition-colors truncate">
                        {item.name}
                      </h3>
                      <span class="text-xs text-slate-500 block truncate">
                        {item.category}
                      </span>
                    </div>
                  </div>
                  <span class="size-2 rounded-full bg-blue-600 shrink-0 ml-2" title="Compatible"></span>
                </div>
              ))}
            </div>

            <!-- Portal Compatibility Notice Footer -->
            <div class="mt-12 text-center">
              <p class="text-xs text-slate-500">
                Applying on a private company portal or government site? Magic Fill's AI engine detects standard HTML form fields on <strong class="text-slate-900">100% of websites</strong>.
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Pricing Plans -->
  {
    homepageData.pricing.enable && (
      <PricingSection
        title={homepageData.pricing.title}
        content={homepageData.pricing.content}
      />
    )
  }

  <!-- FAQ -->
  <Faq />

  <!-- Call To Action -->
  <CallToAction />
</Base>

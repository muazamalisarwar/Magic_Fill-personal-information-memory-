---
import Base from "@/layouts/Base.astro";
import Badge from "@/layouts/components/Badge.astro";
import BrandsCarousel from "@/layouts/components/BrandsCarousel.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import Faq from "@/layouts/components/Faq.astro";
import ImageMod from "@/layouts/components/ImageMod.astro";
import OurStory from "@/layouts/components/OurStory.astro";
import TeamCard from "@/layouts/components/TeamCard.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import Features from "@/partials/Features.astro";
import Testimonial from "@/partials/Testimonial.astro";
import type { About } from "@/types";

const about = await getListPage("about", "-index");
const aboutData: About = about.data;
---

<Base {...aboutData}>
  <!-- Page Header -->
  <section class="section-ph pb-20 overflow-hidden bg-[#0B0D0C]">
    <div class="container relative z-10">
      <div class="lg:max-w-4xl mx-auto text-center">
        <h1
          class="hasHighlight mb-6 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white"
          set:html={markdownify(aboutData.page_header.title)}
        />
        <p class="mb-5 text-lg text-[#A1AAA1] leading-relaxed">{aboutData.page_header.subtitle}</p>
        <div class="border border-[#2B312C] rounded-3xl overflow-hidden mt-12 bg-[#191D1A] p-2 shadow-xl">
          <ImageMod
            src={aboutData.page_header.image}
            alt="Team collaboration meeting"
            class="w-full h-auto object-cover aspect-video lg:aspect-1000/520 rounded-2xl"
          />
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="h-px w-full bg-[#2B312C] my-4"></div>
  </div>

  <!-- Trusted By Section -->
  <BrandsCarousel />

  <!-- Stats Section -->
  {
    aboutData.stats.enable && (
      <section class="section relative py-20 bg-[#0B0D0C]">
        <div class="container">
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            {aboutData.stats.items.map((stat: any) => (
              <div class="text-center p-8 lg:p-10 rounded-2xl bg-[#191D1A] border border-[#2B312C]">
                <div class="text-3xl lg:text-4xl font-extrabold text-[#B7F34A] font-mono mb-2">
                  {stat.value}
                </div>
                <p class="text-xs font-semibold uppercase tracking-wider text-[#A1AAA1]">{stat.label}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- CEO Letter Section -->
  <OurStory />

  <!-- Meet Our Team Section -->
  {
    aboutData.our_team.enable && (
      <section class="section relative isolate overflow-hidden py-24 bg-[#0B0D0C]">
        <div class="container">
          <div class="section-container">
            <div class="section-intro centralize text-center mb-16">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[#B7F34A] mb-2 font-mono">
                {aboutData.our_team.badge || "Our Team"}
              </p>
              <h2
                class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white hasHighlight mb-4"
                set:html={markdownify(aboutData.our_team.title)}
              />
            </div>
            <div class="section-content">
              <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
                {aboutData.our_team.members.map((member: any) => (
                  <TeamCard
                    image={member.image}
                    name={member.name}
                    role={member.role}
                  />
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Core Values -->
  {
    aboutData.core_values.enable && (
      <Features our_features={aboutData.core_values} />
    )
  }

  <!-- Testimonials Section -->
  <Testimonial />

  <!-- FAQ -->
  <Faq />

  <!-- Call to Action -->
  <CallToAction />
</Base>

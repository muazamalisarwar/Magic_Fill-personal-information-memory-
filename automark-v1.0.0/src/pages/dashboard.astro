---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Dashboard — Magic Fill"
  meta_title="Authenticated Dashboard — Magic Fill Personal Memory Vault"
  description="Central hub for managing your verified personal memory, document extraction, browser extension setup, and autofill status."
>
  <div class="pt-24 md:pt-28 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8 min-h-[85vh]">

    <!-- 1. Top Welcome & Identity Hero Card -->
    <div class="bg-[#191D1A] border border-[#2B312C] rounded-2xl p-6 sm:p-8 shadow-lg relative overflow-hidden">
      <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-center gap-4 sm:gap-5">
          <!-- Avatar -->
          <div id="userAvatarContainer" class="size-14 rounded-xl bg-[#141715] border border-[#2B312C] flex items-center justify-center shrink-0">
            <span id="userAvatarInitials" class="text-lg font-bold font-display text-[#B7F34A]">MF</span>
          </div>
          <div>
            <div class="flex items-center gap-3 mb-1 flex-wrap">
              <h1 id="dashUserGreeting" class="text-xl sm:text-2xl font-bold font-display text-[#FFFFFF]">
                Welcome back!
              </h1>
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-0.5 rounded-full bg-[#B7F34A]/10 text-[#B7F34A] border border-[#B7F34A]/25">
                <span class="size-1.5 rounded-full bg-[#B7F34A] animate-pulse"></span>
                Vault Active
              </span>
            </div>
            <p id="dashUserEmail" class="text-xs text-[#A1AAA1] font-mono">Loading profile...</p>
          </div>
        </div>

        <!-- Header Actions -->
        <div class="flex flex-wrap items-center gap-2.5">
          <a
            href="/memory"
            class="btn btn-primary btn-sm rounded-lg"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
            <span>Open Memory Vault</span>
          </a>

          <a
            href="/extract"
            class="btn btn-outline btn-sm rounded-lg bg-[#141715] border-[#2B312C]"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
            <span>Upload Resume</span>
          </a>

          <button
            type="button"
            id="dashSignOutBtn"
            class="btn btn-danger btn-sm rounded-lg"
            title="Sign Out"
          >
            Sign Out
          </button>
        </div>
      </div>

      <!-- Live Vault Metrics Counter Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 sm:gap-4 mt-8 pt-6 border-t border-[#2B312C]">
        <div class="bg-[#141715] border border-[#2B312C] hover:border-[#3A423C] rounded-xl p-4 sm:p-5 transition-colors group">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-[#A1AAA1]">Identity Fields</span>
            <div class="size-7 rounded-md bg-[#191D1A] border border-[#2B312C] text-[#B7F34A] flex items-center justify-center shrink-0">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </div>
          </div>
          <span id="metricIdentityCount" class="text-2xl sm:text-3xl font-extrabold font-display text-[#FFFFFF] tracking-tight block">--</span>
          <span class="text-[10px] text-[#5E665E] block mt-1 font-mono">Name, Contact, Education</span>
        </div>

        <div class="bg-[#141715] border border-[#2B312C] hover:border-[#3A423C] rounded-xl p-4 sm:p-5 transition-colors group">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-[#A1AAA1]">Work Experiences</span>
            <div class="size-7 rounded-md bg-[#191D1A] border border-[#2B312C] text-[#B7F34A] flex items-center justify-center shrink-0">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
            </div>
          </div>
          <span id="metricExperienceCount" class="text-2xl sm:text-3xl font-extrabold font-display text-[#FFFFFF] tracking-tight block">--</span>
          <span class="text-[10px] text-[#5E665E] block mt-1 font-mono">Roles, Companies, Skills</span>
        </div>

        <div class="bg-[#141715] border border-[#2B312C] hover:border-[#3A423C] rounded-xl p-4 sm:p-5 transition-colors group">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-[#A1AAA1]">Custom Q&amp;A</span>
            <div class="size-7 rounded-md bg-[#191D1A] border border-[#2B312C] text-[#B7F34A] flex items-center justify-center shrink-0">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            </div>
          </div>
          <span id="metricCustomCount" class="text-2xl sm:text-3xl font-extrabold font-display text-[#FFFFFF] tracking-tight block">--</span>
          <span class="text-[10px] text-[#5E665E] block mt-1 font-mono">Learned &amp; Manual</span>
        </div>

        <div class="bg-[#141715] border border-[#2B312C] hover:border-[#3A423C] rounded-xl p-4 sm:p-5 transition-colors group">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-[#A1AAA1]">Stored Documents</span>
            <div class="size-7 rounded-md bg-[#191D1A] border border-[#2B312C] text-[#B7F34A] flex items-center justify-center shrink-0">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            </div>
          </div>
          <span id="metricDocCount" class="text-2xl sm:text-3xl font-extrabold font-display text-[#FFFFFF] tracking-tight block">--</span>
          <span class="text-[10px] text-[#5E665E] block mt-1 font-mono">Resumes &amp; Identity</span>
        </div>
      </div>
    </div>

    <!-- 2. Primary Navigation Hub Cards (4 Dedicated Feature Pages) -->
    <div>
      <div class="mb-4">
        <h2 class="text-lg font-bold font-display text-[#FFFFFF]">
          Platform Features &amp; Workflows
        </h2>
        <p class="text-xs text-[#A1AAA1]">
          Access verified personal memory tools and automation modules
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1: Personal Memory Studio -->
        <a
          href="/memory"
          class="bg-[#191D1A] border border-[#2B312C] hover:border-[#3A423C] rounded-xl p-5 shadow-sm transition-all duration-150 flex flex-col justify-between group cursor-pointer hover:-translate-y-0.5"
        >
          <div>
            <div class="size-10 rounded-lg bg-[#141715] border border-[#2B312C] flex items-center justify-center mb-4 text-[#B7F34A]">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
            </div>
            <h3 class="text-sm font-bold font-display text-[#FFFFFF] mb-1.5 group-hover:text-[#B7F34A] transition-colors">
              Personal Memory Vault
            </h3>
            <p class="text-xs font-body text-[#A1AAA1] leading-relaxed mb-4">
              Inspect, edit, search, and organize all your verified credentials, education records, and custom answers.
            </p>
          </div>
          <div class="flex items-center text-xs font-semibold text-[#B7F34A] gap-1.5 pt-3 border-t border-[#2B312C]">
            <span>Manage Vault</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>

        <!-- Card 2: AI Document Extraction -->
        <a
          href="/extract"
          class="bg-[#191D1A] border border-[#2B312C] hover:border-[#3A423C] rounded-xl p-5 shadow-sm transition-all duration-150 flex flex-col justify-between group cursor-pointer hover:-translate-y-0.5"
        >
          <div>
            <div class="size-10 rounded-lg bg-[#141715] border border-[#2B312C] flex items-center justify-center mb-4 text-[#B7F34A]">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <h3 class="text-sm font-bold font-display text-[#FFFFFF] mb-1.5 group-hover:text-[#B7F34A] transition-colors">
              AI Document Extraction
            </h3>
            <p class="text-xs font-body text-[#A1AAA1] leading-relaxed mb-4">
              Upload CV/Resume or talk to the AI memory copilot. Review and approve extracted information before saving.
            </p>
          </div>
          <div class="flex items-center text-xs font-semibold text-[#B7F34A] gap-1.5 pt-3 border-t border-[#2B312C]">
            <span>Extract &amp; Review</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>

        <!-- Card 3: Browser Extension Pairing -->
        <a
          href="/extension"
          class="bg-[#191D1A] border border-[#2B312C] hover:border-[#3A423C] rounded-xl p-5 shadow-sm transition-all duration-150 flex flex-col justify-between group cursor-pointer hover:-translate-y-0.5"
        >
          <div>
            <div class="size-10 rounded-lg bg-[#141715] border border-[#2B312C] flex items-center justify-center mb-4 text-[#B7F34A]">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            </div>
            <h3 class="text-sm font-bold font-display text-[#FFFFFF] mb-1.5 group-hover:text-[#B7F34A] transition-colors">
              Extension Setup &amp; Sync
            </h3>
            <p class="text-xs font-body text-[#A1AAA1] leading-relaxed mb-4">
              Generate 1-click pairing codes, check extension connectivity, and synchronize across any Chromium browser.
            </p>
          </div>
          <div class="flex items-center text-xs font-semibold text-[#B7F34A] gap-1.5 pt-3 border-t border-[#2B312C]">
            <span>Pair Extension</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>

        <!-- Card 4: Form Simulator -->
        <a
          href="/playground"
          class="bg-[#191D1A] border border-[#2B312C] hover:border-[#3A423C] rounded-xl p-5 shadow-sm transition-all duration-150 flex flex-col justify-between group cursor-pointer hover:-translate-y-0.5"
        >
          <div>
            <div class="size-10 rounded-lg bg-[#141715] border border-[#2B312C] flex items-center justify-center mb-4 text-[#B7F34A]">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            </div>
            <h3 class="text-sm font-bold font-display text-[#FFFFFF] mb-1.5 group-hover:text-[#B7F34A] transition-colors">
              Live Form Simulator
            </h3>
            <p class="text-xs font-body text-[#A1AAA1] leading-relaxed mb-4">
              Test autofill on 10 input types with real-time semantic visual feedback and consent-based learning.
            </p>
          </div>
          <div class="flex items-center text-xs font-semibold text-[#B7F34A] gap-1.5 pt-3 border-t border-[#2B312C]">
            <span>Launch Simulator</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>
      </div>
    </div>

    <!-- 3. Memory Snapshot & Recent Activity Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Left 2 Cols: Stored Attributes Table -->
      <div class="lg:col-span-2 bg-[#191D1A] border border-[#2B312C] rounded-2xl p-5 sm:p-7 shadow-sm">
        <div class="flex items-center justify-between mb-5 pb-3 border-b border-[#2B312C]">
          <div>
            <h3 class="text-base font-bold font-display text-[#FFFFFF]">Active Memory Overview</h3>
            <p class="text-xs text-[#A1AAA1]">Verified records ready for instantaneous browser autofill</p>
          </div>
          <a href="/memory" class="text-xs text-[#B7F34A] font-semibold hover:underline flex items-center gap-1">
            <span>View All</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="border-b border-[#2B312C] text-[#A1AAA1] uppercase tracking-wider text-[11px] font-semibold">
                <th class="pb-3 pr-4">Field / Attribute</th>
                <th class="pb-3 pr-4">Stored Value</th>
                <th class="pb-3 pr-4">Category</th>
                <th class="pb-3">Source</th>
              </tr>
            </thead>
            <tbody id="dashMemoryTableBody" class="font-body text-[#A1AAA1] divide-y divide-[#2B312C]/60">
              <tr>
                <td colspan="4" class="py-8 text-center text-[#A1AAA1]">
                  <div class="inline-block size-5 border-2 border-[#B7F34A] border-t-transparent rounded-full animate-spin mb-2"></div>
                  <div>Loading verified memory records...</div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Right 1 Col: Quick Browser Connection Card -->
      <div class="bg-[#191D1A] border border-[#2B312C] rounded-2xl p-5 sm:p-7 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider text-[#A1AAA1]">Browser Extension</span>
            <span class="inline-flex items-center gap-1 text-[11px] font-medium text-[#B7F34A]">
              <span class="size-1.5 rounded-full bg-[#B7F34A]"></span>
              Ready
            </span>
          </div>

          <h4 class="text-base font-bold font-display text-[#FFFFFF] mb-1.5">Pair Browser Extension</h4>
          <p class="text-xs text-[#A1AAA1] leading-relaxed mb-5">
            Use this authorization code to securely connect your Magic Fill Chromium extension in seconds.
          </p>

          <!-- Pairing Code Box -->
          <div class="bg-[#141715] border border-[#2B312C] rounded-xl p-4 text-center mb-5">
            <span class="text-[10px] text-[#5E665E] uppercase tracking-wider font-semibold block mb-1">Single-Use Link Code</span>
            <div id="dashPairingCode" class="text-2xl font-mono font-bold text-[#B7F34A] tracking-wider select-all">
              Generating...
            </div>
            <button
              type="button"
              id="dashCopyCodeBtn"
              class="mt-3 w-full rounded-lg py-2 px-3 text-xs font-semibold bg-[#191D1A] hover:bg-[#222723] text-[#FFFFFF] border border-[#2B312C] flex items-center justify-center gap-2 transition cursor-pointer"
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Copy Connection Code</span>
            </button>
          </div>
        </div>

        <div class="pt-3 border-t border-[#2B312C]">
          <a href="/extension" class="text-xs font-medium text-[#A1AAA1] hover:text-[#B7F34A] flex items-center justify-between transition-colors">
            <span>Installation &amp; setup guide</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Dashboard Initialization Script -->
  <script is:inline>
    (async () => {
      const token = localStorage.getItem("magic_fill_token");
      if (!token) {
        window.location.href = "/login?redirect=/dashboard";
        return;
      }

      // Sign Out Handler
      const signOutBtn = document.getElementById("dashSignOutBtn");
      if (signOutBtn) {
        signOutBtn.addEventListener("click", () => {
          localStorage.removeItem("magic_fill_token");
          localStorage.removeItem("magic_fill_user");
          window.location.href = "/login";
        });
      }

      // Fetch User & Profile Data
      try {
        const headers = { "Authorization": `Bearer ${token}` };

        // 1. Fetch user identity
        const userRes = await fetch("/api/auth/me", { headers });
        if (!userRes.ok) {
          localStorage.removeItem("magic_fill_token");
          window.location.href = "/login";
          return;
        }
        const userData = (await userRes.json())?.data;

        // Display user info
        const displayName = userData?.full_name || userData?.email?.split("@")[0] || "User";
        const emailEl = document.getElementById("dashUserEmail");
        const greetingEl = document.getElementById("dashUserGreeting");
        const initialsEl = document.getElementById("userAvatarInitials");

        if (greetingEl) greetingEl.textContent = `Welcome back, ${displayName}!`;
        if (emailEl) emailEl.textContent = userData?.email || "";
        if (initialsEl) {
          const parts = displayName.trim().split(" ");
          initialsEl.textContent = (parts[0][0] + (parts[1] ? parts[1][0] : "")).toUpperCase();
        }

        // 2. Fetch full memory profile
        const profRes = await fetch("/api/personal-info/me", { headers });
        const profData = profRes.ok ? (await profRes.json())?.data : null;

        // 3. Fetch experiences
        const expRes = await fetch("/api/experiences/me", { headers });
        const expData = expRes.ok ? (await expRes.json())?.data || [] : [];

        // 4. Fetch custom fields
        const cfRes = await fetch("/api/custom-fields/me", { headers });
        const cfData = cfRes.ok ? (await cfRes.json())?.data || [] : [];

        // 5. Fetch documents
        const docRes = await fetch("/api/documents/me", { headers });
        const docData = docRes.ok ? (await docRes.json())?.data || [] : [];

        // Update Counter Strip
        let idCount = 0;
        if (profData) {
          const keys = ["full_name", "email", "phone", "city", "country", "university", "degree", "major"];
          keys.forEach(k => { if (profData[k]) idCount++; });
        }
        document.getElementById("metricIdentityCount").textContent = idCount;
        document.getElementById("metricExperienceCount").textContent = expData.length;
        document.getElementById("metricCustomCount").textContent = cfData.length;
        document.getElementById("metricDocCount").textContent = docData.length;

        // Populate Table with sample verified records
        const tbody = document.getElementById("dashMemoryTableBody");
        if (tbody) {
          tbody.innerHTML = "";
          const rows = [];

          if (profData?.full_name) rows.push({ label: "Full Legal Name", val: profData.full_name, cat: "Identity", src: "Personal Vault" });
          if (profData?.email) rows.push({ label: "Primary Email", val: profData.email, cat: "Contact", src: "Account" });
          if (profData?.phone) rows.push({ label: "Phone Number", val: profData.phone, cat: "Contact", src: "Personal Vault" });
          if (profData?.country) rows.push({ label: "Country of Residence", val: profData.country, cat: "Identity", src: "Personal Vault" });
          if (profData?.university) rows.push({ label: "University / College", val: profData.university, cat: "Education", src: "Academic" });
          if (profData?.degree) rows.push({ label: "Degree Program", val: profData.degree, cat: "Education", src: "Academic" });

          expData.slice(0, 2).forEach(exp => {
            rows.push({ label: `Role: ${exp.job_title}`, val: `${exp.company} (${exp.start_date || ""} - ${exp.end_date || "Present"})`, cat: "Experience", src: "Career Vault" });
          });

          cfData.slice(0, 3).forEach(cf => {
            rows.push({ label: cf.field_label, val: cf.field_value, cat: cf.category || "Custom", src: "Learned / Manual" });
          });

          if (rows.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-[#A1AAA1]">No memory records saved yet. <a href="/extract" class="text-[#B7F34A] font-semibold hover:underline">Upload your resume</a> to start!</td></tr>`;
          } else {
            rows.forEach(r => {
              const tr = document.createElement("tr");
              tr.className = "hover:bg-[#141715] transition-colors";
              tr.innerHTML = `
                <td class="py-3 pr-4 font-semibold text-[#FFFFFF]">${r.label}</td>
                <td class="py-3 pr-4 text-[#A1AAA1] truncate max-w-xs font-mono text-[11px]">${r.val}</td>
                <td class="py-3 pr-4"><span class="rounded-md px-2 py-0.5 text-[11px] font-medium bg-[#141715] text-[#A1AAA1] border border-[#2B312C]">${r.cat}</span></td>
                <td class="py-3 text-[#5E665E] text-[11px]">${r.src}</td>
              `;
              tbody.appendChild(tr);
            });
          }
        }

        // Generate Pairing Code for Quick Box
        const pairRes = await fetch("/api/auth/extension/create-code", {
          method: "POST",
          headers: { ...headers, "Content-Type": "application/json" },
          body: JSON.stringify({ client_id: "dashboard-quick-pair" })
        });
        if (pairRes.ok) {
          const codeData = (await pairRes.json())?.data?.code;
          const codeEl = document.getElementById("dashPairingCode");
          if (codeEl) codeEl.textContent = codeData || "MF-READY";

          const copyBtn = document.getElementById("dashCopyCodeBtn");
          if (copyBtn && codeData) {
            copyBtn.addEventListener("click", () => {
              navigator.clipboard.writeText(codeData);

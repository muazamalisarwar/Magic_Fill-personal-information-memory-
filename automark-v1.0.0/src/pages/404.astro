---
import Base from "@/layouts/Base.astro";
---

<Base title="Page Not Found">
  <section class="section-ph text-center relative overflow-hidden bg-[#0B0D0C] min-h-[70vh] flex items-center">
    <div class="container relative z-10">
      <div class="row justify-center">
        <div class="sm:col-10 md:col-8 lg:col-6 mx-auto">
          <span class="text-7xl sm:text-9xl block font-extrabold text-[#B7F34A] font-mono tracking-tight mb-4">404</span>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white mb-4">Page not found</h1>
          <p class="text-[#A1AAA1] text-sm leading-relaxed mb-8 max-w-md mx-auto">
            The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
          </p>
          <a href="/" class="btn btn-primary">Back to home</a>
        </div>
      </div>
    </div>
  </section>
</Base>

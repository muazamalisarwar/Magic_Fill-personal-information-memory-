---
import Base from "@/layouts/Base.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import Faq from "@/layouts/components/Faq.astro";
import IntegrationCard from "@/layouts/components/IntegrationCard.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { Integrations } from "@/types";

const integrations = await getListPage("integrations", "-index");
const integrationsData: Integrations = integrations.data;
---

<Base {...integrationsData}>
  <!-- Page Header -->
  <section class="section-ph pt-28 pb-14 relative bg-[#0B0D0C]">
    <div class="container relative z-10">
      <div class="lg:max-w-4xl mx-auto text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[#2F6307] dark:text-[#B7F34A] mb-2 font-mono">
          Universal Compatibility
        </p>
        <h1
          class="hasHighlight mb-0 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white"
          set:html={markdownify(integrationsData.page_header.title)}
        />
      </div>
    </div>
  </section>

  <!-- Integrations Grid -->
  {
    integrationsData.integrations.enable && (
      <section class="section pt-0 pb-24 bg-[#0B0D0C]">
        <div class="container">
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-5">
            {integrationsData.integrations.items.map((item: any) => (
              <IntegrationCard
                logo={item.logo}
                title={item.title}
                category={item.category}
                badge={item.badge}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <Faq />

  <!-- Call to Action -->
  <CallToAction />
</Base>

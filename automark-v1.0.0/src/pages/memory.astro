---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Personal Memory Vault — Magic Fill"
  meta_title="Personal Memory Vault — Magic Fill"
  description="Inspect, edit, search, organize, and manage your verified personal memory records for intelligent autofill."
>
  <div class="pt-24 md:pt-28 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8 min-h-[85vh]">

    <!-- 1. Header & Quick Controls -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-[#2B312C]">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <a href="/dashboard" class="text-xs text-[#A1AAA1] hover:text-[#FFFFFF] transition-colors flex items-center gap-1">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            <span>Dashboard</span>
          </a>
          <span class="text-[#2B312C]">/</span>
          <span class="text-xs text-[#B7F34A] font-medium">Memory Vault</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold font-display text-[#FFFFFF] tracking-tight">Personal Memory Vault</h1>
        <p class="text-xs sm:text-sm text-[#A1AAA1] mt-1">
          Inspect, manage, and verify the personal records Magic Fill uses for intelligent autofill.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          id="btnOpenAddModal"
          class="btn btn-primary btn-sm rounded-lg"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Add Custom Field</span>
        </button>

        <a
          href="/extract"
          class="btn btn-outline btn-sm rounded-lg bg-[#141715] border-[#2B312C]"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
          <span>Extract from CV</span>
        </a>

        <button
          type="button"
          id="btnExportJsonVault"
          class="btn btn-outline btn-sm rounded-lg bg-[#141715] border-[#2B312C]"
          title="Export entire vault as JSON backup"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          <span>Backup JSON</span>
        </button>

        <!-- Reset Vault Button -->
        <button
          type="button"
          id="btnOpenResetMemoryModal"
          class="btn btn-danger btn-sm rounded-lg"
          title="Reset and clear all records in your personal memory vault"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
          <span>Reset Vault</span>
        </button>
      </div>
    </div>

    <!-- 2. SUMMARY METRICS STRIP -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 sm:gap-4">
      <!-- Metric 1: Identity & Contact -->
      <div class="p-4 sm:p-5 rounded-xl bg-[#191D1A] border border-[#2B312C] flex items-center justify-between">
        <div>
          <span class="text-[11px] font-semibold text-[#A1AAA1] uppercase tracking-wider block">Identity &amp; Contact</span>
          <span id="metricIdentityCount" class="text-2xl font-bold text-[#FFFFFF] mt-0.5 block">--</span>
          <span class="text-[10px] text-[#5E665E]">Legal Name, Phone, CNIC</span>
        </div>
        <div class="size-9 rounded-lg bg-[#141715] border border-[#2B312C] text-[#B7F34A] flex items-center justify-center font-bold">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </div>
      </div>

      <!-- Metric 2: Education -->
      <div class="p-4 sm:p-5 rounded-xl bg-[#191D1A] border border-[#2B312C] flex items-center justify-between">
        <div>
          <span class="text-[11px] font-semibold text-[#A1AAA1] uppercase tracking-wider block">Education &amp; Degrees</span>
          <span id="metricEducationCount" class="text-2xl font-bold text-[#FFFFFF] mt-0.5 block">--</span>
          <span class="text-[10px] text-[#5E665E]">Degrees, Majors, Alma Mater</span>
        </div>
        <div class="size-9 rounded-lg bg-[#141715] border border-[#2B312C] text-[#B7F34A] flex items-center justify-center font-bold">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
        </div>
      </div>

      <!-- Metric 3: Experiences -->
      <div class="p-4 sm:p-5 rounded-xl bg-[#191D1A] border border-[#2B312C] flex items-center justify-between">
        <div>
          <span class="text-[11px] font-semibold text-[#A1AAA1] uppercase tracking-wider block">Career Milestones</span>
          <span id="metricExperienceCount" class="text-2xl font-bold text-[#FFFFFF] mt-0.5 block">--</span>
          <span class="text-[10px] text-[#5E665E]">Roles, Companies, Skills</span>
        </div>
        <div class="size-9 rounded-lg bg-[#141715] border border-[#2B312C] text-[#B7F34A] flex items-center justify-center font-bold">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
        </div>
      </div>

      <!-- Metric 4: Custom Q&A -->
      <div class="p-4 sm:p-5 rounded-xl bg-[#191D1A] border border-[#2B312C] flex items-center justify-between">
        <div>
          <span class="text-[11px] font-semibold text-[#A1AAA1] uppercase tracking-wider block">Custom Q&amp;A Attributes</span>
          <span id="metricCustomCount" class="text-2xl font-bold text-[#FFFFFF] mt-0.5 block">--</span>
          <span class="text-[10px] text-[#5E665E]">Learned &amp; Manual Answers</span>
        </div>
        <div class="size-9 rounded-lg bg-[#141715] border border-[#2B312C] text-[#B7F34A] flex items-center justify-center font-bold">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
        </div>
      </div>
    </div>

    <!-- 3. CATEGORY TABS & SEARCH CONTROLS -->
    <div class="flex flex-col gap-3.5">
      <!-- Search Input -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="relative flex-1 max-w-md">
          <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 size-4 text-[#A1AAA1] pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input
            type="text"
            id="memorySearchInput"
            placeholder="Search by label, value, or memory key..."
            class="w-full bg-[#141715] border border-[#2B312C] rounded-xl pl-10 pr-4 py-2 text-xs text-[#FFFFFF] placeholder:text-[#5E665E] focus:border-[#B7F34A] focus:outline-none transition"
          />
        </div>

        <div class="text-xs text-[#A1AAA1] flex items-center gap-1.5">
          <span>Active View:</span>
          <span id="activeViewLabel" class="font-semibold text-[#FFFFFF]">All Records</span>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div id="categoryTabsBar" class="flex items-center gap-1 overflow-x-auto pb-1 border-b border-[#2B312C] text-xs font-medium">
        <button type="button" class="tab-item py-2 px-3 rounded-lg border-b-2 border-[#B7F34A] text-[#B7F34A] bg-[#141715] transition cursor-pointer" data-tab="all">
          All Records (<span id="tabCountAll">0</span>)
        </button>
        <button type="button" class="tab-item py-2 px-3 rounded-lg border-b-2 border-transparent text-[#A1AAA1] hover:text-[#FFFFFF] transition cursor-pointer" data-tab="identity">
          Identity &amp; Contact (<span id="tabCountIdentity">0</span>)
        </button>
        <button type="button" class="tab-item py-2 px-3 rounded-lg border-b-2 border-transparent text-[#A1AAA1] hover:text-[#FFFFFF] transition cursor-pointer" data-tab="education">
          Education (<span id="tabCountEducation">0</span>)
        </button>
        <button type="button" class="tab-item py-2 px-3 rounded-lg border-b-2 border-transparent text-[#A1AAA1] hover:text-[#FFFFFF] transition cursor-pointer" data-tab="experience">
          Experiences (<span id="tabCountExperience">0</span>)
        </button>
        <button type="button" class="tab-item py-2 px-3 rounded-lg border-b-2 border-transparent text-[#A1AAA1] hover:text-[#FFFFFF] transition cursor-pointer" data-tab="custom">
          Custom Q&amp;A (<span id="tabCountCustom">0</span>)
        </button>
        <button type="button" class="tab-item py-2 px-3 rounded-lg border-b-2 border-transparent text-[#A1AAA1] hover:text-[#FFFFFF] transition cursor-pointer" data-tab="chat">
          AI Copilot Assistant
        </button>
        <button type="button" class="tab-item py-2 px-3 rounded-lg border-b-2 border-transparent text-[#A1AAA1] hover:text-[#FFFFFF] transition cursor-pointer" data-tab="documents">
          Documents (<span id="tabCountDocs">0</span>)
        </button>
      </div>
    </div>

    <!-- 4. MAIN CONTENT CONTAINER -->
    <!-- View A: Structured Memory Table / Cards Grid -->
    <div id="memoryViewContainer" class="space-y-4">
      <div id="memoryItemsList" class="space-y-2.5">
        <div class="py-14 text-center text-[#A1AAA1] bg-[#191D1A] border border-[#2B312C] rounded-2xl p-6">
          <div class="inline-block size-5 border-2 border-[#B7F34A] border-t-transparent rounded-full animate-spin mb-2"></div>
          <div class="text-xs">Analyzing and loading personal memory records...</div>
        </div>
      </div>

      <!-- Direct Edit/Add Updated JSON Output Container -->
      <div id="vaultUpdatedJsonBox" class="hidden p-5 rounded-xl bg-[#141715] border border-[#2B312C] shadow-lg space-y-3 transition-all">
        <div class="flex items-center justify-between pb-2 border-b border-[#2B312C]">
          <div class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-[#B7F34A] animate-pulse"></span>
            <span class="text-xs font-semibold text-[#B7F34A] uppercase tracking-wider">
              Updated Memory Record (JSON Payload)
            </span>
            <span id="vaultUpdatedBadge" class="text-[10px] font-semibold px-2 py-0.5 rounded-md bg-[#B7F34A]/10 text-[#B7F34A] border border-[#B7F34A]/20 flex items-center gap-1">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Updated</span>
            </span>
          </div>
          <button
            type="button"
            id="btnCopyVaultJson"
            class="px-2.5 py-1 rounded-lg bg-[#191D1A] hover:bg-[#222723] text-[#A1AAA1] hover:text-[#FFFFFF] text-xs font-mono transition flex items-center gap-1.5 border border-[#2B312C] cursor-pointer"
            title="Copy JSON to clipboard"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span id="copyVaultJsonText">Copy JSON</span>
          </button>
        </div>
        <pre class="bg-[#0B0D0C] p-4 rounded-lg border border-[#2B312C] overflow-x-auto text-[11px] font-mono text-[#B7F34A] leading-relaxed select-all max-h-60"><code id="vaultUpdatedJsonCode">{}</code></pre>
      </div>
    </div>

    <!-- View B: Integrated AI Memory Chat Assistant (Interactive AI Memory Copilot) -->
    <div id="chatAssistantContainer" class="hidden space-y-6">
      <div class="bg-[#191D1A] border border-[#2B312C] rounded-2xl p-6 sm:p-8 shadow-sm space-y-5">
        <!-- Copilot Top Header Strip -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#2B312C]">
          <div class="flex items-center gap-3">
            <div class="size-10 rounded-xl bg-[#B7F34A] text-[#0B0D0C] flex items-center justify-center font-bold shadow-[0_0_15px_rgba(183,243,74,0.3)] shrink-0">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a10 10 0 1 0 10 10H12V2z"></path>
                <circle cx="12" cy="12" r="3" fill="currentColor"></circle>
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h2 class="text-base font-bold font-display text-[#FFFFFF]">AI Memory Copilot</h2>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono font-medium bg-[#B7F34A]/10 text-[#B7F34A] border border-[#B7F34A]/30">
                  <span class="size-1.5 rounded-full bg-[#B7F34A] animate-pulse"></span>
                  Vault Connected
                </span>
              </div>
              <p class="text-xs text-[#A1AAA1]">
                Query stored education, career, and contact facts or instruct real-time memory updates.
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              id="btnResetMemCopilotChat"
              class="px-3 py-1.5 text-xs text-[#A1AAA1] hover:text-white bg-[#141715] hover:bg-[#2B312C] border border-[#2B312C] rounded-lg transition cursor-pointer flex items-center gap-1.5"
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
                <path d="M21 3v5h-5"></path>
                <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
                <path d="M3 21v-5h5"></path>
              </svg>
              <span>Clear Chat</span>
            </button>
          </div>
        </div>

        <!-- Quick Prompt Chips -->
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-[#5E665E] block mb-2 font-mono">Suggested Questions &amp; Commands</span>
          <div class="flex flex-wrap gap-2" id="memCopilotChipContainer">
            <button type="button" class="mem-copilot-chip px-3 py-1.5 rounded-lg bg-[#141715] hover:bg-[#2B312C] border border-[#2B312C] hover:border-[#B7F34A]/50 text-xs text-[#A1AAA1] hover:text-white transition cursor-pointer flex items-center gap-1.5" data-prompt="What are my educational experiences?">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
              <span>What are my educational experiences?</span>
            </button>
            <button type="button" class="mem-copilot-chip px-3 py-1.5 rounded-lg bg-[#141715] hover:bg-[#2B312C] border border-[#2B312C] hover:border-[#B7F34A]/50 text-xs text-[#A1AAA1] hover:text-white transition cursor-pointer flex items-center gap-1.5" data-prompt="What contact details are in my vault?">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <span>What contact details are saved?</span>
            </button>
            <button type="button" class="mem-copilot-chip px-3 py-1.5 rounded-lg bg-[#141715] hover:bg-[#2B312C] border border-[#2B312C] hover:border-[#B7F34A]/50 text-xs text-[#A1AAA1] hover:text-white transition cursor-pointer flex items-center gap-1.5" data-prompt="What technical skills do I have?">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
              <span>What technical skills are stored?</span>
            </button>
            <button type="button" class="mem-copilot-chip px-3 py-1.5 rounded-lg bg-[#141715] hover:bg-[#2B312C] border border-[#2B312C] hover:border-[#B7F34A]/50 text-xs text-[#A1AAA1] hover:text-white transition cursor-pointer flex items-center gap-1.5" data-prompt="Update my name to Muazam Ali Sarwar">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
              <span>Update my legal name</span>
            </button>
            <button type="button" class="mem-copilot-chip px-3 py-1.5 rounded-lg bg-[#141715] hover:bg-[#2B312C] border border-[#2B312C] hover:border-[#B7F34A]/50 text-xs text-[#A1AAA1] hover:text-white transition cursor-pointer flex items-center gap-1.5" data-prompt="Change my phone number to 0326-8848703">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
              <span>Update my phone number</span>
            </button>
          </div>
        </div>

        <!-- Chat Messages Feed -->
        <div
          id="memCopilotChatFeed"
          class="h-[380px] overflow-y-auto space-y-4 p-4 rounded-xl bg-[#141715] border border-[#2B312C] scroll-smooth"
        >
          <!-- Messages dynamically populated -->
        </div>

        <!-- Chat Input Form Composer -->
        <form id="memCopilotChatForm" class="space-y-2.5">
          <div class="relative flex items-center">
            <input
              type="text"
              id="memCopilotChatInput"
              placeholder="Ask about your memory or command an update (e.g. 'What are my educational experiences?' or 'Update my name to...')..."
              autocomplete="off"
              class="w-full bg-[#141715] border border-[#2B312C] rounded-xl pl-4 pr-12 py-3 text-xs text-[#FFFFFF] placeholder:text-[#5E665E] focus:border-[#B7F34A] focus:outline-none transition shadow-inner"
            />
            <button
              type="button"
              id="memCopilotSendBtn"
              class="absolute right-2 top-1/2 -translate-y-1/2 p-2 rounded-lg bg-[#B7F34A] text-[#0B0D0C] hover:bg-[#c9f66d] transition cursor-pointer shadow-[0_0_10px_rgba(183,243,74,0.3)] disabled:opacity-40 disabled:cursor-not-allowed"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
          </div>

          <div class="flex items-center justify-between text-[11px] text-[#5E665E] px-1">
            <span>Press <kbd class="px-1.5 py-0.5 rounded bg-[#191D1A] border border-[#2B312C] font-mono text-[10px] text-[#A1AAA1]">Enter</kbd> to send. Live grounded reasoning with multi-provider AI support.</span>
            <div id="memCopilotTypingStatus" class="hidden items-center gap-1.5 text-[#B7F34A] font-medium">
              <span class="size-1.5 rounded-full bg-[#B7F34A] animate-ping"></span>
              <span>Thinking &amp; querying vault...</span>
            </div>
          </div>
        </form>

        <!-- Fast Raw Text Parser Fallback / Expandable Ingestion Option -->
        <div class="pt-4 border-t border-[#2B312C]/60">
          <details class="group">
            <summary class="flex items-center justify-between text-xs text-[#A1AAA1] hover:text-[#FFFFFF] cursor-pointer py-1 font-medium transition select-none">
              <span class="flex items-center gap-1.5">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                <span>Advanced: Raw Text Batch Ingestion &amp; Attribute Parser</span>
              </span>
              <svg class="size-4 transition-transform group-open:rotate-180 text-[#5E665E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>

            <div class="mt-3 space-y-3 pt-2">
              <textarea
                id="aiMemoryChatInput"
                rows="3"
                placeholder="Paste unformatted career notes, bio, or test scores to parse attributes in batch..."
                class="w-full bg-[#141715] border border-[#2B312C] rounded-xl p-3 text-xs text-[#FFFFFF] placeholder:text-[#5E665E] focus:border-[#B7F34A] focus:outline-none transition leading-relaxed resize-none"
              ></textarea>
              <div class="flex items-center justify-between">
                <span class="text-[11px] text-[#5E665E] italic">Batch parser recognizes fields and lets you preview before saving.</span>
                <button
                  type="button"
                  id="btnAiExtractChat"
                  class="btn btn-outline btn-sm rounded-lg"
                >
                  <span id="btnAiExtractChatText">Parse &amp; Preview</span>
                </button>
              </div>
            </div>
          </details>
        </div>
      </div>

      <!-- Extracted Memory Review Box -->
      <div id="aiChatPreviewBox" class="hidden p-5 rounded-xl bg-[#141715] border border-[#2B312C] space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-[#FFFFFF] uppercase tracking-wider flex items-center gap-1.5">
            <span class="size-2 rounded-full bg-[#B7F34A]"></span>
            Recognized Memory Attributes
          </span>
          <span class="text-[11px] text-[#A1AAA1]">Review before saving to vault</span>
        </div>

        <div id="aiChatPreviewItems" class="space-y-2">
          <!-- Rendered dynamically -->
        </div>

        <div class="pt-3 border-t border-[#2B312C] flex justify-end gap-2.5">
          <button type="button" id="btnCancelChatPreview" class="btn btn-outline btn-sm rounded-lg">Discard</button>
          <button type="button" id="btnCommitChatPreview" class="btn btn-primary btn-sm rounded-lg flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span id="btnCommitChatPreviewText">Confirm &amp; Save to Vault</span>
          </button>
        </div>
      </div>

      <!-- Updated Attributes JSON Output Container -->
      <div id="aiChatUpdatedJsonBox" class="hidden p-5 rounded-xl bg-[#141715] border border-[#2B312C] shadow-lg space-y-3 transition-all">
        <div class="flex items-center justify-between pb-2 border-b border-[#2B312C]">
          <div class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-[#B7F34A] animate-pulse"></span>
            <span class="text-xs font-semibold text-[#B7F34A] uppercase tracking-wider">
              Updated Memory Attributes (JSON Output)
            </span>
            <span id="aiChatUpdatedBadge" class="text-[10px] font-semibold px-2 py-0.5 rounded-md bg-[#B7F34A]/10 text-[#B7F34A] border border-[#B7F34A]/20 flex items-center gap-1">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Saved to Vault</span>
            </span>
          </div>
          <button
            type="button"
            id="btnCopyUpdatedJson"
            class="px-2.5 py-1 rounded-lg bg-[#191D1A] hover:bg-[#222723] text-[#A1AAA1] hover:text-[#FFFFFF] text-xs font-mono transition flex items-center gap-1.5 border border-[#2B312C] cursor-pointer"
            title="Copy JSON to clipboard"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span id="copyUpdatedJsonText">Copy JSON</span>
          </button>
        </div>
        <p class="text-[11px] text-[#A1AAA1]">
          The following records were recognized and updated in your memory vault:
        </p>
        <pre class="bg-[#0B0D0C] p-4 rounded-lg border border-[#2B312C] overflow-x-auto text-[11px] font-mono text-[#B7F34A] leading-relaxed select-all max-h-72"><code id="aiChatUpdatedJsonCode">{}</code></pre>
      </div>
    </div>

    <!-- 5. Global Toast -->
    <div id="memoryToast" class="fixed bottom-6 right-6 z-50 hidden max-w-sm px-4 py-3 rounded-xl bg-[#191D1A] border border-[#2B312C] text-xs text-[#FFFFFF] shadow-2xl flex items-center gap-2"></div>
  </div>

  <!-- Modal 1: Add Custom Attribute -->
  <div id="addCustomModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-xs" role="dialog" aria-modal="true">
    <div class="relative w-full max-w-md bg-[#191D1A] border border-[#2B312C] rounded-2xl p-6 sm:p-7 shadow-2xl">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#2B312C]">
        <h3 class="text-base font-bold font-display text-[#FFFFFF]">Add Memory Attribute</h3>
        <button type="button" id="closeAddModalBtn" class="text-[#A1AAA1] hover:text-[#FFFFFF] text-xl leading-none cursor-pointer">&times;</button>

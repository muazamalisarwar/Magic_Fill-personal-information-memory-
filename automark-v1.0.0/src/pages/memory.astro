          </div>
        </div>

        <div id="addModalError" class="hidden text-xs text-rose-300 bg-rose-950/40 p-2.5 rounded-xl border border-rose-900/40"></div>

        <div class="flex justify-end gap-2 pt-3 border-t border-[#2B312C]">
          <button type="button" id="cancelAddBtn" class="btn btn-outline btn-sm rounded-lg">Cancel</button>
          <button type="submit" id="submitAddBtn" class="btn btn-primary btn-sm rounded-lg">Save to Vault</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal 2: Edit Attribute Value -->
  <div id="editAttributeModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-xs" role="dialog" aria-modal="true">
    <div class="relative w-full max-w-md bg-[#191D1A] border border-[#2B312C] rounded-2xl p-6 sm:p-7 shadow-2xl">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#2B312C]">
        <h3 id="editModalTitle" class="text-base font-bold font-display text-[#FFFFFF]">Edit Memory Attribute</h3>
        <button type="button" id="closeEditModalBtn" class="text-[#A1AAA1] hover:text-[#FFFFFF] text-xl leading-none cursor-pointer">&times;</button>
      </div>

      <form id="editAttributeForm" class="space-y-4" onsubmit="return false;">
        <input type="hidden" id="editItemType" />
        <input type="hidden" id="editItemId" />
        <input type="hidden" id="editItemKey" />

        <div>
          <label class="block text-xs font-semibold text-[#A1AAA1] mb-1">Field Label</label>
          <input type="text" id="editItemLabel" readonly class="w-full bg-[#141715] border border-[#2B312C] rounded-xl px-3.5 py-2 text-xs text-[#A1AAA1] cursor-not-allowed" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#A1AAA1] mb-1">Canonical Stored Value</label>
          <textarea id="editItemValue" rows="4" required class="w-full bg-[#141715] border border-[#2B312C] rounded-xl px-3.5 py-2 text-xs text-[#FFFFFF] focus:border-[#B7F34A] focus:outline-none leading-relaxed"></textarea>
        </div>

        <div id="editModalError" class="hidden text-xs text-rose-300 bg-rose-950/40 p-2.5 rounded-xl border border-rose-900/40"></div>

        <div class="flex items-center justify-between gap-2 pt-3 border-t border-[#2B312C]">
          <button type="button" id="deleteFromEditModalBtn" class="px-3 py-1.5 rounded-lg bg-rose-950/20 hover:bg-rose-950/40 text-rose-400 border border-rose-900/30 text-xs font-semibold transition cursor-pointer flex items-center gap-1.5" title="Delete this field from vault">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            <span>Delete Field</span>
          </button>
          <div class="flex items-center gap-2">
            <button type="button" id="cancelEditBtn" class="btn btn-outline btn-sm rounded-lg">Cancel</button>
            <button type="submit" id="submitEditBtn" class="btn btn-primary btn-sm rounded-lg">Update Record</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal 3: Reset Entire Memory Vault Confirmation -->
  <div id="resetVaultModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/85 backdrop-blur-xs" role="dialog" aria-modal="true">
    <div class="relative w-full max-w-md bg-[#191D1A] border border-rose-500/30 rounded-2xl p-6 sm:p-7 shadow-2xl">
      <div class="size-11 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center mx-auto mb-3 border border-rose-500/20">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>

      <h3 class="text-lg font-bold font-display text-[#FFFFFF] text-center mb-1.5">Reset Entire Memory Vault?</h3>
      <p class="text-xs text-[#A1AAA1] text-center leading-relaxed mb-4">
        This will permanently erase all your stored personal records, education, career history, custom memory fields, and uploaded identity documents &amp; photos.
      </p>

      <div class="p-2.5 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-xs mb-5 text-center font-medium flex items-center justify-center gap-2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span>This action cannot be undone. All autofill memory will be wiped.</span>
      </div>

      <div class="flex items-center gap-2.5">
        <button
          type="button"
          id="btnCancelResetVault"
          class="btn btn-outline btn-sm rounded-lg flex-1"
        >
          Cancel
        </button>
        <button
          type="button"
          id="btnConfirmResetVault"
          class="btn btn-danger btn-sm rounded-lg flex-1"
        >
          Yes, Reset Everything
        </button>
      </div>
    </div>
  </div>

  <!-- Client-side Vault Controller -->
  <script is:inline>
    function initVault() {
      const token = localStorage.getItem("magic_fill_token");
      if (!token) {
        window.location.href = "/login?redirect=/memory";
        return;
      }

      function escapeHtml(str) {
        if (str == null) return "";
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      let activeCategory = "all";
      let searchQuery = "";
      let memoryStore = [];
      let pendingChatExtracts = null;

      function showToast(msg, isSuccess = true) {
        const t = document.getElementById("memoryToast");
        if (!t) return;
        const icon = isSuccess
          ? `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0"><polyline points="20 6 9 17 4 12"/></svg>`
          : `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>`;
        t.innerHTML = `<div class="flex items-center gap-2">${icon}<span>${escapeHtml(msg)}</span></div>`;
        t.className = `fixed bottom-6 right-6 z-50 max-w-sm px-4 py-3 rounded-xl text-xs font-semibold shadow-2xl border ${
          isSuccess ? "bg-[#141715] text-[#B7F34A] border-[#B7F34A]/30" : "bg-rose-950 text-rose-300 border-rose-900/40"
        }`;
        t.classList.remove("hidden");
        setTimeout(() => t.classList.add("hidden"), 3500);
      }

      // Load Vault Data from Secure Vault
      async function loadVault() {
        const container = document.getElementById("memoryItemsList");
        try {
          const headers = { "Authorization": `Bearer ${token}` };
          const [profRes, expRes, cfRes, docRes] = await Promise.all([
            fetch("/api/personal-info/me", { headers }),
            fetch("/api/experiences/me", { headers }),
            fetch("/api/custom-fields/me", { headers }),
            fetch("/api/documents/me", { headers })
          ]);

          if (profRes.status === 401 || expRes.status === 401) {
            showToast("Your session has expired. Please sign in again.", false);
            localStorage.removeItem("magic_fill_token");
            localStorage.removeItem("magic_fill_user");
            setTimeout(() => {
              window.location.href = "/login?redirect=/memory";
            }, 1200);
            return;
          }

          const profData = profRes.ok ? (await profRes.json())?.data : null;
          const expData = expRes.ok ? (await expRes.json())?.data || [] : [];
          const cfData = cfRes.ok ? (await cfRes.json())?.data || [] : [];
          const docData = docRes.ok ? (await docRes.json())?.data || [] : [];

          memoryStore = [];

          // 1. Identity & Contact Records
          if (profData) {
            const piDef = [
              { key: "full_name", label: "Full Legal Name", cat: "identity" },
              { key: "email", label: "Primary Email Address", cat: "identity" },
              { key: "phone", label: "Phone Number", cat: "identity" },
              { key: "father_name", label: "Father / Guardian Name", cat: "identity" },
              { key: "gender", label: "Gender Identity", cat: "identity" },
              { key: "date_of_birth", label: "Date of Birth", cat: "identity" },
              { key: "cnic", label: "National ID / CNIC", cat: "identity" },
              { key: "address", label: "Street Address", cat: "identity" },
              { key: "city", label: "City", cat: "identity" },
              { key: "country", label: "Country of Residence", cat: "identity" },
              { key: "postal_code", label: "Postal / ZIP Code", cat: "identity" },
              { key: "linkedin_url", label: "LinkedIn Profile URL", cat: "identity" },
              { key: "github_url", label: "GitHub Profile URL", cat: "identity" },
              { key: "bio", label: "Professional Bio / Summary", cat: "experience" },
              { key: "university", label: "University / Institution", cat: "education" },
              { key: "degree", label: "Degree Program", cat: "education" },
              { key: "major", label: "Field of Study / Major", cat: "education" },
              { key: "graduation_year", label: "Graduation Year", cat: "education" }
            ];

            piDef.forEach(item => {
              const val = profData[item.key];
              if (val) {
                memoryStore.push({
                  type: "personal_info",
                  id: profData.id,
                  key: item.key,
                  label: item.label,
                  val: String(val),
                  cat: item.cat,
                  src: "Verified Profile",
                  date: profData.updated_at || profData.created_at
                });
              }
            });
          }

          // 2. Career Experiences
          expData.forEach(exp => {
            memoryStore.push({
              type: "experience",
              id: exp.id,
              key: `experience_${exp.id}`,
              label: `${exp.job_title} @ ${exp.company}`,
              val: `${exp.start_date || ""} to ${exp.end_date || "Present"}${exp.skills ? " | Skills: " + exp.skills : ""}${exp.description ? "\n" + exp.description : ""}`,
              cat: "experience",
              src: "Career Vault",
              date: exp.updated_at || exp.created_at
            });
          });

          // 3. Custom Fields
          cfData.forEach(cf => {
            memoryStore.push({
              type: "custom_field",
              id: cf.id,
              key: cf.field_key,
              label: cf.field_label,
              val: String(cf.field_value),
              cat: "custom",
              subcat: cf.category || "General",
              src: "Learned / Manual",
              date: cf.updated_at || cf.created_at
            });
          });

          // 4. Documents
          docData.forEach(doc => {
            memoryStore.push({
              type: "document",
              id: doc.id,
              key: doc.doc_key,
              label: doc.title || doc.file_name,
              val: `${doc.file_name} (${(doc.file_size_bytes / 1024).toFixed(1)} KB) - ${doc.description || "Stored Document"}`,
              cat: "documents",
              src: "Document Vault",
              date: doc.created_at
            });
          });

          updateMetricCounters();
          renderMemoryItems();
        } catch (e) {
          console.error("Vault loading error:", e);
          if (container) {
            container.innerHTML = `
              <div class="py-12 text-center text-[#A1AAA1] bg-[#191D1A] border border-rose-900/30 rounded-2xl p-6">
                <div class="size-10 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center mx-auto mb-3">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                </div>
                <h4 class="text-sm font-bold text-[#FFFFFF] mb-1">Backend Connection Error</h4>
                <p class="text-xs text-[#A1AAA1] max-w-sm mx-auto mb-4">
                  Could not connect to the Magic Fill API server. Please verify the backend is running.
                </p>
                <button type="button" id="btnRetryVault" class="btn btn-primary btn-sm rounded-lg">
                  Retry Connection
                </button>
              </div>
            `;
            const retryBtn = document.getElementById("btnRetryVault");
            if (retryBtn) retryBtn.addEventListener("click", loadVault);
          }
        }
      }

      function updateMetricCounters() {
        const idCount = memoryStore.filter(m => m.cat === "identity").length;
        const eduCount = memoryStore.filter(m => m.cat === "education").length;
        const expCount = memoryStore.filter(m => m.cat === "experience").length;
        const cfCount = memoryStore.filter(m => m.cat === "custom").length;
        const docCount = memoryStore.filter(m => m.cat === "documents").length;

        document.getElementById("metricIdentityCount").textContent = idCount;
        document.getElementById("metricEducationCount").textContent = eduCount;
        document.getElementById("metricExperienceCount").textContent = expCount;
        document.getElementById("metricCustomCount").textContent = cfCount;

        document.getElementById("tabCountAll").textContent = memoryStore.length;
        document.getElementById("tabCountIdentity").textContent = idCount;
        document.getElementById("tabCountEducation").textContent = eduCount;
        document.getElementById("tabCountExperience").textContent = expCount;
        document.getElementById("tabCountCustom").textContent = cfCount;
        document.getElementById("tabCountDocs").textContent = docCount;
      }

      function renderMemoryItems() {
        const container = document.getElementById("memoryItemsList");
        if (!container) return;

        let filtered = memoryStore;

        if (activeCategory !== "all") {
          filtered = filtered.filter(item => item.cat === activeCategory);
        }

        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          filtered = filtered.filter(item =>
            item.label.toLowerCase().includes(q) ||
            item.val.toLowerCase().includes(q) ||
            item.key.toLowerCase().includes(q)
          );
        }

        if (filtered.length === 0) {
          container.innerHTML = `
            <div class="py-14 text-center text-[#A1AAA1] bg-[#191D1A] border border-[#2B312C] rounded-2xl p-6">
              <div class="size-10 rounded-xl bg-[#141715] border border-[#2B312C] text-[#A1AAA1] flex items-center justify-center mx-auto mb-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              </div>
              <h4 class="text-sm font-bold text-[#FFFFFF] mb-1">No matching memory attributes found</h4>
              <p class="text-xs text-[#A1AAA1] max-w-sm mx-auto mb-4">
                ${searchQuery ? "Try a different search keyword or clear the search filter." : "Click '+ Add Custom Field' or switch to the AI Copilot tab to add information."}
              </p>
            </div>
          `;
          return;
        }

        container.innerHTML = filtered.map(item => `
          <div class="p-4 rounded-xl bg-[#191D1A] border border-[#2B312C] hover:border-[#3A423C] transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
            <div class="min-w-0 flex-1 space-y-1">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xs font-bold text-[#FFFFFF]">${item.label}</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#141715] text-[#B7F34A] border border-[#2B312C]">${item.key}</span>
                <span class="text-[10px] font-semibold px-2 py-0.5 rounded-md ${
                  item.src.includes("Verified") ? "bg-[#B7F34A]/10 text-[#B7F34A] border border-[#B7F34A]/20" : "bg-[#141715] text-[#A1AAA1] border border-[#2B312C]"
                }">${item.src}</span>
              </div>
              <p class="text-xs text-[#A1AAA1] whitespace-pre-wrap leading-relaxed select-all">${item.val}</p>
            </div>

            <div class="flex items-center gap-1.5 shrink-0 self-end sm:self-center">
              <button
                type="button"
                class="btn-copy p-2 rounded-lg bg-[#141715] hover:bg-[#222723] text-[#A1AAA1] hover:text-[#FFFFFF] border border-[#2B312C] transition cursor-pointer"
                data-val="${item.val.replace(/"/g, '&quot;')}"
                title="Copy value"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              </button>

              <button
                type="button"
                class="btn-edit px-2.5 py-1.5 rounded-lg bg-[#141715] hover:bg-[#222723] text-xs font-semibold text-[#FFFFFF] border border-[#2B312C] transition cursor-pointer flex items-center gap-1"
                data-type="${item.type}"
                data-id="${item.id}"
                data-key="${item.key}"
                data-label="${item.label.replace(/"/g, '&quot;')}"
                data-val="${item.val.replace(/"/g, '&quot;')}"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                <span>Edit</span>
              </button>

              <button
                type="button"
                class="btn-delete p-2 rounded-lg bg-rose-950/20 hover:bg-rose-950/40 text-rose-400 border border-rose-900/30 transition cursor-pointer"
                data-type="${item.type}"
                data-id="${item.id}"
                data-key="${item.key}"
                data-label="${item.label.replace(/"/g, '&quot;')}"
                title="Delete this field from memory"
                aria-label="Delete ${item.label.replace(/"/g, '&quot;')}"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              </button>
            </div>
          </div>
        `).join("");

        // Bind Copy Buttons
        container.querySelectorAll(".btn-copy").forEach(btn => {
          btn.addEventListener("click", () => {
            const val = btn.getAttribute("data-val");
            if (val) {
              navigator.clipboard.writeText(val);
              showToast("Copied to clipboard!");
            }
          });
        });

        // Bind Edit Buttons
        container.querySelectorAll(".btn-edit").forEach(btn => {
          btn.addEventListener("click", () => {
            openEditModal({
              type: btn.getAttribute("data-type"),
              id: btn.getAttribute("data-id"),
              key: btn.getAttribute("data-key"),
              label: btn.getAttribute("data-label"),
              val: btn.getAttribute("data-val")
            });
          });
        });

        // Bind Delete Buttons
        container.querySelectorAll(".btn-delete").forEach(btn => {
          btn.addEventListener("click", async () => {
            const type = btn.getAttribute("data-type");
            const id = btn.getAttribute("data-id");
            const key = btn.getAttribute("data-key");
            const label = btn.getAttribute("data-label");
            await deleteMemoryAttribute(type, id, key, label);
          });
        });
      }

      async function deleteMemoryAttribute(type, id, key, label) {
        if (!confirm(`Are you sure you want to delete "${label}" from your personal memory vault?`)) {
          return false;
        }
        try {
          let res;
          const headers = { 
            "Authorization": `Bearer ${token}`,
            "Content-Type": "application/json"
          };

          if (type === "custom_field") {
            res = await fetch(`/api/custom-fields/${id}`, { method: "DELETE", headers });
          } else if (type === "experience") {
            res = await fetch(`/api/experiences/${id}`, { method: "DELETE", headers });
          } else if (type === "document") {
            res = await fetch(`/api/documents/${id}`, { method: "DELETE", headers });
          } else if (type === "personal_info") {
            res = await fetch(`/api/personal-info/me/fields/${key}`, { method: "DELETE", headers });
            if (!res || !res.ok) {
              res = await fetch(`/api/users/1/personal-info/fields/${key}`, { method: "DELETE", headers });
            }
            if (!res || !res.ok) {
              res = await fetch(`/api/personal-info/me`, {
                method: "PUT",
                headers,
                body: JSON.stringify({ [key]: null })
              });
            }
          }

          if (res && res.ok) {
            showToast(`Deleted "${label}" successfully!`);
            closeEditModal();
            loadVault();
            return true;
          } else {
            showToast(`Failed to delete "${label}".`, false);
            return false;
          }
        } catch (e) {
          showToast("Network error deleting attribute.", false);
          return false;
        }
      }

      // Tab Switching
      const tabItems = document.querySelectorAll(".tab-item");
      const memoryView = document.getElementById("memoryViewContainer");
      const chatView = document.getElementById("chatAssistantContainer");
      const activeLabel = document.getElementById("activeViewLabel");

      tabItems.forEach(btn => {
        btn.addEventListener("click", () => {
          tabItems.forEach(b => {
            b.classList.remove("border-[#B7F34A]", "text-[#B7F34A]", "bg-[#141715]");
            b.classList.add("border-transparent", "text-[#A1AAA1]");
          });
          btn.classList.add("border-[#B7F34A]", "text-[#B7F34A]", "bg-[#141715]");
          btn.classList.remove("border-transparent", "text-[#A1AAA1]");

          const tab = btn.getAttribute("data-tab");
          activeCategory = tab;

          if (tab === "chat") {
            memoryView.classList.add("hidden");
            chatView.classList.remove("hidden");
            activeLabel.textContent = "AI Copilot Assistant";
          } else {
            chatView.classList.add("hidden");
            memoryView.classList.remove("hidden");
            activeLabel.textContent = btn.textContent.trim();
            renderMemoryItems();
          }
        });
      });

      // Live Search Filter
      const searchInput = document.getElementById("memorySearchInput");
      if (searchInput) {
        searchInput.addEventListener("input", (e) => {
          searchQuery = e.target.value.trim();
          renderMemoryItems();
        });
      }

      // Add Custom Attribute Modal Logic
      const addModal = document.getElementById("addCustomModal");
      const btnOpenAdd = document.getElementById("btnOpenAddModal");
      const closeAddBtn = document.getElementById("closeAddModalBtn");
      const cancelAddBtn = document.getElementById("cancelAddBtn");
      const addForm = document.getElementById("addCustomForm");
      const addError = document.getElementById("addModalError");

      function openAddModal() {
        if (addError) addError.classList.add("hidden");
        if (addForm) addForm.reset();
        if (addModal) {
          addModal.classList.remove("hidden");
          addModal.classList.add("flex");
        }
      }

      function closeAddModal() {
        if (addModal) {
          addModal.classList.add("hidden");
          addModal.classList.remove("flex");
        }
      }

      if (btnOpenAdd) btnOpenAdd.addEventListener("click", openAddModal);
      if (closeAddBtn) closeAddBtn.addEventListener("click", closeAddModal);
      if (cancelAddBtn) cancelAddBtn.addEventListener("click", closeAddModal);

      if (addForm) {
        addForm.addEventListener("submit", async () => {
          const label = document.getElementById("addAttrLabel").value.trim();
          const value = document.getElementById("addAttrValue").value.trim();
          const category = document.getElementById("addAttrCategory").value;
          let key = document.getElementById("addAttrKey").value.trim();

          if (!key) {
            key = label.toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "");
          }

          if (!label || !value) {
            addError.textContent = "Label and value are required.";
            addError.classList.remove("hidden");
            return;
          }

          try {
            const res = await fetch("/api/custom-fields/me", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Authorization": `Bearer ${token}`
              },
              body: JSON.stringify({
                field_key: key,
                field_label: label,
                field_value: value,
                category: category
              })
            });

            const data = await res.json();
            if (res.ok && data.success) {
              closeAddModal();
              showToast(`Added "${label}" to memory vault!`);
              displayVaultUpdatedJson({ field_key: key, field_label: label, field_value: value, category: category }, "Custom Attribute Added");
              loadVault();
            } else {
              addError.textContent = data.message || "Failed to create custom attribute.";
              addError.classList.remove("hidden");
            }
          } catch (e) {
            addError.textContent = "Network error connecting to server.";
            addError.classList.remove("hidden");
          }
        });
      }

      // Edit Attribute Modal Logic
      const editModal = document.getElementById("editAttributeModal");
      const closeEditBtn = document.getElementById("closeEditModalBtn");
      const cancelEditBtn = document.getElementById("cancelEditBtn");
      const editForm = document.getElementById("editAttributeForm");
      const editError = document.getElementById("editModalError");

      function openEditModal(item) {
        if (editError) editError.classList.add("hidden");
        document.getElementById("editItemType").value = item.type;
        document.getElementById("editItemId").value = item.id;
        document.getElementById("editItemKey").value = item.key;
        document.getElementById("editItemLabel").value = item.label;
        document.getElementById("editItemValue").value = item.val;

        if (editModal) {
          editModal.classList.remove("hidden");
          editModal.classList.add("flex");
        }
      }

      function closeEditModal() {
        if (editModal) {
          editModal.classList.add("hidden");
          editModal.classList.remove("flex");
        }
      }

      if (closeEditBtn) closeEditBtn.addEventListener("click", closeEditModal);
      if (cancelEditBtn) cancelEditBtn.addEventListener("click", closeEditModal);

      const deleteFromEditModalBtn = document.getElementById("deleteFromEditModalBtn");
      if (deleteFromEditModalBtn) {
        deleteFromEditModalBtn.addEventListener("click", async () => {
          const type = document.getElementById("editItemType").value;
          const id = document.getElementById("editItemId").value;
          const key = document.getElementById("editItemKey").value;
          const label = document.getElementById("editItemLabel").value;
          await deleteMemoryAttribute(type, id, key, label);
        });
      }

      if (editForm) {
        editForm.addEventListener("submit", async () => {
          const type = document.getElementById("editItemType").value;
          const id = document.getElementById("editItemId").value;
          const key = document.getElementById("editItemKey").value;
          const newVal = document.getElementById("editItemValue").value.trim();

          if (!newVal) {
            editError.textContent = "Value cannot be blank.";
            editError.classList.remove("hidden");
            return;
          }

          try {
            if (type === "personal_info") {
              const payload = {};
              payload[key] = newVal;
              const res = await fetch("/api/personal-info/me", {
                method: "PUT",
                headers: {
                  "Content-Type": "application/json",
                  "Authorization": `Bearer ${token}`
                },
                body: JSON.stringify(payload)
              });
              if (res.ok) {
                closeEditModal();
                showToast("Personal record updated successfully!");
                displayVaultUpdatedJson({ field: key, value: newVal, category: "identity" }, "Personal Record Updated");
                loadVault();
              } else {
                editError.textContent = "Failed to update record.";
                editError.classList.remove("hidden");
              }
            } else if (type === "custom_field") {
              const res = await fetch(`/api/custom-fields/${id}`, {
                method: "PUT",
                headers: {
                  "Content-Type": "application/json",
                  "Authorization": `Bearer ${token}`
                },
                body: JSON.stringify({ field_value: newVal })
              });
              if (res.ok) {
                closeEditModal();
                showToast("Custom attribute updated successfully!");
                displayVaultUpdatedJson({ field_id: id, field_key: key, field_value: newVal }, "Custom Attribute Updated");
                loadVault();
              } else {
                editError.textContent = "Failed to update attribute.";
                editError.classList.remove("hidden");
              }
            } else if (type === "experience") {
              const res = await fetch(`/api/experiences/${id}`, {
                method: "PUT",
                headers: {
                  "Content-Type": "application/json",
                  "Authorization": `Bearer ${token}`
                },
                body: JSON.stringify({ description: newVal })
              });
              if (res.ok) {
                closeEditModal();
                showToast("Experience updated successfully!");
                displayVaultUpdatedJson({ experience_id: id, description: newVal }, "Experience Updated");
                loadVault();
              } else {
                editError.textContent = "Failed to update experience.";
                editError.classList.remove("hidden");
              }
            } else {
              const res = await fetch("/api/memory/update", {
                method: "PUT",
                headers: {
                  "Content-Type": "application/json",
                  "Authorization": `Bearer ${token}`
                },
                body: JSON.stringify({
                  type: type,
                  id: id ? parseInt(id, 10) : undefined,
                  key: key,
                  value: newVal
                })
              });
              if (res.ok) {
                closeEditModal();
                showToast("Memory updated successfully!");
                displayVaultUpdatedJson({ type, key, value: newVal }, "Memory Record Updated");
                loadVault();
              } else {
                editError.textContent = "Failed to update record.";
                editError.classList.remove("hidden");
              }
            }
          } catch (e) {
            editError.textContent = "Network error updating memory.";
            editError.classList.remove("hidden");
          }
        });
      }

      // Backup JSON Export
      const exportBtn = document.getElementById("btnExportJsonVault");
      if (exportBtn) {
        exportBtn.addEventListener("click", () => {
          const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(memoryStore, null, 2));
          const dlAnchor = document.createElement("a");
          dlAnchor.setAttribute("href", dataStr);
          dlAnchor.setAttribute("download", `magic_fill_memory_vault_${new Date().toISOString().split("T")[0]}.json`);
          dlAnchor.click();
          dlAnchor.remove();
          showToast("Vault exported as JSON backup!");
        });
      }

      // Reset Memory Vault Controller
      const resetModal = document.getElementById("resetVaultModal");
      const openResetBtn = document.getElementById("btnOpenResetMemoryModal");
      const cancelResetBtn = document.getElementById("btnCancelResetVault");
      const confirmResetBtn = document.getElementById("btnConfirmResetVault");

      if (openResetBtn && resetModal) {
        openResetBtn.addEventListener("click", () => {
          resetModal.classList.remove("hidden");
          resetModal.classList.add("flex");
        });
      }

      if (cancelResetBtn && resetModal) {
        cancelResetBtn.addEventListener("click", () => {
          resetModal.classList.add("hidden");
          resetModal.classList.remove("flex");
        });
      }

      if (confirmResetBtn && resetModal) {
        confirmResetBtn.addEventListener("click", async () => {
          confirmResetBtn.disabled = true;
          confirmResetBtn.textContent = "Resetting Vault...";
          try {
            const res = await fetch("/api/memory/reset", {
              method: "POST",
              headers: { "Authorization": `Bearer ${token}` }
            });
            const data = await res.json();
            if (res.ok && data.success) {
              showToast("Personal memory vault has been reset to a clean state.");
              resetModal.classList.add("hidden");
              resetModal.classList.remove("flex");
              memoryStore = [];
              updateMetricCounters();
              renderMemoryItems();
            } else {
              showToast(data.message || "Failed to reset memory vault.", false);
            }
          } catch (e) {
            showToast("Network error while resetting vault.", false);
          } finally {
            confirmResetBtn.disabled = false;
            confirmResetBtn.textContent = "Yes, Reset Everything";
          }
        });
      }

      // -----------------------------------------------------------------------
      // Interactive AI Memory Copilot on /memory page
      // -----------------------------------------------------------------------
      let memCopilotChatHistory = [];
      try {
        const savedHist = sessionStorage.getItem("magic_fill_copilot_history");
        if (savedHist) {
          memCopilotChatHistory = JSON.parse(savedHist);
        }
      } catch (e) {
        memCopilotChatHistory = [];
      }
      const memCopilotChatFeed = document.getElementById("memCopilotChatFeed");
      const memCopilotChatForm = document.getElementById("memCopilotChatForm");
      const memCopilotChatInput = document.getElementById("memCopilotChatInput");
      const memCopilotSendBtn = document.getElementById("memCopilotSendBtn");
      const memCopilotTypingStatus = document.getElementById("memCopilotTypingStatus");
      const btnResetMemCopilotChat = document.getElementById("btnResetMemCopilotChat");

      function renderMemCopilotWelcome() {
        if (!memCopilotChatFeed) return;
        memCopilotChatFeed.innerHTML = `
          <div class="flex items-start gap-3 self-start max-w-[85%]">
            <div class="size-8 rounded-lg bg-[#B7F34A] text-[#0B0D0C] flex items-center justify-center font-bold text-xs shrink-0 shadow-[0_0_10px_rgba(183,243,74,0.3)]">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a10 10 0 1 0 10 10H12V2z"></path>
                <circle cx="12" cy="12" r="3" fill="currentColor"></circle>
              </svg>
            </div>
            <div class="p-3.5 rounded-2xl rounded-tl-sm bg-[#191D1A] border border-[#2B312C] text-xs text-[#FFFFFF] shadow-sm leading-relaxed space-y-2">
              <p>
                Hello! I am your <strong>AI Memory Copilot</strong>. I have real-time read and write access to your personal memory vault.
              </p>
              <p class="text-[#A1AAA1]">
                You can ask me questions about your stored records (e.g. <em>"What are my educational experiences?"</em> or <em>"What contact numbers do you have?"</em>), or command real-time updates directly (e.g. <em>"Update my name to Muazam Ali Sarwar"</em> or <em>"Add skill: React and Next.js"</em>).
              </p>
            </div>
          </div>
        `;
      }

      function restoreMemCopilotChat() {
        if (!memCopilotChatFeed) return;
        memCopilotChatFeed.innerHTML = "";
        renderMemCopilotWelcome();
        if (Array.isArray(memCopilotChatHistory) && memCopilotChatHistory.length > 0) {
          for (const msg of memCopilotChatHistory) {
            if (msg.role === "user") {
              appendMemUserMessage(msg.content);
            } else if (msg.role === "assistant") {
              appendMemAssistantMessage(msg.content, msg.updates || []);
            }
          }
        }
      }

      function appendMemUserMessage(text) {
        if (!memCopilotChatFeed) return;
        const bubble = document.createElement("div");
        bubble.className = "flex items-start justify-end gap-3 self-end max-w-[85%] ml-auto";
        bubble.innerHTML = `
          <div class="p-3.5 rounded-2xl rounded-tr-sm bg-[#141715] border border-[#2B312C] text-xs text-[#FFFFFF] shadow-sm leading-relaxed">
            ${escapeHtml(text)}
          </div>
        `;
        memCopilotChatFeed.appendChild(bubble);
        memCopilotChatFeed.scrollTop = memCopilotChatFeed.scrollHeight;
      }

      function appendMemAssistantMessage(replyText, updates = []) {
        if (!memCopilotChatFeed) return;
        const bubble = document.createElement("div");
        bubble.className = "flex items-start gap-3 self-start max-w-[85%]";

        let formattedText = escapeHtml(replyText)
          .replace(/\*\*(.*?)\*\*/g, '<strong class="text-white font-bold">$1</strong>')
          .replace(/\*(.*?)\*/g, '<em class="text-[#A1AAA1]">$1</em>')
          .replace(/`([^`]+)`/g, '<code class="px-1 py-0.5 rounded bg-[#141715] text-[#B7F34A] font-mono text-[11px]">$1</code>')
          .replace(/\n- /g, '<br>&bull; ')
          .replace(/\n/g, '<br>');

        let updateCardHtml = "";
        if (updates && updates.length > 0) {
          updateCardHtml = `
            <div class="mt-3 p-3 bg-[#0B0D0C] border border-[#B7F34A]/40 rounded-xl space-y-2.5">
              <div class="flex items-center justify-between text-[11px] pb-1.5 border-b border-[#2B312C]">
                <span class="text-[#B7F34A] font-bold flex items-center gap-1.5">
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  Memory Vault Updated
                </span>
                <span class="text-[10px] font-mono text-[#2F6307] dark:text-[#B7F34A]">VERIFIED &amp; SAVED</span>
              </div>
              ${updates.map(u => `
                <div class="space-y-1 text-xs">
                  <div class="flex items-center gap-2">
                    <span class="text-[#5E665E] font-medium text-[11px] w-20">Field:</span>
                    <span class="font-bold text-white">${escapeHtml(u.label || u.key)}</span>
                  </div>
                  ${u.old_value ? `
                  <div class="flex items-center gap-2">
                    <span class="text-[#5E665E] font-medium text-[11px] w-20">Previous:</span>
                    <del class="text-[#f43f5e] font-mono text-[11px]">${escapeHtml(u.old_value)}</del>
                  </div>
                  ` : ''}
                  <div class="flex items-center gap-2">
                    <span class="text-[#5E665E] font-medium text-[11px] w-20">New Value:</span>
                    <span class="text-[#B7F34A] font-bold font-mono text-[11px]">${escapeHtml(u.new_value)}</span>
                  </div>
                </div>
              `).join('')}
            </div>
          `;
        }

        bubble.innerHTML = `
          <div class="size-8 rounded-lg bg-[#B7F34A] text-[#0B0D0C] flex items-center justify-center font-bold text-xs shrink-0 shadow-[0_0_10px_rgba(183,243,74,0.3)]">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a10 10 0 1 0 10 10H12V2z"></path>
              <circle cx="12" cy="12" r="3" fill="currentColor"></circle>
            </svg>
          </div>
          <div class="p-3.5 rounded-2xl rounded-tl-sm bg-[#191D1A] border border-[#2B312C] text-xs text-[#FFFFFF] shadow-sm leading-relaxed space-y-2">
            <div>${formattedText}</div>
            ${updateCardHtml}
          </div>
        `;

        memCopilotChatFeed.appendChild(bubble);
        memCopilotChatFeed.scrollTop = memCopilotChatFeed.scrollHeight;
      }

      async function handleSendMemCopilotMessage(promptText = null) {
        const message = (promptText || memCopilotChatInput?.value || "").trim();
        if (!message) return;

        if (memCopilotChatInput) memCopilotChatInput.value = "";
        appendMemUserMessage(message);

        if (memCopilotSendBtn) memCopilotSendBtn.disabled = true;
        if (memCopilotTypingStatus) memCopilotTypingStatus.classList.remove("hidden");

        const historyToSend = memCopilotChatHistory.slice(-16).map(m => ({ role: m.role, content: m.content }));
        memCopilotChatHistory.push({ role: "user", content: message });
        try {
          sessionStorage.setItem("magic_fill_copilot_history", JSON.stringify(memCopilotChatHistory.slice(-20)));
        } catch (e) {}

        const activeTok = localStorage.getItem("magic_fill_token");
        const reqHeaders = {
          "Content-Type": "application/json",
          ...(activeTok ? { "Authorization": `Bearer ${activeTok}` } : {})
        };

        try {
          const res = await fetch("/api/memory/copilot-chat", {
            method: "POST",
            headers: reqHeaders,
            body: JSON.stringify({
              message: message,
              history: historyToSend
            })
          });

          const data = await res.json();
          if (memCopilotTypingStatus) memCopilotTypingStatus.classList.add("hidden");
          if (memCopilotSendBtn) memCopilotSendBtn.disabled = false;

          if (res.ok && data.success && data.data) {
            const reply = data.data.reply;
            const updates = data.data.updates || [];
            appendMemAssistantMessage(reply, updates);
            memCopilotChatHistory.push({ role: "assistant", content: reply, updates });
            try {
              sessionStorage.setItem("magic_fill_copilot_history", JSON.stringify(memCopilotChatHistory.slice(-20)));
            } catch (e) {}

            if (updates.length > 0) {
              showToast(`Vault updated: ${updates.map(u => u.label || u.key).join(", ")}`);
              const relevantUpdates = updates.map(u => ({
                field: u.key,
                label: u.label || u.key,
                field_type: u.field_type || "personal_info",
                ...(u.old_value !== undefined && u.old_value !== null ? { previous_value: u.old_value } : {}),
                new_value: u.new_value,
                action: u.action || "UPDATE"
              }));
              displayVaultUpdatedJson(relevantUpdates, "Memory Vault Updated", "AI_MEMORY_COPILOT");
              loadVault();
              const nameUpd = updates.find(u => u.key === "full_name");
              if (nameUpd) {
                const navName = document.getElementById("navUserName");
                if (navName) navName.textContent = nameUpd.new_value.toUpperCase();
              }
            }
          } else {
            appendMemAssistantMessage(data.message || "I encountered an error querying your memory vault. Please try again.");
          }
        } catch (err) {
          console.error("Memory Copilot chat error:", err);
          if (memCopilotTypingStatus) memCopilotTypingStatus.classList.add("hidden");
          if (memCopilotSendBtn) memCopilotSendBtn.disabled = false;
          appendMemAssistantMessage("Network communication error with AI engine. Please ensure your backend is running.");
        }
      }

      if (memCopilotSendBtn) {
        memCopilotSendBtn.addEventListener("click", (e) => {
          e.preventDefault();
          handleSendMemCopilotMessage();
        });
      }

      if (memCopilotChatForm) {
        memCopilotChatForm.addEventListener("submit", (e) => {
          e.preventDefault();
          handleSendMemCopilotMessage();
        });
      }

      if (memCopilotChatInput) {
        memCopilotChatInput.addEventListener("keydown", (e) => {
          if (e.key === "Enter" && !e.shiftKey) {
            e.preventDefault();
            handleSendMemCopilotMessage();
          }
        });
      }

      document.querySelectorAll(".mem-copilot-chip").forEach(chip => {
        chip.addEventListener("click", () => {
          const prompt = chip.getAttribute("data-prompt");
          if (prompt) handleSendMemCopilotMessage(prompt);
        });
      });

      if (btnResetMemCopilotChat) {
        btnResetMemCopilotChat.addEventListener("click", () => {
          memCopilotChatHistory = [];
          try {
            sessionStorage.removeItem("magic_fill_copilot_history");
          } catch (e) {}
          renderMemCopilotWelcome();
          showToast("Copilot conversation cleared.");
        });
      }

      restoreMemCopilotChat();

      // AI Memory Chat Ingestion Logic
      const chatInput = document.getElementById("aiMemoryChatInput");
      const extractChatBtn = document.getElementById("btnAiExtractChat");
      const extractChatBtnText = document.getElementById("btnAiExtractChatText");
      const previewBox = document.getElementById("aiChatPreviewBox");
      const previewItems = document.getElementById("aiChatPreviewItems");
      const cancelPreviewBtn = document.getElementById("btnCancelChatPreview");
      const commitPreviewBtn = document.getElementById("btnCommitChatPreview");

      if (extractChatBtn) {
        extractChatBtn.addEventListener("click", async () => {
          const text = chatInput.value.trim();
          if (!text) {
            alert("Please type or paste some text first.");
            return;
          }

          extractChatBtnText.textContent = "Analyzing with AI...";
          extractChatBtn.disabled = true;

          try {
            const res = await fetch("/api/memory/extract-raw", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Authorization": `Bearer ${token}`
              },
              body: JSON.stringify({
                raw_text: text,
                auto_save: false
              })
            });

            const data = await res.json();
            if (res.ok && data.success && data.data) {
              const ext = data.data.extracted;
              pendingChatExtracts = ext;

              const rows = [];
              if (ext.full_name) rows.push({ k: "Full Name", v: ext.full_name });
              if (ext.degree) rows.push({ k: "Degree", v: ext.degree });
              if (ext.university) rows.push({ k: "University", v: ext.university });
              if (ext.phone) rows.push({ k: "Phone", v: ext.phone });
              if (ext.email) rows.push({ k: "Email", v: ext.email });
              if (ext.city) rows.push({ k: "City", v: ext.city });
              if (ext.country) rows.push({ k: "Country", v: ext.country });
              if (ext.skills && ext.skills.length) rows.push({ k: "Skills", v: ext.skills.join(", ") });
              if (ext.custom_fields && ext.custom_fields.length) {
                ext.custom_fields.forEach(c => rows.push({ k: c.field_label || c.field_key, v: c.field_value }));
              }

              if (rows.length === 0) {
                previewItems.innerHTML = `<p class="text-xs text-[#A1AAA1] italic">No distinct personal records recognized. Try adding more specific details.</p>`;
              } else {
                previewItems.innerHTML = rows.map(r => `
                  <div class="flex items-center justify-between p-2.5 rounded-lg bg-[#141715] border border-[#2B312C] text-xs">
                    <span class="font-bold text-[#FFFFFF]">${r.k}</span>
                    <span class="text-[#A1AAA1] font-medium">${r.v}</span>
                  </div>
                `).join("");
              }

              previewBox.classList.remove("hidden");
              displayAiChatUpdatedJson(ext, "Recognized Memory Extracted");
            } else {
              alert(data.message || "Failed to extract information.");
            }
          } catch (e) {
            console.error(e);
            alert("Network error connecting to AI extraction service.");
          } finally {
            extractChatBtnText.textContent = "Extract & Preview Memory";
            extractChatBtn.disabled = false;
          }
        });
      }

      if (cancelPreviewBtn) {
        cancelPreviewBtn.addEventListener("click", () => {
          previewBox.classList.add("hidden");
          pendingChatExtracts = null;
        });
      }

      if (commitPreviewBtn) {
        commitPreviewBtn.addEventListener("click", async () => {
          const text = chatInput.value.trim();
          if (!text) return;

          commitPreviewBtn.disabled = true;
          commitPreviewBtn.textContent = "Saving to Vault...";

          try {
            const res = await fetch("/api/memory/extract-raw", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Authorization": `Bearer ${token}`
              },
              body: JSON.stringify({
                raw_text: text,
                auto_save: true
              })
            });

            const resJson = await res.json().catch(() => ({}));
            if (res.ok) {
              previewBox.classList.add("hidden");
              const savedPayload = (resJson && resJson.data && resJson.data.extracted) || pendingChatExtracts || { input: text };
              displayAiChatUpdatedJson(savedPayload, "Saved to Memory Vault");
              chatInput.value = "";
              showToast("Recognized attributes saved directly into your Personal Memory Vault!");
              loadVault();
            } else {
              showToast("Failed to save extracted attributes.", false);
            }
          } catch (e) {
            showToast("Network error saving memory.", false);
          } finally {
            commitPreviewBtn.disabled = false;
            commitPreviewBtn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span>Confirm &amp; Save to Vault</span>`;
          }
        });
      }

      // JSON Viewer Handlers
      function sanitizeJsonData(obj) {
        if (!obj || typeof obj !== 'object') return obj;
        if (Array.isArray(obj)) return obj.map(sanitizeJsonData);
        const clean = {};
        for (const [k, v] of Object.entries(obj)) {
          if ((k.includes('photo') || k.includes('image') || k.includes('avatar') || k.includes('file_data')) && typeof v === 'string' && (v.startsWith('data:image') || v.length > 500)) {
            clean[k] = `[base64 / binary payload truncated (${Math.round(v.length / 1024)} KB)]`;
          } else if (typeof v === 'object' && v !== null) {
            clean[k] = sanitizeJsonData(v);
          } else {
            clean[k] = v;
          }
        }
        return clean;
      }

      function displayAiChatUpdatedJson(dataObj, badgeText = "Saved to Vault") {
        const box = document.getElementById("aiChatUpdatedJsonBox");
        const code = document.getElementById("aiChatUpdatedJsonCode");
        const badge = document.getElementById("aiChatUpdatedBadge");
        if (!box || !code) return;

        const payload = {
          status: "success",
          source: "AI_MEMORY_ASSISTANT",
          timestamp: new Date().toISOString(),
          updated_records: sanitizeJsonData(dataObj)
        };

        code.textContent = JSON.stringify(payload, null, 2);
        if (badge) badge.innerHTML = `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span>${escapeHtml(badgeText)}</span>`;
        box.classList.remove("hidden");
        box.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }

      function displayVaultUpdatedJson(dataObj, badgeText = "Updated Record", source = "MEMORY_VAULT_DIRECT") {
        const box = document.getElementById("vaultUpdatedJsonBox");
        const code = document.getElementById("vaultUpdatedJsonCode");
        const badge = document.getElementById("vaultUpdatedBadge");
        if (!box || !code) return;

        const payload = {
          status: "success",
          source: source,
          timestamp: new Date().toISOString(),
          updated_records: sanitizeJsonData(dataObj)
        };

        code.textContent = JSON.stringify(payload, null, 2);
        if (badge) badge.innerHTML = `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span>${escapeHtml(badgeText)}</span>`;
        box.classList.remove("hidden");
        box.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }

      const copyAiChatJsonBtn = document.getElementById("btnCopyUpdatedJson");
      const copyAiChatJsonText = document.getElementById("copyUpdatedJsonText");
      if (copyAiChatJsonBtn && copyAiChatJsonText) {
        copyAiChatJsonBtn.addEventListener("click", () => {
          const code = document.getElementById("aiChatUpdatedJsonCode");
          if (code && code.textContent) {
            navigator.clipboard.writeText(code.textContent);
            copyAiChatJsonText.textContent = "Copied!";
            setTimeout(() => { copyAiChatJsonText.textContent = "Copy JSON"; }, 2000);
          }
        });
      }

      const copyVaultJsonBtn = document.getElementById("btnCopyVaultJson");
      const copyVaultJsonText = document.getElementById("copyVaultJsonText");
      if (copyVaultJsonBtn && copyVaultJsonText) {
        copyVaultJsonBtn.addEventListener("click", () => {
          const code = document.getElementById("vaultUpdatedJsonCode");
          if (code && code.textContent) {
            navigator.clipboard.writeText(code.textContent);
            copyVaultJsonText.textContent = "Copied!";
            setTimeout(() => { copyVaultJsonText.textContent = "Copy JSON"; }, 2000);
          }
        });
      }

      loadVault();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initVault);
    } else {
      initVault();
    }
  </script>
</Base>

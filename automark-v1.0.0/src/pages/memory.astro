      <form id="addCustomForm" class="space-y-4" onsubmit="return false;">
        <div>
          <label class="block text-xs font-semibold text-[#A1AAA1] mb-1">Attribute Label</label>
          <input type="text" id="addAttrLabel" placeholder="e.g. Target Annual Salary, Notice Period, Portfolio URL" required class="w-full bg-[#141715] border border-[#2B312C] rounded-xl px-3.5 py-2 text-xs text-[#FFFFFF] focus:border-[#B7F34A] focus:outline-none" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#A1AAA1] mb-1">Stored Value</label>
          <textarea id="addAttrValue" rows="3" placeholder="Enter the exact answer or value to autofill..." required class="w-full bg-[#141715] border border-[#2B312C] rounded-xl px-3.5 py-2 text-xs text-[#FFFFFF] focus:border-[#B7F34A] focus:outline-none"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-[#A1AAA1] mb-1">Category</label>
            <select id="addAttrCategory" class="w-full bg-[#141715] border border-[#2B312C] rounded-xl px-3 py-2 text-xs text-[#FFFFFF] focus:border-[#B7F34A] focus:outline-none">
              <option value="professional">Professional</option>
              <option value="personal">Personal</option>
              <option value="academic">Academic</option>
              <option value="preferences">Preferences</option>
              <option value="identity">Identity / Gov</option>

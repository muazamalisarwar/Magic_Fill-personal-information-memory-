---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Form Autofill Simulator - Magic Fill"
  meta_title="Live Form Autofill Simulator & Testing Lab"
  description="Test Magic Fill intelligent AI form matching and autofill on a comprehensive multi-type application form."
>
  <section class="pt-28 pb-20 relative overflow-hidden min-h-screen">
    <div class="container mx-auto px-4 max-w-5xl relative z-10">
      
      <!-- Top Navigation Bar -->
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-200/80 dark:border-white/5">
        <div class="flex items-center gap-2.5 text-xs font-semibold">
          <a href="/dashboard" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-white flex items-center gap-1.5 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            <span>Dashboard</span>
          </a>
          <span class="text-slate-300 dark:text-white/20">/</span>
          <span class="text-slate-900 dark:text-white font-medium">Form Simulator</span>
        </div>

        <div class="flex items-center gap-2.5">
          <a href="/memory" class="rounded-lg px-3 py-1.5 text-xs font-medium bg-white dark:bg-white/5 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-white/10 hover:bg-slate-50 dark:hover:bg-white/10 transition-all">
            Inspect Vault
          </a>
          <a href="/extension" class="rounded-lg px-3 py-1.5 text-xs font-medium bg-white dark:bg-white/5 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-white/10 hover:bg-slate-50 dark:hover:bg-white/10 transition-all">
            Extension Setup
          </a>
        </div>
      </div>

      <!-- Header & Intro -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-indigo-600 dark:text-indigo-400 mb-2 font-display">
            Testing Environment &bull; 10 Input Types
          </p>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white font-display">
            Form Autofill Simulator
          </h1>
          <p class="text-sm text-slate-600 dark:text-slate-400 max-w-xl mt-2 leading-relaxed">
            Test how Magic Fill maps and fills complex inputs across text fields, dropdowns, radios, sliders, checkboxes, and custom questions.
          </p>
        </div>

        <!-- Simulation Toolbar -->
        <div class="flex items-center gap-2.5 shrink-0">
          <button
            type="button"
            id="clearFormBtn"
            class="px-3.5 py-2 rounded-lg text-xs font-medium text-slate-700 dark:text-slate-300 bg-white dark:bg-white/5 border border-slate-200/90 dark:border-white/10 hover:bg-slate-50 dark:hover:bg-white/10 transition-all cursor-pointer flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            <span>Reset Form</span>
          </button>
          
          <button
            type="button"
            id="simulateAutofillBtn"
            class="px-4 py-2 rounded-lg text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-500 shadow-sm hover:shadow transition-all cursor-pointer flex items-center gap-2"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            <span id="autofillBtnText">Simulate Autofill</span>
            <span class="hidden sm:inline-block px-1.5 py-0.5 rounded bg-white/20 text-[10px] font-mono">Alt+F</span>
          </button>
        </div>
      </div>

      <!-- Live Match Summary Banner -->
      <div id="matchSummaryBanner" class="p-4 rounded-xl bg-slate-50 dark:bg-white/[0.02] border border-slate-200/80 dark:border-white/10 mb-8 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-5">
          <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Status:</span>
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-700 dark:text-slate-300">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Matched from Vault
          </span>
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-700 dark:text-slate-300">
            <span class="w-2 h-2 rounded-full bg-slate-300 dark:bg-white/30"></span>
            Unmapped / Optional
          </span>
        </div>
        <div id="statsBadge" class="text-xs text-slate-500 dark:text-slate-400">
          Ready to test. Click <strong>Simulate Autofill</strong> or press <kbd class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-white/10 text-slate-700 dark:text-slate-300 font-mono text-[10px] border border-slate-200 dark:border-white/10">Alt + F</kbd>.
        </div>
      </div>

      <!-- The Simulated Form Container -->
      <form id="jobAppForm" class="bg-white dark:bg-[#0f1422] border border-slate-200/80 dark:border-white/10 rounded-2xl p-6 md:p-9 shadow-xs space-y-9">
        
        <!-- Section 1: Personal & Contact Information (Text Inputs) -->
        <div>
          <div class="flex items-center gap-2 mb-5 pb-3 border-b border-slate-100 dark:border-white/5">
            <span class="w-5 h-5 rounded-md bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-bold text-xs flex items-center justify-center border border-indigo-100 dark:border-indigo-800/40">1</span>
            <h2 class="text-sm font-bold text-slate-900 dark:text-white font-display">Applicant Identity &amp; Contact</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <!-- Field: Full Name -->
            <div class="space-y-1.5">
              <label for="applicant_legal_name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 font-display">
                Legal Full Name <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="applicant_legal_name"
                name="applicant_legal_name"
                placeholder="e.g. Johnathan Doe"
                class="sim-input w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all"
              />
              <span class="field-hint text-[11px] text-slate-500 dark:text-slate-400 block">Vault target: personal_info.full_name</span>
            </div>

            <!-- Field: Father Name -->
            <div class="space-y-1.5">
              <label for="parent_guardian_name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 font-display">
                Father / Guardian Name
              </label>
              <input
                type="text"
                id="parent_guardian_name"
                name="parent_guardian_name"
                placeholder="e.g. Robert Doe"
                class="sim-input w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all"
              />
              <span class="field-hint text-[11px] text-slate-500 dark:text-slate-400 block">Vault target: personal_info.father_name</span>
            </div>

            <!-- Field: Email -->
            <div class="space-y-1.5">
              <label for="applicant_email_address" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 font-display">
                Contact Email Address <span class="text-rose-500">*</span>
              </label>
              <input
                type="email"
                id="applicant_email_address"
                name="applicant_email_address"
                placeholder="you@domain.com"
                class="sim-input w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all"
              />
              <span class="field-hint text-[11px] text-slate-500 dark:text-slate-400 block">Vault target: personal_info.email</span>
            </div>

            <!-- Field: Phone Number -->
            <div class="space-y-1.5">
              <label for="contact_telephone" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 font-display">
                Mobile / Primary Phone
              </label>
              <input
                type="tel"
                id="contact_telephone"
                name="contact_telephone"
                placeholder="+1 (555) 000-0000"
                class="sim-input w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all"
              />
              <span class="field-hint text-[11px] text-slate-500 dark:text-slate-400 block">Vault target: personal_info.phone</span>
            </div>

            <!-- Field: National ID / CNIC -->
            <div class="space-y-1.5">
              <label for="national_identity_number" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 font-display">
                National ID / CNIC / Government ID
              </label>
              <input
                type="text"
                id="national_identity_number"
                name="national_identity_number"
                placeholder="35201-1234567-1"
                class="sim-input w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all"
              />
              <span class="field-hint text-[11px] text-slate-500 dark:text-slate-400 block">Vault target: personal_info.cnic</span>
            </div>

            <!-- Field: Date of Birth (Date Picker) -->
            <div class="space-y-1.5">
              <label for="date_of_birth" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 font-display">
                Date of Birth
              </label>
              <input
                type="date"
                id="date_of_birth"
                name="date_of_birth"
                class="sim-input w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all"
              />
              <span class="field-hint text-[11px] text-slate-500 dark:text-slate-400 block">ISO date standard (YYYY-MM-DD)</span>
            </div>
          </div>
        </div>

        <!-- Section 2: Dropdowns & Radios (Select & Radio Options) -->
        <div>
          <div class="flex items-center gap-2 mb-5 pb-3 border-b border-slate-100 dark:border-white/5">
            <span class="w-5 h-5 rounded-md bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-bold text-xs flex items-center justify-center border border-indigo-100 dark:border-indigo-800/40">2</span>
            <h2 class="text-sm font-bold text-slate-900 dark:text-white font-display">Academic Level &amp; Demographics</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            
            <!-- Dropdown: Highest Completed Degree -->
            <div class="space-y-1.5">
              <label for="highest_degree_level" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 font-display">
                Highest Completed Degree
              </label>
              <select
                id="highest_degree_level"
                name="highest_degree_level"
                class="sim-input w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all"
              >
                <option value="">-- Choose Degree Level --</option>
                <option value="High School">High School / Matriculation</option>
                <option value="Associate Degree">Associate Degree / Diploma</option>
                <option value="Bachelor of Science">Bachelor of Science / BS</option>
                <option value="Master of Science">Master of Science / MS</option>
                <option value="Doctorate">Doctorate / Ph.D.</option>
              </select>
              <span class="field-hint text-[11px] text-slate-500 dark:text-slate-400 block">Exact &amp; semantic option matching</span>
            </div>

            <!-- Dropdown: Country of Residence -->
            <div class="space-y-1.5">
              <label for="country_residence" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 font-display">
                Country of Residence
              </label>
              <select
                id="country_residence"
                name="country_residence"
                class="sim-input w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all"
              >
                <option value="">-- Select Country --</option>
                <option value="Pakistan">Pakistan</option>
                <option value="United States">United States</option>
                <option value="United Kingdom">United Kingdom</option>
                <option value="Canada">Canada</option>
                <option value="Germany">Germany</option>
                <option value="United Arab Emirates">United Arab Emirates</option>
              </select>
              <span class="field-hint text-[11px] text-slate-500 dark:text-slate-400 block">Vault target: personal_info.country</span>
            </div>

            <!-- Radio: Gender Selection -->
            <div class="space-y-2 p-4 rounded-lg bg-slate-50/60 dark:bg-white/[0.02] border border-slate-200/80 dark:border-white/10">
              <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 font-display mb-1">
                Gender Identification
              </label>
              <div class="flex items-center gap-6">
                <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-700 dark:text-slate-300">
                  <input type="radio" name="gender" value="Male" class="sim-radio text-indigo-600 focus:ring-indigo-500" />
                  <span>Male</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-700 dark:text-slate-300">
                  <input type="radio" name="gender" value="Female" class="sim-radio text-indigo-600 focus:ring-indigo-500" />
                  <span>Female</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-700 dark:text-slate-300">
                  <input type="radio" name="gender" value="Other" class="sim-radio text-indigo-600 focus:ring-indigo-500" />
                  <span>Other</span>
                </label>
              </div>
            </div>

            <!-- Radio: Work Authorization -->
            <div class="space-y-2 p-4 rounded-lg bg-slate-50/60 dark:bg-white/[0.02] border border-slate-200/80 dark:border-white/10">
              <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 font-display mb-1">
                Legally Authorized to Work?
              </label>
              <div class="flex items-center gap-6">
                <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-700 dark:text-slate-300">
                  <input type="radio" name="work_auth" value="Yes" class="sim-radio text-indigo-600 focus:ring-indigo-500" />
                  <span>Yes, Authorized</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-700 dark:text-slate-300">
                  <input type="radio" name="work_auth" value="No" class="sim-radio text-indigo-600 focus:ring-indigo-500" />
                  <span>Requires Visa Sponsorship</span>
                </label>
              </div>
            </div>

          </div>
        </div>

        <!-- Section 3: Sliders, Checkboxes, Toggles & Files -->
        <div>
          <div class="flex items-center gap-2 mb-5 pb-3 border-b border-slate-100 dark:border-white/5">
            <span class="w-5 h-5 rounded-md bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-bold text-xs flex items-center justify-center border border-indigo-100 dark:border-indigo-800/40">3</span>
            <h2 class="text-sm font-bold text-slate-900 dark:text-white font-display">Experience, Preferences &amp; Files</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            
            <!-- Slider: Years of Experience -->
            <div class="space-y-2 p-4 rounded-lg bg-slate-50/60 dark:bg-white/[0.02] border border-slate-200/80 dark:border-white/10">
              <div class="flex items-center justify-between">
                <label for="years_experience" class="text-xs font-semibold text-slate-700 dark:text-slate-300 font-display">
                  Years of Experience
                </label>
                <span id="expDisplay" class="font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400">0 Years</span>
              </div>
              <input
                type="range"
                id="years_experience"
                name="years_experience"
                min="0"
                max="15"
                value="0"
                class="sim-input w-full accent-indigo-600 cursor-pointer"
              />
              <div class="flex justify-between text-[10px] text-slate-400 font-mono">
                <span>0 yrs</span>
                <span>5 yrs</span>
                <span>10 yrs</span>
                <span>15+ yrs</span>
              </div>
            </div>

            <!-- Toggle Switch: Willingness to Relocate -->
            <div class="space-y-2 p-4 rounded-lg bg-slate-50/60 dark:bg-white/[0.02] border border-slate-200/80 dark:border-white/10 flex flex-col justify-between">
              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 font-display mb-1">
                  Willing to Relocate or Travel?
                </label>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">
                  Open to hybrid or relocated employment opportunities.
                </p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer mt-2">
                <input type="checkbox" id="relocate_toggle" name="relocate_toggle" class="sr-only peer" />
                <div class="w-10 h-5 bg-slate-300 dark:bg-white/20 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600"></div>
                <span class="ml-2.5 text-xs text-slate-600 dark:text-slate-300 font-medium">Relocation Permitted</span>
              </label>
            </div>

            <!-- Checkbox: Remote Preference -->
            <div class="space-y-3 p-4 rounded-lg bg-slate-50/60 dark:bg-white/[0.02] border border-slate-200/80 dark:border-white/10">
              <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 font-display mb-1">
                Candidate Preferences
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-700 dark:text-slate-300">
                <input type="checkbox" id="remote_preference" name="remote_preference" class="sim-checkbox rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                <span>Prefer fully remote or flexible work environment</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-700 dark:text-slate-300">
                <input type="checkbox" id="immediate_joiner" name="immediate_joiner" class="sim-checkbox rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                <span>Available to start immediately (within 2 weeks)</span>
              </label>
            </div>

            <!-- File Upload: Resume -->
            <div class="space-y-1.5 p-4 rounded-lg bg-slate-50/60 dark:bg-white/[0.02] border border-slate-200/80 dark:border-white/10">
              <label for="applicant_resume_file" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 font-display">
                Resume / CV Document
              </label>
              <input
                type="file"
                id="applicant_resume_file"
                name="applicant_resume_file"
                class="sim-input block w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 dark:file:bg-indigo-950/40 file:text-indigo-600 dark:file:text-indigo-400 hover:file:bg-indigo-100 cursor-pointer"
              />
              <span class="field-hint text-[11px] text-slate-500 dark:text-slate-400 block">Pulls from stored user resumes</span>
            </div>

          </div>
        </div>

        <!-- Section 4: Professional Summary (Text Area) -->
        <div>
          <div class="flex items-center gap-2 mb-5 pb-3 border-b border-slate-100 dark:border-white/5">
            <span class="w-5 h-5 rounded-md bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-bold text-xs flex items-center justify-center border border-indigo-100 dark:border-indigo-800/40">4</span>
            <h2 class="text-sm font-bold text-slate-900 dark:text-white font-display">Professional Summary</h2>
          </div>

          <div class="space-y-1.5">
            <label for="applicant_cover_note" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 font-display">
              Cover Note &amp; Executive Summary
            </label>
            <textarea
              id="applicant_cover_note"
              name="applicant_cover_note"
              rows="4"
              placeholder="A brief 2-3 sentence overview of your career, skills, and background..."
              class="sim-input w-full px-3.5 py-2.5 rounded-lg border border-slate-200/90 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.03] text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:bg-white dark:focus:bg-[#0b0f19] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/15 transition-all resize-none leading-relaxed"
            ></textarea>
            <span class="field-hint text-[11px] text-slate-500 dark:text-slate-400 block">Synthesizes professional experience and skills</span>
          </div>
        </div>

        <!-- Form Submit & Test Action -->
        <div class="pt-5 border-t border-slate-100 dark:border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Submit form to test continuous memory learning confirmation.
          </p>

          <button
            type="submit"
            class="px-5 py-2.5 rounded-lg text-xs font-semibold text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-white/5 hover:bg-slate-200 dark:hover:bg-white/10 border border-slate-200 dark:border-white/10 transition-all cursor-pointer"
          >
            Simulate Form Submit
          </button>
        </div>

      </form>

    </div>
  </section>

  <!-- Interactive Simulator Logic -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("jobAppForm");
      const simulateBtn = document.getElementById("simulateAutofillBtn");
      const autofillBtnText = document.getElementById("autofillBtnText");
      const clearBtn = document.getElementById("clearFormBtn");
      const expSlider = document.getElementById("years_experience");
      const expDisplay = document.getElementById("expDisplay");
      const statsBadge = document.getElementById("statsBadge");

      // Slider live feedback
      if (expSlider && expDisplay) {
        expSlider.addEventListener("input", (e) => {
          expDisplay.textContent = `${e.target.value} Years`;
        });
      }

      // Reset form
      if (clearBtn) {
        clearBtn.addEventListener("click", (e) => {
          e.preventDefault();
          if (form) form.reset();
          if (expDisplay) expDisplay.textContent = "0 Years";
          resetVisualStatus();
          if (statsBadge) statsBadge.innerHTML = "Form reset. Ready to test.";
        });
      }

      function resetVisualStatus() {
        document.querySelectorAll(".sim-input, .sim-radio, .sim-checkbox").forEach((el) => {
          el.classList.remove("border-emerald-500/80", "bg-emerald-50/20", "dark:bg-emerald-950/20");
          el.style.borderColor = "";
        });
      }

      function highlightField(el, isMatched) {
        if (!el) return;
        if (isMatched) {
          el.classList.add("border-emerald-500/80", "bg-emerald-50/20", "dark:bg-emerald-950/20");
          el.style.borderColor = "#10b981";
        } else {
          el.style.borderColor = "";
        }
      }

      // Simulate Autofill (Calls API directly for testing without extension)
      if (simulateBtn) {
        simulateBtn.addEventListener("click", async (e) => {
          e.preventDefault();
          const token = localStorage.getItem("magic_fill_token");
          if (!token) {
            alert("Please sign in to test live autofill from your personal memory vault.");
            window.location.href = "/login?redirect=/playground";
            return;
          }

          try {
            if (autofillBtnText) autofillBtnText.textContent = "Matching Fields...";
            simulateBtn.disabled = true;

            // Harvest all simulated input fields
            const fields = [
              { field_id: "f_legal_name", name: "applicant_legal_name", label: "Applicant Legal Full Name", input_type: "text", tag_name: "input" },
              { field_id: "f_father_name", name: "parent_guardian_name", label: "Father / Guardian Name", input_type: "text", tag_name: "input" },
              { field_id: "f_email", name: "applicant_email_address", label: "Contact Email Address", input_type: "email", tag_name: "input" },
              { field_id: "f_phone", name: "contact_telephone", label: "Mobile / Primary Phone", input_type: "tel", tag_name: "input" },
              { field_id: "f_cnic", name: "national_identity_number", label: "National ID / CNIC / Government ID", input_type: "text", tag_name: "input" },
              { field_id: "f_dob", name: "date_of_birth", label: "Date of Birth", input_type: "date", tag_name: "input" },
              { field_id: "f_degree", name: "highest_degree_level", label: "Highest Completed Degree", input_type: "select-one", tag_name: "select", options: ["High School", "Associate Degree", "Bachelor of Science", "Master of Science", "Doctorate"] },
              { field_id: "f_country", name: "country_residence", label: "Country of Residence", input_type: "select-one", tag_name: "select", options: ["Pakistan", "United States", "United Kingdom", "Canada", "Germany", "United Arab Emirates"] },
              { field_id: "f_gender", name: "gender", label: "Gender Identification", input_type: "radio", tag_name: "input", options: ["Male", "Female", "Other"] },
              { field_id: "f_work_auth", name: "work_auth", label: "Legally Authorized to Work?", input_type: "radio", tag_name: "input", options: ["Yes", "No"] },
              { field_id: "f_exp", name: "years_experience", label: "Years of Professional Experience", input_type: "range", tag_name: "input" },
              { field_id: "f_relocate", name: "relocate_toggle", label: "Willing to Relocate or Travel", input_type: "checkbox", tag_name: "input" },
              { field_id: "f_bio", name: "applicant_cover_note", label: "Professional Bio & Executive Summary", input_type: "textarea", tag_name: "textarea" },
            ];

            const res = await fetch("/api/matching/fields", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Authorization": `Bearer ${token}`
              },
              body: JSON.stringify({
                fields: fields,
                page_url: window.location.href,
                form_context: "Software Engineering Job Application"
              })
            });

            const data = await res.json();
            resetVisualStatus();

            if (res.ok && data.success && data.data) {
              const mappings = data.data.mappings || [];
              let filledCount = 0;

              mappings.forEach(m => {
                const val = m.value;
                if (m.field_id === "f_legal_name") {
                  const el = document.getElementById("applicant_legal_name");
                  if (el && val) { el.value = val; highlightField(el, true); filledCount++; }
                } else if (m.field_id === "f_father_name") {
                  const el = document.getElementById("parent_guardian_name");
                  if (el && val) { el.value = val; highlightField(el, true); filledCount++; }
                } else if (m.field_id === "f_email") {
                  const el = document.getElementById("applicant_email_address");
                  if (el && val) { el.value = val; highlightField(el, true); filledCount++; }
                } else if (m.field_id === "f_phone") {
                  const el = document.getElementById("contact_telephone");
                  if (el && val) { el.value = val; highlightField(el, true); filledCount++; }
                } else if (m.field_id === "f_cnic") {
                  const el = document.getElementById("national_identity_number");
                  if (el && val) { el.value = val; highlightField(el, true); filledCount++; }
                } else if (m.field_id === "f_dob") {
                  const el = document.getElementById("date_of_birth");
                  if (el && val) { el.value = val; highlightField(el, true); filledCount++; }
                } else if (m.field_id === "f_degree") {
                  const el = document.getElementById("highest_degree_level");
                  if (el && val) {
                    Array.from(el.options).forEach(opt => {
                      if (opt.value.toLowerCase().includes(val.toLowerCase()) || val.toLowerCase().includes(opt.value.toLowerCase())) {
                        el.value = opt.value;
                      }
                    });
                    highlightField(el, true);
                    filledCount++;
                  }
                } else if (m.field_id === "f_country") {
                  const el = document.getElementById("country_residence");
                  if (el && val) {
                    Array.from(el.options).forEach(opt => {
                      if (opt.value.toLowerCase().includes(val.toLowerCase()) || val.toLowerCase().includes(opt.value.toLowerCase())) {
                        el.value = opt.value;
                      }
                    });
                    highlightField(el, true);
                    filledCount++;
                  }
                } else if (m.field_id === "f_gender") {
                  const radios = document.getElementsByName("gender");
                  radios.forEach(r => {
                    if (r.value.toLowerCase() === String(val).toLowerCase()) {
                      r.checked = true;
                      highlightField(r.closest("div"), true);
                      filledCount++;
                    }
                  });
                } else if (m.field_id === "f_exp") {
                  const num = parseInt(val) || 0;
                  if (expSlider && expDisplay) {
                    expSlider.value = num;
                    expDisplay.textContent = `${num} Years`;
                    highlightField(expSlider.closest("div"), true);
                    filledCount++;
                  }
                } else if (m.field_id === "f_bio") {
                  const el = document.getElementById("applicant_cover_note");
                  if (el && val) { el.value = val; highlightField(el, true); filledCount++; }
                }
              });

              if (statsBadge) {
                statsBadge.innerHTML = `<span class="text-emerald-600 dark:text-emerald-400 font-bold">${filledCount} Fields Completed</span> from Vault &bull; <span class="text-slate-500">${fields.length - filledCount} Unmapped</span>`;
              }
            } else {
              alert(data.message || "Failed to match fields. Check server logs.");
            }
          } catch (err) {
            console.error(err);
            alert("Network error connecting to Magic Fill backend.");
          } finally {
            if (autofillBtnText) autofillBtnText.textContent = "Simulate Autofill";
            simulateBtn.disabled = false;
          }
        });
      }

      // Submit demonstration of consent-based learning
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const name = document.getElementById("applicant_legal_name")?.value;
          alert(`Form simulation complete!\n\nWhen you fill in unmapped fields (e.g. "${name || 'New Detail'}"), Magic Fill automatically prompts:\n"Save this new information to your vault?"\n\nYour data remains sovereign and private.`);
        });
      }
    });
  </script>
</Base>

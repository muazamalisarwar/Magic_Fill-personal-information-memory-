---
import Base from "@/layouts/Base.astro";
import Badge from "@/layouts/components/Badge.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import Faq from "@/layouts/components/Faq.astro";
import PricingSection from "@/layouts/components/PricingSection.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { Pricing } from "@/types";

const pricing = await getListPage("pricing", "-index");
const pricingData: Pricing = pricing.data;
---

<Base {...pricingData}>
  <!-- Page Header -->
  <section class="section-ph pb-0 relative overflow-hidden bg-transparent">
    <div class="container relative z-10">
      <div class="row justify-center">
        <div class="mb-10 text-center relative z-10">
          <h1
            class="mb-6 lg:col-9 mx-auto text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white hasHighlight"
            set:html={markdownify(pricingData.page_header.title)}
          />
          <p class="mb-10 lg:col-6 mx-auto text-slate-600 dark:text-[#A1AAA1] text-base">
            {pricingData.page_header.content}
          </p>
        </div>
      </div>
    </div>
    <PricingSection isHome={false} />
  </section>

  <!-- Comparison Table -->
  {
    pricingData.comparison.enable && (
      <section class="section relative isolate overflow-hidden py-24 bg-transparent">
        <div class="container">
          <div class="section-container">
            <div class="section-intro centralize text-center mb-16">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[#2F6307] dark:text-[#B7F34A] mb-2 font-mono">
                {pricingData.comparison.badge || "Feature Breakdown"}
              </p>
              <h2
                class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white hasHighlight mb-4"
                set:html={markdownify(pricingData.comparison.title)}
              />
            </div>
            <div class="section-content">
              <div class="overflow-x-auto">
                <div class="relative min-w-275 overflow-hidden rounded-2xl border border-slate-200 dark:border-[#2B312C] bg-white dark:bg-[#191D1A] text-slate-700 dark:text-[#A1AAA1] shadow-xl">
                  <div class="grid grid-cols-[1.2fr_1fr_1fr_1fr] items-center text-sm md:text-base text-slate-700 dark:text-[#A1AAA1] relative z-10 bg-slate-50 dark:bg-[#141715] border-b border-slate-200 dark:border-[#2B312C]">
                    {pricingData.comparison.headers.map((h: any, i: number) => (
                      <div
                        class={`px-6 py-5 text-sm font-bold text-slate-900 dark:text-white ${i === 0 ? "" : "text-center"}`}
                      >
                        {h.label}
                      </div>
                    ))}
                  </div>

                  <div class="relative z-10">
                    {pricingData.comparison.rows.map((row: any, i: number) => (
                      <div
                        class={`grid grid-cols-[1.2fr_1fr_1fr_1fr] items-center border-t border-slate-200 dark:border-[#2B312C] ${i % 2 === 0 ? "bg-slate-50/70 dark:bg-[#141715]/40" : ""}`}
                      >
                        <div class="px-6 py-4 text-slate-900 dark:text-white font-medium">{row.feature}</div>
                        {row.values.map((val: any, valIndex: number) => (
                          <div class="px-6 py-4 text-center">
                            {typeof val === "boolean" ? (
                              val ? (
                                <span class="inline-flex h-6 w-6 items-center justify-center rounded-md bg-[#B7F34A] text-[#0B0D0C] shadow-sm">
                                  <svg
                                    class="h-3.5 w-3.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="3"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                  >
                                    <polyline points="20 6 9 17 4 12" />
                                  </svg>
                                </span>
                              ) : (
                                <span class="inline-flex h-6 w-6 items-center justify-center rounded-md bg-slate-100 dark:bg-[#141715] border border-slate-300 dark:border-[#2B312C]">
                                  <span class="block h-0.5 w-2.5 rounded-full bg-slate-400 dark:bg-[#5E665E]" />
                                </span>
                              )
                            ) : (
                              <span
                                class={`text-sm font-medium ${valIndex === 1 ? "text-[#2F6307] dark:text-[#B7F34A]" : "text-slate-600 dark:text-[#A1AAA1]"}`}
                              >
                                {val}
                              </span>
                            )}
                          </div>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <Faq />

  <!-- Call to Action -->
  <CallToAction />
</Base>
